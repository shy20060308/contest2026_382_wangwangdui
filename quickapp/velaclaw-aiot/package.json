{
  "name": "vela_band",
  "version": "3.0.0",
  "private": true,
  "description": "VelaClaw wearable app with a recipe-first V3 design runtime and capability-backed features.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shy20060308/contest2026_382_wangwangdui.git"
  },
  "homepage": "https://github.com/shy20060308/contest2026_382_wangwangdui",
  "keywords": ["openvela", "vela", "quick-app", "smart-band", "smart-watch", "recipe-design", "layout-studio"],
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "aiot start --watch",
    "build": "aiot build --enable-jsc",
    "release": "aiot release --enable-jsc",
    "lint": "node scripts/lint.js",
    "studio": "node tools/layout-studio/server.js",
    "studio:check": "node test/layout_studio.test.js",
    "v3:architecture": "node test/v3_architecture.test.js",
    "v3:design": "node test/v3_design.test.js",
    "capabilities:check": "node test/capability_runtime.test.js",
    "power:logic": "node test/power_state_machine.test.js",
    "power:runtime": "node test/power_runtime.test.js",
    "health:logic": "node test/health_metrics.test.js",
    "health:official": "node test/health_official_data.test.js",
    "workout:experience": "node test/workout_experience.test.js",
    "activity:persistence": "node test/activity_persistence.test.js",
    "settings:store": "node test/settings_store.test.js",
    "motion:logic": "node test/motion_metrics.test.js",
    "haptics:logic": "node test/haptic_patterns.test.js",
    "haptics:runtime": "node test/haptics_runtime.test.js",
    "calendar:logic": "node test/calendar_utils.test.js",
    "analog:logic": "node test/analog_face.test.js",
    "honeycomb:logic": "node test/honeycomb_layout.test.js",
    "icons:render": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-icons.ps1 && python scripts/render-soft-icons.py",
    "backgrounds:render": "python scripts/fade-watchface-background.py --input assets/watchfaces/alpine_night_source.jpg --output src/common/watchfaces/alpine_night.jpg",
    "check": "npm run lint && npm run v3:architecture && npm run v3:design && npm run studio:check && npm run capabilities:check && npm run power:logic && npm run power:runtime && npm run health:logic && npm run health:official && npm run workout:experience && npm run activity:persistence && npm run settings:store && npm run motion:logic && npm run haptics:logic && npm run haptics:runtime && npm run calendar:logic && npm run analog:logic && npm run honeycomb:logic"
  },
  "lint-staged": {
    "*.{ux,js}": ["prettier --write", "node scripts/lint.js", "git add"],
    "*.{less,css}": ["prettier --write", "stylelint --fix --custom-syntax postcss-less", "git add"]
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "aiot-toolkit": "^2.0.5",
    "eslint": "^8.57.1",
    "eslint-formatter-codeframe": "^7.32.2"
  }
}
