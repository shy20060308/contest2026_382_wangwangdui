      "actions": { "tap": "brightness-toggle-auto" },
      "tokens": { "flow": true, "marginTop": 8, "height": 54, "radius": 14, "paddingX": 12, "background": "#111317", "titleSize": 11, "titleColor": "#FFFFFF", "titleWeight": "bold", "subtitleSize": 7, "subtitleTop": 3, "subtitleColor": "#8E8E93", "chevronWidth": 0, "chevronSize": 0, "chevronColor": "#000000", "chevronText": "" }
    },
    {
      "id": "raise",
      "type": "button",
      "copy": { "title": "抬腕亮屏", "subtitle": "息屏后动作唤醒" },
      "bind": { "state": "raiseWakeEnabled" },
      "props": { "stateMap": { "true": { "text": "抬腕亮屏 · 开", "color": "#30D158", "background": "#102018" }, "false": { "text": "抬腕亮屏 · 关", "color": "#FFFFFF", "background": "#111317" } } },
      "actions": { "tap": "brightness-toggle-raise" },
      "tokens": { "flow": true, "marginTop": 7, "height": 54, "radius": 14, "paddingX": 12, "background": "#111317", "titleSize": 11, "titleColor": "#FFFFFF", "titleWeight": "bold", "subtitleSize": 7, "subtitleTop": 3, "subtitleColor": "#8E8E93", "chevronWidth": 0, "chevronSize": 0, "chevronColor": "#000000", "chevronText": "" }
    },
    {
      "id": "lowPower",
      "type": "button",
      "copy": { "title": "低功耗模式", "subtitle": "暗屏、息屏与降刷新率" },
