<template>
  <stack class="stage-root" style="left: {{ model.frame.left }}px; top: {{ model.frame.top }}px; width: {{ model.frame.width }}px; height: {{ model.frame.height }}px; background-color: {{ model.background }};">
    <div class="stage-analog-dial" for="{{ model.analogDials }}" tid="id" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; border-radius: {{ $item.tokens.radius }}px; border-width: {{ $item.tokens.borderWidth }}px; border-color: {{ $item.tokens.borderColor }}; background-color: {{ $item.tokens.background }};"></div>

    <div class="stage-analog-tick" for="{{ model.analogTicks }}" tid="id" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; transform-origin: {{ $item.originX }}px {{ $item.originY }}px; transform: {{ $item.transform }}; background-color: {{ $item.color }};"></div>

    <div class="stage-panel" for="{{ model.panels }}" tid="id" @click="activate($item.action)" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; border-radius: {{ $item.tokens.radius }}px; border-width: {{ $item.tokens.borderWidth }}px; border-color: {{ $item.tokens.borderColor }}; background-color: {{ $item.tokens.background }};"></div>

    <div class="stage-progress" for="{{ model.progresses }}" tid="id" @click="activate($item.action)" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; border-radius: {{ $item.tokens.radius }}px; background-color: {{ $item.tokens.trackColor }};">
      <div class="stage-progress-fill" style="width: {{ $item.fillWidth }}px; height: {{ $item.frame.height }}px; border-radius: {{ $item.tokens.radius }}px; background-color: {{ $item.tokens.fillColor }};"></div>
    </div>

    <div class="stage-metric" for="{{ model.metrics }}" tid="id" @click="activate($item.action)" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; border-radius: {{ $item.tokens.radius }}px; border-width: {{ $item.tokens.borderWidth }}px; border-color: {{ $item.tokens.borderColor }}; padding: {{ $item.tokens.padding }}px; background-color: {{ $item.tokens.background }};">
      <text class="stage-metric-label" style="width: 100%; height: {{ $item.tokens.labelHeight }}px; line-height: {{ $item.tokens.labelHeight }}px; font-size: {{ $item.tokens.labelSize }}px; color: {{ $item.tokens.labelColor }}; font-weight: {{ $item.tokens.labelWeight }}; text-align: {{ $item.tokens.textAlign }};">{{ $item.label }}</text>
      <text class="stage-metric-value" style="width: 100%; height: {{ $item.tokens.valueHeight }}px; line-height: {{ $item.tokens.valueHeight }}px; margin-top: {{ $item.tokens.valueTop }}px; font-size: {{ $item.tokens.valueSize }}px; color: {{ $item.tokens.valueColor }}; font-weight: {{ $item.tokens.valueWeight }}; text-align: {{ $item.tokens.textAlign }};">{{ $item.value }}</text>
      <text class="stage-metric-detail" if="{{ $item.detail }}" style="width: 100%; height: {{ $item.tokens.detailHeight }}px; line-height: {{ $item.tokens.detailHeight }}px; margin-top: {{ $item.tokens.detailTop }}px; font-size: {{ $item.tokens.detailSize }}px; color: {{ $item.tokens.detailColor }}; text-align: {{ $item.tokens.textAlign }};">{{ $item.detail }}</text>
    </div>

    <text class="stage-text" for="{{ model.texts }}" tid="id" @click="activate($item.action)" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; line-height: {{ $item.tokens.lineHeight }}px; font-size: {{ $item.tokens.fontSize }}px; color: {{ $item.tokens.color }}; font-weight: {{ $item.tokens.fontWeight }}; text-align: {{ $item.tokens.textAlign }}; letter-spacing: {{ $item.tokens.letterSpacing }}px;">{{ $item.text }}</text>

    <div class="stage-analog-hand" for="{{ model.analogHands }}" tid="id" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; border-radius: {{ $item.radius }}px; transform-origin: {{ $item.originX }}px {{ $item.originY }}px; transform: {{ $item.transform }}; background-color: {{ $item.color }};"></div>
    <div class="stage-analog-pin" for="{{ model.analogPins }}" tid="id" style="left: {{ $item.frame.left }}px; top: {{ $item.frame.top }}px; width: {{ $item.frame.width }}px; height: {{ $item.frame.height }}px; border-radius: {{ $item.radius }}px; background-color: {{ $item.color }};"></div>
  </stack>
</template>

<script>
export default {
  props: ['model'],
  activate(action) {
    if (!action) return
    this.$emit('surfaceaction', { action: action })
  }
}
</script>

<style>
.stage-root, .stage-analog-dial, .stage-analog-tick, .stage-panel, .stage-progress, .stage-metric, .stage-text, .stage-analog-hand, .stage-analog-pin { position: absolute; }
.stage-progress { overflow: hidden; flex-direction: row; align-items: center; }
.stage-metric { flex-direction: column; }
</style>
