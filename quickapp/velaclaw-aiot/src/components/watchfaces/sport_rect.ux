<template>
  <div class="rect-sport-face">
    <div class="sport-top"><text class="sport-date" style="color: {{ faceAccent }};">{{ displayMonth }} {{ displayDate }}</text><text class="sport-battery" style="color: {{ batteryColor }};">{{ batteryPercent }}%</text></div>
    <text class="sport-time">{{ displayHours }}:{{ displayMinutes }}</text>
    <div class="sport-accent" style="background-color: {{ faceAccent }};"></div>
    <div class="sport-data-row">
      <div class="sport-card" @click="openSteps"><text class="sport-label">今日步数</text><text class="sport-value sport-steps">{{ stepsText }}</text><text class="sport-sub">目标 {{ stepsGoalText }}</text></div>
      <div class="sport-card sport-card-right" @click="openHealth"><text class="sport-label">当前心率</text><text class="sport-value sport-heart">{{ currentHeartRate }}</text><text class="sport-sub">bpm</text></div>
    </div>
    <div class="sport-battery-track"><div class="sport-battery-fill" style="width: {{ batteryWidth }}; background-color: {{ batteryColor }};"></div></div>
  </div>
</template>

<script>
export default {
  props: ['displayMonth','displayDate','displayMinutes','displayHours','faceAccent','batteryPercent','batteryWidth','batteryColor','currentHeartRate','stepsText','stepsGoalText'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

