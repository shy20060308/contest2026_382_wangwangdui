    <div class="rect-accent" style="background-color: {{ faceAccent }};"></div>
    <div class="rect-metric-row">
      <div class="rect-metric" @click="openSteps"><text class="rect-metric-label">STEPS</text><text class="rect-metric-value steps">{{ stepsText }}</text><text class="rect-metric-sub">目标 {{ stepsGoalText }}</text></div>
      <div class="rect-metric" @click="openHealth"><text class="rect-metric-label">HEART</text><text class="rect-metric-value heart">{{ currentHeartRate }}</text><text class="rect-metric-sub">bpm</text></div>
    </div>
    <div class="rect-battery-track"><div class="rect-battery-fill" style="width: {{ batteryWidth }}; background-color: {{ batteryColor }};"></div></div>
  </div>
</template>

<script>
export default {
  props: ['displayMonth','displayDate','displayMinutes','displayHours','faceAccent','batteryPercent','batteryWidth','batteryColor','currentHeartRate','stepsText','stepsGoalText'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

