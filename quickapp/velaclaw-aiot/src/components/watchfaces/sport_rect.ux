<template>
  <div class="rect-sport-face">
    <div class="rect-head"><text class="rect-date" style="color: {{ faceAccent }};">{{ displayMonth }} {{ displayDate }}</text><text class="rect-battery" style="color: {{ batteryColor }};">{{ batteryPercent }}%</text></div>
