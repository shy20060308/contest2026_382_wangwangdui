<template>
  <div class="rect-sport-face" style="width: {{ faceLayout.root.width }}px;">
    <div class="rect-head" style="width: {{ faceLayout.head.width }}px; height: {{ faceLayout.head.height }}px; margin-top: {{ faceLayout.head.marginTop }}px;"><text class="rect-date" style="font-size: {{ faceLayout.date.fontSize }}px; color: {{ faceAccent }};">{{ displayMonth }} {{ displayDate }}</text><text class="rect-battery" style="font-size: {{ faceLayout.battery.fontSize }}px; color: {{ batteryColor }};">{{ batteryPercent }}%</text></div>
    <text class="rect-time" style="width: {{ faceLayout.time.width }}px; height: {{ faceLayout.time.height }}px; font-size: {{ faceLayout.time.fontSize }}px; margin-top: {{ faceLayout.time.marginTop }}px;">{{ displayHours }}:{{ displayMinutes }}</text>
    <div class="rect-accent" style="width: {{ faceLayout.accent.width }}px; height: {{ faceLayout.accent.height }}px; border-radius: {{ faceLayout.accent.radius }}px; background-color: {{ faceAccent }};"></div>
    <div class="rect-metric-row" style="width: {{ faceLayout.metricRow.width }}px; height: {{ faceLayout.metricRow.height }}px; margin-top: {{ faceLayout.metricRow.marginTop }}px;">
      <div class="rect-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding: {{ faceLayout.metric.padding }}px;" @click="openSteps"><text class="rect-metric-label" style="font-size: {{ faceLayout.metricLabel.fontSize }}px;">STEPS</text><text class="rect-metric-value steps" style="font-size: {{ faceLayout.metricValue.fontSize }}px; margin-top: {{ faceLayout.metricValue.marginTop }}px;">{{ stepsText }}</text><text class="rect-metric-sub" style="font-size: {{ faceLayout.metricSub.fontSize }}px; margin-top: {{ faceLayout.metricSub.marginTop }}px;">目标 {{ stepsGoalText }}</text></div>
      <div class="rect-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding: {{ faceLayout.metric.padding }}px;" @click="openHealth"><text class="rect-metric-label" style="font-size: {{ faceLayout.metricLabel.fontSize }}px;">HEART</text><text class="rect-metric-value heart" style="font-size: {{ faceLayout.metricValue.fontSize }}px; margin-top: {{ faceLayout.metricValue.marginTop }}px;">{{ currentHeartRate }}</text><text class="rect-metric-sub" style="font-size: {{ faceLayout.metricSub.fontSize }}px; margin-top: {{ faceLayout.metricSub.marginTop }}px;">bpm</text></div>
    </div>
    <div class="rect-battery-track" style="width: {{ faceLayout.batteryTrack.width }}px; height: {{ faceLayout.batteryTrack.height }}px; border-radius: {{ faceLayout.batteryTrack.radius }}px; margin-top: {{ faceLayout.batteryTrack.marginTop }}px;"><div class="rect-battery-fill" style="width: {{ batteryWidth }}; height: {{ faceLayout.batteryFill.height }}px; border-radius: {{ faceLayout.batteryFill.radius }}px; background-color: {{ batteryColor }};"></div></div>
  </div>
</template>

<script>
export default {
  props: ['faceLayout','displayMonth','displayDate','displayMinutes','displayHours','faceAccent','batteryPercent','batteryWidth','batteryColor','currentHeartRate','stepsText','stepsGoalText'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.rect-sport-face { height: 100%; flex-direction: column; align-items: center; background-color: #050607; }
.rect-head { flex-direction: row; justify-content: space-between; align-items: center; }
.rect-date { font-weight: bold; } .rect-battery { font-weight: bold; }
.rect-time { color: #FFFFFF; font-weight: bold; text-align: center; }
.rect-metric-row { flex-direction: row; justify-content: space-between; }
.rect-metric { background-color: #12161D; flex-direction: column; }
.rect-metric-label { color: #8E8E93; } .rect-metric-value { font-weight: bold; } .steps { color: #FFD60A; } .heart { color: #FF375F; }
.rect-metric-sub { color: #636366; }
.rect-battery-track { background-color: #242426; }
</style>
