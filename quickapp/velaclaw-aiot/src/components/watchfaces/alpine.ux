<template>
  <stack class="alpine-face">
    <image class="alpine-background" src="/common/watchfaces/alpine_night.jpg"></image>
    <div class="alpine-veil"></div>
    <div class="alpine-date-glass" style="left: {{ faceLayout.dateGlass.left }}px; top: {{ faceLayout.dateGlass.top }}px; width: {{ faceLayout.dateGlass.width }}px; height: {{ faceLayout.dateGlass.height }}px; border-radius: {{ faceLayout.dateGlass.radius }}px; border-width: {{ faceLayout.dateGlass.borderWidth }}px;" @click="openToday"></div>
    <div class="alpine-date-row" style="left: {{ faceLayout.dateRow.left }}px; top: {{ faceLayout.dateRow.top }}px; width: {{ faceLayout.dateRow.width }}px; height: {{ faceLayout.dateRow.height }}px;" @click="openToday"><div class="alpine-date-copy" style="width: {{ faceLayout.dateCopy.width }}px; height: {{ faceLayout.dateCopy.height }}px;"><text class="alpine-week" style="width: {{ faceLayout.week.width }}px; height: {{ faceLayout.week.height }}px; font-size: {{ faceLayout.week.fontSize }}px;">{{ displayWeek }}</text><text class="alpine-date" style="width: {{ faceLayout.date.width }}px; height: {{ faceLayout.date.height }}px; font-size: {{ faceLayout.date.fontSize }}px; margin-top: {{ faceLayout.date.marginTop }}px;">{{ displayMonth }} {{ displayDate }}</text></div><text class="alpine-brand" style="width: {{ faceLayout.brand.width }}px; font-size: {{ faceLayout.brand.fontSize }}px;">VELA / ALPINE</text></div>
    <text class="alpine-eyebrow" style="left: {{ faceLayout.eyebrow.left }}px; top: {{ faceLayout.eyebrow.top }}px; width: {{ faceLayout.eyebrow.width }}px; height: {{ faceLayout.eyebrow.height }}px; font-size: {{ faceLayout.eyebrow.fontSize }}px;">MIDNIGHT TRAIL</text><text class="alpine-hour" style="left: {{ faceLayout.hour.left }}px; top: {{ faceLayout.hour.top }}px; width: {{ faceLayout.hour.width }}px; height: {{ faceLayout.hour.height }}px; font-size: {{ faceLayout.hour.fontSize }}px;">{{ displayHours }}</text><div class="alpine-time-accent" style="left: {{ faceLayout.timeAccent.left }}px; top: {{ faceLayout.timeAccent.top }}px; width: {{ faceLayout.timeAccent.width }}px; height: {{ faceLayout.timeAccent.height }}px; border-radius: {{ faceLayout.timeAccent.radius }}px;"></div><text class="alpine-minute" style="left: {{ faceLayout.minute.left }}px; top: {{ faceLayout.minute.top }}px; width: {{ faceLayout.minute.width }}px; height: {{ faceLayout.minute.height }}px; font-size: {{ faceLayout.minute.fontSize }}px;">{{ displayMinutes }}</text>
    <div class="alpine-data-glass" style="left: {{ faceLayout.dataGlass.left }}px; top: {{ faceLayout.dataGlass.top }}px; width: {{ faceLayout.dataGlass.width }}px; height: {{ faceLayout.dataGlass.height }}px; border-radius: {{ faceLayout.dataGlass.radius }}px; border-width: {{ faceLayout.dataGlass.borderWidth }}px;"></div>
    <div class="alpine-data-row" style="left: {{ faceLayout.dataRow.left }}px; top: {{ faceLayout.dataRow.top }}px; width: {{ faceLayout.dataRow.width }}px; height: {{ faceLayout.dataRow.height }}px;"><div class="alpine-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;" @click="openSteps"><text class="alpine-metric-label" style="width: {{ faceLayout.metricLabel.width }}px; height: {{ faceLayout.metricLabel.height }}px; font-size: {{ faceLayout.metricLabel.fontSize }}px;">STEPS</text><text class="alpine-step-value" style="width: {{ faceLayout.metricValue.width }}px; height: {{ faceLayout.metricValue.height }}px; font-size: {{ faceLayout.metricValue.fontSize }}px; margin-top: {{ faceLayout.metricValue.marginTop }}px;">{{ stepsText }}</text></div><div class="alpine-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;" @click="openHealth"><text class="alpine-metric-label" style="width: {{ faceLayout.metricLabel.width }}px; height: {{ faceLayout.metricLabel.height }}px; font-size: {{ faceLayout.metricLabel.fontSize }}px;">HEART</text><text class="alpine-heart-value" style="width: {{ faceLayout.metricValue.width }}px; height: {{ faceLayout.metricValue.height }}px; font-size: {{ faceLayout.metricValue.fontSize }}px; margin-top: {{ faceLayout.metricValue.marginTop }}px;">{{ currentHeartRate }}</text></div></div>
    <div class="alpine-battery-row" style="left: {{ faceLayout.battery.left }}px; top: {{ faceLayout.battery.top }}px; width: {{ faceLayout.battery.width }}px; height: {{ faceLayout.battery.height }}px;"><text class="alpine-battery-label" style="width: {{ faceLayout.batteryLabel.width }}px; font-size: {{ faceLayout.batteryLabel.fontSize }}px;">POWER</text><div class="alpine-battery-track" style="width: {{ faceLayout.batteryTrack.width }}px; height: {{ faceLayout.batteryTrack.height }}px; border-radius: {{ faceLayout.batteryTrack.radius }}px;"><div class="alpine-battery-fill" style="width: {{ batteryWidth }}; height: {{ faceLayout.batteryFill.height }}px; border-radius: {{ faceLayout.batteryFill.radius }}px; background-color: {{ batteryColor }};"></div></div><text class="alpine-battery-value" style="width: {{ faceLayout.batteryValue.width }}px; font-size: {{ faceLayout.batteryValue.fontSize }}px; margin-left: {{ faceLayout.batteryValue.marginLeft }}px;">{{ batteryPercent }}%</text></div>
  </stack>
</template>

<script>
export default {
  props: ['faceLayout','displayWeek','displayMonth','displayDate','displayHours','displayMinutes','stepsText','currentHeartRate','batteryPercent','batteryWidth','batteryColor'],
  openToday() { this.$emit('openToday') },
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

