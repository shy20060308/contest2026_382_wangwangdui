<template>
  <div class="simple-face">
    <div class="simple-heading" style="width: {{ faceLayout.heading.width }}px; height: {{ faceLayout.heading.height }}px;"><text class="simple-week" style="font-size: {{ faceLayout.week.fontSize }}px; color: {{ faceAccent }}">{{ displayWeek }}</text><text class="simple-date" style="font-size: {{ faceLayout.date.fontSize }}px;">{{ displayMonth }} {{ displayDate }}</text></div>
    <stack class="simple-neon-dial" style="width: {{ faceLayout.dial.width }}px; height: {{ faceLayout.dial.height }}px; margin-top: {{ faceLayout.dial.marginTop }}px;">
      <progress class="simple-neon-arc" type="arc" percent="{{ goalPercent }}" style="width: {{ faceLayout.arc.width }}px; height: {{ faceLayout.arc.height }}px; stroke-width: {{ faceLayout.arc.strokeWidth }}px; start-angle: {{ faceLayout.arc.startAngle }}deg; total-angle: {{ faceLayout.arc.totalAngle }}deg; center-x: {{ faceLayout.arc.centerX }}px; center-y: {{ faceLayout.arc.centerY }}px; radius: {{ faceLayout.arc.radius }}px; color: {{ faceAccent }};"></progress>
      <div class="simple-dial-center" style="width: {{ faceLayout.center.width }}px; height: {{ faceLayout.center.height }}px;"><text class="simple-time" style="font-size: {{ faceLayout.time.fontSize }}px;">{{ displayHours }}:{{ displayMinutes }}</text><text class="simple-goal" style="font-size: {{ faceLayout.goal.fontSize }}px; margin-top: {{ faceLayout.goal.marginTop }}px; color: {{ faceAccent }}">目标 {{ goalPercent }}%</text></div>
    </stack>
    <div class="simple-metrics" style="width: {{ faceLayout.metrics.width }}px; margin-top: {{ faceLayout.metrics.marginTop }}px;">
      <div class="simple-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding-top: {{ faceLayout.metric.paddingTop }}px;" @click="openSteps"><text class="simple-metric-value" style="font-size: {{ faceLayout.metricValue.fontSize }}px; color: #FFD60A">{{ stepsText }}</text><text class="simple-metric-label" style="font-size: {{ faceLayout.metricLabel.fontSize }}px; margin-top: {{ faceLayout.metricLabel.marginTop }}px;">步数</text></div>
      <div class="simple-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding-top: {{ faceLayout.metric.paddingTop }}px;" @click="openHealth"><text class="simple-metric-value" style="font-size: {{ faceLayout.metricValue.fontSize }}px; color: #FF375F">{{ currentHeartRate }}</text><text class="simple-metric-label" style="font-size: {{ faceLayout.metricLabel.fontSize }}px; margin-top: {{ faceLayout.metricLabel.marginTop }}px;">心率</text></div>
      <div class="simple-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding-top: {{ faceLayout.metric.paddingTop }}px;"><text class="simple-metric-value" style="font-size: {{ faceLayout.metricValue.fontSize }}px; color: {{ batteryColor }}">{{ batteryPercent }}%</text><text class="simple-metric-label" style="font-size: {{ faceLayout.metricLabel.fontSize }}px; margin-top: {{ faceLayout.metricLabel.marginTop }}px;">电量</text></div>
    </div>
  </div>
</template>

<script>
export default {
  props: ['faceLayout','displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','goalPercent','stepsText','currentHeartRate','batteryPercent','batteryColor'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.simple-face { flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 100%; }
.simple-heading { flex-direction: row; align-items: center; justify-content: space-between; }
.simple-week { font-weight: bold; }
.simple-date { color: #8E8E93; }
.simple-neon-arc { layer-color: #20242B; }
.simple-dial-center { flex-direction: column; align-items: center; justify-content: center; }
.simple-time { font-weight: bold; color: #FFFFFF; text-align: center; }
.simple-goal { font-weight: bold; }
.simple-metrics { flex-direction: row; justify-content: space-between; }
.simple-metric { flex-direction: column; align-items: center; background-color: #12161D; }
.simple-metric-value { font-weight: bold; text-align: center; }
.simple-metric-label { color: #8E8E93; }
</style>
