<template>
  <div class="rect-dashboard-face">
    <div class="dash-top"><div class="dash-time-block"><text class="dash-time">{{ displayHours }}:{{ displayMinutes }}</text><text class="dash-date" style="color: {{ faceAccent }};">{{ displayWeek }} · {{ displayMonth }} {{ displayDate }}</text></div><text class="dash-power" style="color: {{ batteryColor }};">{{ batteryPercent }}%</text></div>
    <div class="dash-card" @click="openSteps"><div class="dash-card-head"><text class="dash-label">今日步数</text><text class="dash-value dash-steps">{{ stepsText }}</text></div><div class="dash-track"><div class="dash-fill" style="width: {{ stepsProgressWidth }};"></div></div><text class="dash-sub">目标 {{ stepsGoalText }}</text></div>
    <div class="dash-card dash-heart-card" @click="openHealth"><div class="dash-card-head"><text class="dash-label">实时心率</text><text class="dash-value dash-heart">{{ currentHeartRate }}</text></div><div class="dash-bars"><div class="dash-bar" for="{{ heartRateData }}" style="height: {{ heartBarHeight($idx) }}px;"></div></div><text class="dash-sub">bpm</text></div>
  </div>
</template>

<script>
var watchfaceChart = require('../../v2/design/watchface_chart')
export default {
  props: ['displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','stepsText','stepsGoalText','stepsProgressWidth','currentHeartRate','heartRateData','batteryPercent','batteryColor'],
  heartBarHeight(index) { return watchfaceChart.sampleBarHeight(this.heartRateData, index, 3, 18, 8) },
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.rect-dashboard-face { width: 192px; height: 100%; flex-direction: column; align-items: center; background-color: #07090D; }
.dash-top { width: 164px; height: 48px; margin-top: 14px; flex-direction: row; justify-content: space-between; align-items: center; }
.dash-time-block { width: 120px; flex-direction: column; } .dash-time { width: 120px; font-size: 28px; color: #FFFFFF; font-weight: bold; } .dash-date { width: 120px; font-size: 7px; font-weight: bold; margin-top: 2px; }
.dash-power { width: 38px; font-size: 9px; font-weight: bold; text-align: right; }
.dash-card { width: 164px; height: 56px; border-radius: 10px; background-color: #14181F; padding: 7px 10px; flex-direction: column; }
.dash-heart-card { margin-top: 8px; }
.dash-card-head { width: 144px; height: 18px; flex-direction: row; justify-content: space-between; align-items: center; }
.dash-label { font-size: 8px; color: #D1D1D6; } .dash-value { width: 70px; font-size: 15px; font-weight: bold; text-align: right; lines: 1; }
.dash-steps { font-size: 13px; color: #FFD60A; } .dash-heart { color: #FF375F; }
.dash-track { width: 144px; height: 4px; border-radius: 2px; background-color: #2C2C2E; margin-top: 5px; } .dash-fill { height: 4px; border-radius: 2px; background-color: #FFD60A; }
.dash-bars { width: 144px; height: 18px; flex-direction: row; justify-content: space-between; align-items: flex-end; margin-top: 2px; } .dash-bar { width: 7px; border-radius: 3px; background-color: #FF375F; }
.dash-sub { font-size: 6px; color: #636366; margin-top: 2px; }
</style>
