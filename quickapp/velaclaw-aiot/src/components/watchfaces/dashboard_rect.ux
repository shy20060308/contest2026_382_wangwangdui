<template>
  <div class="rect-dashboard-face" style="width: {{ faceLayout.root.width }}px;">
    <div class="dash-head" style="width: {{ faceLayout.head.width }}px; height: {{ faceLayout.head.height }}px; margin-top: {{ faceLayout.head.marginTop }}px;"><div><text class="dash-time" style="font-size: {{ faceLayout.time.fontSize }}px;">{{ displayHours }}:{{ displayMinutes }}</text><text class="dash-date" style="font-size: {{ faceLayout.date.fontSize }}px; margin-top: {{ faceLayout.date.marginTop }}px; color: {{ faceAccent }};">{{ displayWeek }} · {{ displayMonth }} {{ displayDate }}</text></div><text class="dash-power" style="width: {{ faceLayout.power.width }}px; font-size: {{ faceLayout.power.fontSize }}px; color: {{ batteryColor }};">{{ batteryPercent }}%</text></div>
    <div class="dash-card" style="width: {{ faceLayout.card.width }}px; height: {{ faceLayout.card.height }}px; border-radius: {{ faceLayout.card.radius }}px; padding-top: {{ faceLayout.card.paddingY }}px; padding-bottom: {{ faceLayout.card.paddingY }}px; padding-left: {{ faceLayout.card.paddingX }}px; padding-right: {{ faceLayout.card.paddingX }}px; margin-bottom: {{ faceLayout.card.marginBottom }}px;" @click="openSteps"><div class="dash-card-head" style="width: {{ faceLayout.cardHead.width }}px; height: {{ faceLayout.cardHead.height }}px;"><text class="dash-label" style="font-size: {{ faceLayout.label.fontSize }}px;">今日步数</text><text class="dash-value steps" style="font-size: {{ faceLayout.value.fontSize }}px;">{{ stepsText }}</text></div><div class="dash-track" style="width: {{ faceLayout.track.width }}px; height: {{ faceLayout.track.height }}px; border-radius: {{ faceLayout.track.radius }}px; margin-top: {{ faceLayout.track.marginTop }}px;"><div class="dash-fill" style="width: {{ stepsProgressWidth }}; height: {{ faceLayout.fill.height }}px; border-radius: {{ faceLayout.fill.radius }}px;"></div></div><text class="dash-sub" style="font-size: {{ faceLayout.sub.fontSize }}px; margin-top: {{ faceLayout.sub.marginTop }}px;">目标 {{ stepsGoalText }}</text></div>
    <div class="dash-card" style="width: {{ faceLayout.card.width }}px; height: {{ faceLayout.card.height }}px; border-radius: {{ faceLayout.card.radius }}px; padding-top: {{ faceLayout.card.paddingY }}px; padding-bottom: {{ faceLayout.card.paddingY }}px; padding-left: {{ faceLayout.card.paddingX }}px; padding-right: {{ faceLayout.card.paddingX }}px; margin-bottom: {{ faceLayout.card.marginBottom }}px;" @click="openHealth"><div class="dash-card-head" style="width: {{ faceLayout.cardHead.width }}px; height: {{ faceLayout.cardHead.height }}px;"><text class="dash-label" style="font-size: {{ faceLayout.label.fontSize }}px;">实时心率</text><text class="dash-value heart" style="font-size: {{ faceLayout.value.fontSize }}px;">{{ currentHeartRate }}</text></div><div class="dash-bars" style="width: {{ faceLayout.bars.width }}px; height: {{ faceLayout.bars.height }}px; margin-top: {{ faceLayout.bars.marginTop }}px;"><div class="dash-bar" for="{{ heartRateData }}" style="width: {{ faceLayout.bar.width }}px; border-radius: {{ faceLayout.bar.radius }}px; height: {{ heartBarHeight($idx) }}px;"></div></div><text class="dash-sub" style="font-size: {{ faceLayout.sub.fontSize }}px; margin-top: {{ faceLayout.sub.marginTop }}px;">bpm</text></div>
  </div>
</template>

<script>
var watchfaceChart = require('../../v2/design/watchface_chart')
export default {
  props: ['faceLayout','displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','stepsText','stepsGoalText','stepsProgressWidth','currentHeartRate','heartRateData','batteryPercent','batteryColor'],
  heartBarHeight(index) { return watchfaceChart.sampleBarHeight(this.heartRateData, index, this.faceLayout.bar.minHeight, this.faceLayout.bar.maxHeight, this.faceLayout.bar.minSpan) },
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.rect-dashboard-face { height: 100%; flex-direction: column; align-items: center; background-color: #080B10; }
.dash-head { flex-direction: row; justify-content: space-between; align-items: center; }
.dash-time { color: #FFFFFF; font-weight: bold; } .dash-date { font-weight: bold; } .dash-power { font-weight: bold; text-align: right; }
.dash-card { background-color: #14181F; flex-direction: column; }
.dash-card-head { flex-direction: row; justify-content: space-between; align-items: center; } .dash-label { color: #D1D1D6; } .dash-value { font-weight: bold; } .steps { color: #FFD60A; } .heart { color: #FF375F; }
.dash-track { background-color: #2C2C2E; } .dash-fill { background-color: #FFD60A; }
.dash-bars { flex-direction: row; justify-content: space-between; align-items: flex-end; } .dash-bar { background-color: #FF375F; }
.dash-sub { color: #636366; }
</style>
