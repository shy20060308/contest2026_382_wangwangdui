<template>
  <div class="rect-dashboard-face">
    <div class="dash-head"><div><text class="dash-time">{{ displayHours }}:{{ displayMinutes }}</text><text class="dash-date" style="color: {{ faceAccent }};">{{ displayWeek }} · {{ displayMonth }} {{ displayDate }}</text></div><text class="dash-power" style="color: {{ batteryColor }};">{{ batteryPercent }}%</text></div>
    <div class="dash-card" @click="openSteps"><div class="dash-card-head"><text class="dash-label">今日步数</text><text class="dash-value steps">{{ stepsText }}</text></div><div class="dash-track"><div class="dash-fill" style="width: {{ stepsProgressWidth }};"></div></div><text class="dash-sub">目标 {{ stepsGoalText }}</text></div>
    <div class="dash-card" @click="openHealth"><div class="dash-card-head"><text class="dash-label">实时心率</text><text class="dash-value heart">{{ currentHeartRate }}</text></div><div class="dash-bars"><div class="dash-bar" for="{{ heartRateData }}" style="height: {{ heartBarHeight($idx) }}px;"></div></div><text class="dash-sub">bpm</text></div>
  </div>
</template>

<script>
var watchfaceChart = require('../../v2/design/watchface_chart')
export default {
  props: ['displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','stepsText','stepsGoalText','stepsProgressWidth','currentHeartRate','heartRateData','batteryPercent','batteryColor'],
  heartBarHeight(index) { return watchfaceChart.sampleBarHeight(this.heartRateData, index, 3, 20, 8) },
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.rect-dashboard-face { width: 192px; height: 100%; flex-direction: column; align-items: center; background-color: #080B10; }
.dash-head { width: 164px; height: 56px; margin-top: 14px; flex-direction: row; justify-content: space-between; align-items: center; }
.dash-time { font-size: 29px; color: #FFFFFF; font-weight: bold; } .dash-date { font-size: 7px; font-weight: bold; margin-top: 2px; } .dash-power { width: 38px; font-size: 9px; font-weight: bold; text-align: right; }
.dash-card { width: 164px; height: 68px; border-radius: 16px; background-color: #14181F; padding: 9px 11px; margin-bottom: 8px; flex-direction: column; }
.dash-card-head { width: 142px; height: 22px; flex-direction: row; justify-content: space-between; align-items: center; } .dash-label { font-size: 8px; color: #D1D1D6; } .dash-value { font-size: 17px; font-weight: bold; } .steps { color: #FFD60A; } .heart { color: #FF375F; }
.dash-track { width: 142px; height: 5px; border-radius: 3px; background-color: #2C2C2E; margin-top: 5px; } .dash-fill { height: 5px; border-radius: 3px; background-color: #FFD60A; }
.dash-bars { width: 142px; height: 20px; flex-direction: row; justify-content: space-between; align-items: flex-end; margin-top: 3px; } .dash-bar { width: 7px; border-radius: 3px; background-color: #FF375F; }
.dash-sub { font-size: 6px; color: #636366; margin-top: 3px; }
</style>
