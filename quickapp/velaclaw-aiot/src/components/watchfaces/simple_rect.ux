<template>
  <div class="rect-simple-face">
    <div class="simple-head"><text class="simple-week" style="color: {{ faceAccent }};">{{ displayWeek }}</text><text class="simple-date">{{ displayMonth }} {{ displayDate }}</text></div>
    <text class="simple-time">{{ displayHours }}:{{ displayMinutes }}</text>
    <div class="goal-row"><text class="goal-label">DAILY GOAL</text><text class="goal-value" style="color: {{ faceAccent }};">{{ goalPercent }}%</text></div>
    <div class="goal-track"><div class="goal-fill" style="width: {{ goalPercent }}%; background-color: {{ faceAccent }};"></div></div>
    <div class="simple-metrics">
