      <div class="simple-metric" @click="openHealth"><text class="simple-value heart">{{ currentHeartRate }}</text><text class="simple-label">心率</text></div>
      <div class="simple-metric"><text class="simple-value" style="color: {{ batteryColor }};">{{ batteryPercent }}%</text><text class="simple-label">电量</text></div>
    </div>
  </div>
</template>

<script>
export default {
  props: ['displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','goalPercent','stepsText','currentHeartRate','batteryPercent','batteryColor'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

