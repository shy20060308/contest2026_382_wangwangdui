<template>
  <div class="rect-simple-face" style="width: {{ faceLayout.root.width }}px;">
    <div class="simple-head" style="width: {{ faceLayout.head.width }}px; height: {{ faceLayout.head.height }}px; margin-top: {{ faceLayout.head.marginTop }}px;"><text class="simple-week" style="font-size: {{ faceLayout.week.fontSize }}px; color: {{ faceAccent }};">{{ displayWeek }}</text><text class="simple-date" style="font-size: {{ faceLayout.date.fontSize }}px;">{{ displayMonth }} {{ displayDate }}</text></div>
    <text class="simple-time" style="width: {{ faceLayout.time.width }}px; height: {{ faceLayout.time.height }}px; font-size: {{ faceLayout.time.fontSize }}px; margin-top: {{ faceLayout.time.marginTop }}px;">{{ displayHours }}:{{ displayMinutes }}</text>
    <div class="goal-row" style="width: {{ faceLayout.goalRow.width }}px; height: {{ faceLayout.goalRow.height }}px; margin-top: {{ faceLayout.goalRow.marginTop }}px;"><text class="goal-label" style="font-size: {{ faceLayout.goalLabel.fontSize }}px;">DAILY GOAL</text><text class="goal-value" style="font-size: {{ faceLayout.goalValue.fontSize }}px; color: {{ faceAccent }};">{{ goalPercent }}%</text></div>
    <div class="goal-track" style="width: {{ faceLayout.goalTrack.width }}px; height: {{ faceLayout.goalTrack.height }}px; border-radius: {{ faceLayout.goalTrack.radius }}px;"><div class="goal-fill" style="width: {{ goalPercent }}%; height: {{ faceLayout.goalFill.height }}px; border-radius: {{ faceLayout.goalFill.radius }}px; background-color: {{ faceAccent }};"></div></div>
    <div class="simple-metrics" style="width: {{ faceLayout.metrics.width }}px; height: {{ faceLayout.metrics.height }}px; margin-top: {{ faceLayout.metrics.marginTop }}px;">
      <div class="simple-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding-top: {{ faceLayout.metric.paddingTop }}px;" @click="openSteps"><text class="simple-value steps" style="width: {{ faceLayout.value.width }}px; font-size: {{ faceLayout.value.fontSize }}px;">{{ stepsText }}</text><text class="simple-label" style="font-size: {{ faceLayout.label.fontSize }}px; margin-top: {{ faceLayout.label.marginTop }}px;">步数</text></div>
      <div class="simple-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding-top: {{ faceLayout.metric.paddingTop }}px;" @click="openHealth"><text class="simple-value heart" style="width: {{ faceLayout.value.width }}px; font-size: {{ faceLayout.value.fontSize }}px;">{{ currentHeartRate }}</text><text class="simple-label" style="font-size: {{ faceLayout.label.fontSize }}px; margin-top: {{ faceLayout.label.marginTop }}px;">心率</text></div>
      <div class="simple-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px; border-radius: {{ faceLayout.metric.radius }}px; padding-top: {{ faceLayout.metric.paddingTop }}px;"><text class="simple-value" style="width: {{ faceLayout.value.width }}px; font-size: {{ faceLayout.value.fontSize }}px; color: {{ batteryColor }};">{{ batteryPercent }}%</text><text class="simple-label" style="font-size: {{ faceLayout.label.fontSize }}px; margin-top: {{ faceLayout.label.marginTop }}px;">电量</text></div>
    </div>
  </div>
</template>

<script>
export default {
  props: ['faceLayout','displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','goalPercent','stepsText','currentHeartRate','batteryPercent','batteryColor'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

