<template>
  <div class="circle-dashboard-face" style="width: {{ faceLayout.root.width }}px; height: {{ faceLayout.root.height }}px;">
    <text class="dashboard-circle-time" style="font-size: {{ faceLayout.time.fontSize }}px; margin-top: {{ faceLayout.time.marginTop }}px;">{{ displayHours }}:{{ displayMinutes }}</text>
    <text class="dashboard-circle-date" style="font-size: {{ faceLayout.date.fontSize }}px; margin-top: {{ faceLayout.date.marginTop }}px; color: {{ faceAccent }}">{{ displayWeek }}  {{ displayMonth }} {{ displayDate }}</text>
    <div class="dashboard-circle-grid" style="width: {{ faceLayout.grid.width }}px; height: {{ faceLayout.grid.height }}px; margin-top: {{ faceLayout.grid.marginTop }}px;">
      <div class="dashboard-circle-card" style="width: {{ faceLayout.card.width }}px; height: {{ faceLayout.card.height }}px; border-radius: {{ faceLayout.card.radius }}px; padding-top: {{ faceLayout.card.paddingTop }}px;" @click="openSteps"><text class="dashboard-circle-label" style="font-size: {{ faceLayout.label.fontSize }}px;">步数</text><text class="dashboard-circle-value step-color" style="font-size: {{ faceLayout.value.fontSize }}px; margin-top: {{ faceLayout.value.marginTop }}px;">{{ stepsText }}</text><div class="dashboard-circle-track" style="width: {{ faceLayout.track.width }}px; height: {{ faceLayout.track.height }}px; border-radius: {{ faceLayout.track.radius }}px; margin-top: {{ faceLayout.track.marginTop }}px;"><div class="dashboard-circle-fill" style="width: {{ stepsProgressWidth }}; height: {{ faceLayout.fill.height }}px; border-radius: {{ faceLayout.fill.radius }}px; background-color: #FFD60A;"></div></div></div>
      <div class="dashboard-circle-card" style="width: {{ faceLayout.card.width }}px; height: {{ faceLayout.card.height }}px; border-radius: {{ faceLayout.card.radius }}px; padding-top: {{ faceLayout.card.paddingTop }}px;" @click="openHealth"><text class="dashboard-circle-label" style="font-size: {{ faceLayout.label.fontSize }}px;">心率</text><text class="dashboard-circle-value heart-color" style="font-size: {{ faceLayout.value.fontSize }}px; margin-top: {{ faceLayout.value.marginTop }}px;">{{ currentHeartRate }}</text><div class="dashboard-circle-bars" style="width: {{ faceLayout.bars.width }}px; height: {{ faceLayout.bars.height }}px; margin-top: {{ faceLayout.bars.marginTop }}px;"><div class="dashboard-circle-bar" for="{{ heartRateData }}" style="width: {{ faceLayout.bar.width }}px; max-height: {{ faceLayout.bar.maxHeight }}px; border-radius: {{ faceLayout.bar.radius }}px; height: {{ heartBarHeight($idx) }}px;"></div></div></div>
    </div>
    <div class="dashboard-circle-battery" style="width: {{ faceLayout.battery.width }}px; height: {{ faceLayout.battery.height }}px; margin-top: {{ faceLayout.battery.marginTop }}px;"><image class="dashboard-circle-icon" style="width: {{ faceLayout.batteryIcon.width }}px; height: {{ faceLayout.batteryIcon.height }}px;" src="/common/lightning.png"></image><div class="dashboard-circle-battery-track" style="width: {{ faceLayout.batteryTrack.width }}px; height: {{ faceLayout.batteryTrack.height }}px; border-radius: {{ faceLayout.batteryTrack.radius }}px; margin-left: {{ faceLayout.batteryTrack.marginLeft }}px;"><div class="dashboard-circle-battery-fill" style="width: {{ batteryWidth }}; height: {{ faceLayout.batteryFill.height }}px; border-radius: {{ faceLayout.batteryFill.radius }}px; background-color: {{ batteryColor }};"></div></div><text class="dashboard-circle-battery-text" style="width: {{ faceLayout.batteryText.width }}px; font-size: {{ faceLayout.batteryText.fontSize }}px; margin-left: {{ faceLayout.batteryText.marginLeft }}px; color: {{ batteryColor }}">{{ batteryPercent }}%</text></div>
  </div>
</template>

<script>
var watchfaceChart = require('../../v2/design/watchface_chart')

export default {
  props: ['faceLayout','displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','stepsText','stepsProgressWidth','currentHeartRate','heartRateData','batteryPercent','batteryWidth','batteryColor'],
  heartBarHeight(index) { return watchfaceChart.sampleBarHeight(this.heartRateData, index, this.faceLayout.bar.minHeight, this.faceLayout.bar.maxHeight, this.faceLayout.bar.minSpan) },
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.circle-dashboard-face { flex-direction: column; align-items: center; background-color: #080B10; }
.dashboard-circle-time { color: #FFFFFF; font-weight: bold; }
.dashboard-circle-date { font-weight: bold; }
.dashboard-circle-grid { flex-direction: row; justify-content: space-between; }
.dashboard-circle-card { flex-direction: column; align-items: center; background-color: #14181F; }
.dashboard-circle-label { color: #8E8E93; }
.dashboard-circle-value { font-weight: bold; }
.dashboard-circle-track { background-color: #2C2C2E; }
.dashboard-circle-bars { flex-direction: row; align-items: flex-end; justify-content: space-between; }
.dashboard-circle-bar { background-color: #FF375F; }
.dashboard-circle-battery { flex-direction: row; align-items: center; }
.dashboard-circle-battery-track { background-color: #2C2C2E; }
.dashboard-circle-battery-text { font-weight: bold; text-align: right; }
.heart-color { color: #FF375F; } .step-color { color: #FFD60A; }
</style>
