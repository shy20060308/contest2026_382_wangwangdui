<template>
  <div class="mechanical-circle-face" style="left: {{ faceLayout.root.left }}px; top: {{ faceLayout.root.top }}px; width: {{ faceLayout.root.width }}px; height: {{ faceLayout.root.height }}px;">
    <stack class="mechanical-dial" style="left: {{ faceLayout.dial.left }}px; top: {{ faceLayout.dial.top }}px; width: {{ faceLayout.dial.width }}px; height: {{ faceLayout.dial.height }}px;">
      <div class="mechanical-bezel" style="left: {{ faceLayout.bezel.left }}px; top: {{ faceLayout.bezel.top }}px; width: {{ faceLayout.bezel.width }}px; height: {{ faceLayout.bezel.height }}px; border-radius: {{ faceLayout.bezel.radius }}px; border-width: {{ faceLayout.bezel.borderWidth }}px;"></div><div class="mechanical-inner-ring" style="left: {{ faceLayout.innerRing.left }}px; top: {{ faceLayout.innerRing.top }}px; width: {{ faceLayout.innerRing.width }}px; height: {{ faceLayout.innerRing.height }}px; border-radius: {{ faceLayout.innerRing.radius }}px; border-width: {{ faceLayout.innerRing.borderWidth }}px;"></div>
      <div class="{{ $item.className }}" for="{{ analogTicks }}" tid="index" style="left: {{ tickLeft($item) }}px; top: {{ tickTop($item) }}px; width: {{ tickWidth($item) }}px; height: {{ tickHeight($item) }}px; transform-origin: {{ tickOriginX($item) }}px {{ tickOriginY($item) }}px; transform: {{ $item.transform }};"></div>
      <text class="mechanical-roman roman-twelve" style="width: {{ faceLayout.roman.width }}px; height: {{ faceLayout.roman.height }}px; font-size: {{ faceLayout.roman.fontSize }}px; left: {{ faceLayout.romanTwelve.left }}px; top: {{ faceLayout.romanTwelve.top }}px;">XII</text><text class="mechanical-roman roman-three" style="width: {{ faceLayout.roman.width }}px; height: {{ faceLayout.roman.height }}px; font-size: {{ faceLayout.roman.fontSize }}px; left: {{ faceLayout.romanThree.left }}px; top: {{ faceLayout.romanThree.top }}px;">III</text><text class="mechanical-roman roman-six" style="width: {{ faceLayout.roman.width }}px; height: {{ faceLayout.roman.height }}px; font-size: {{ faceLayout.roman.fontSize }}px; left: {{ faceLayout.romanSix.left }}px; top: {{ faceLayout.romanSix.top }}px;">VI</text><text class="mechanical-roman roman-nine" style="width: {{ faceLayout.roman.width }}px; height: {{ faceLayout.roman.height }}px; font-size: {{ faceLayout.roman.fontSize }}px; left: {{ faceLayout.romanNine.left }}px; top: {{ faceLayout.romanNine.top }}px;">IX</text>
      <text class="mechanical-brand" style="left: {{ faceLayout.brand.left }}px; top: {{ faceLayout.brand.top }}px; width: {{ faceLayout.brand.width }}px; height: {{ faceLayout.brand.height }}px; font-size: {{ faceLayout.brand.fontSize }}px;">VELA</text><text class="mechanical-caption" style="left: {{ faceLayout.caption.left }}px; top: {{ faceLayout.caption.top }}px; width: {{ faceLayout.caption.width }}px; height: {{ faceLayout.caption.height }}px; font-size: {{ faceLayout.caption.fontSize }}px;">AUTOMATIC</text><text class="mechanical-power" style="left: {{ faceLayout.power.left }}px; top: {{ faceLayout.power.top }}px; width: {{ faceLayout.power.width }}px; height: {{ faceLayout.power.height }}px; font-size: {{ faceLayout.power.fontSize }}px;">POWER {{ batteryPercent }}%</text>
      <div class="mechanical-date-window" style="left: {{ faceLayout.dateWindow.left }}px; top: {{ faceLayout.dateWindow.top }}px; width: {{ faceLayout.dateWindow.width }}px; height: {{ faceLayout.dateWindow.height }}px; border-radius: {{ faceLayout.dateWindow.radius }}px; border-width: {{ faceLayout.dateWindow.borderWidth }}px;" @click="openToday"><text class="mechanical-date-label" style="width: {{ faceLayout.dateLabel.width }}px; height: {{ faceLayout.dateLabel.height }}px; font-size: {{ faceLayout.dateLabel.fontSize }}px;">{{ displayMonth }}</text><text class="mechanical-date-value" style="width: {{ faceLayout.dateValue.width }}px; height: {{ faceLayout.dateValue.height }}px; font-size: {{ faceLayout.dateValue.fontSize }}px;">{{ displayDate }}</text></div>
      <stack class="mechanical-subdial" style="left: {{ faceLayout.subdial.left }}px; top: {{ faceLayout.subdial.top }}px; width: {{ faceLayout.subdial.width }}px; height: {{ faceLayout.subdial.height }}px; border-radius: {{ faceLayout.subdial.radius }}px;" @click="openHealth"><div class="mechanical-subdial-ring" style="left: {{ faceLayout.subdialRing.left }}px; top: {{ faceLayout.subdialRing.top }}px; width: {{ faceLayout.subdialRing.width }}px; height: {{ faceLayout.subdialRing.height }}px; border-radius: {{ faceLayout.subdialRing.radius }}px; border-width: {{ faceLayout.subdialRing.borderWidth }}px;"></div><div class="mechanical-subdial-copy" style="width: {{ faceLayout.subdialCopy.width }}px; height: {{ faceLayout.subdialCopy.height }}px;"><text class="mechanical-subdial-label" style="width: {{ faceLayout.subdialLabel.width }}px; height: {{ faceLayout.subdialLabel.height }}px; font-size: {{ faceLayout.subdialLabel.fontSize }}px;">HEART</text><text class="mechanical-subdial-value" style="width: {{ faceLayout.subdialValue.width }}px; height: {{ faceLayout.subdialValue.height }}px; font-size: {{ faceLayout.subdialValue.fontSize }}px;">{{ currentHeartRate }}</text></div></stack>
      <div class="mechanical-hour-hand" style="left: {{ faceLayout.hourHand.left }}px; top: {{ faceLayout.hourHand.top }}px; width: {{ faceLayout.hourHand.width }}px; height: {{ faceLayout.hourHand.height }}px; border-radius: {{ faceLayout.hourHand.radius }}px; transform-origin: {{ faceLayout.hourHand.originX }}px {{ faceLayout.hourHand.originY }}px; transform: {{ hourHandTransform }};"></div><div class="mechanical-minute-hand" style="left: {{ faceLayout.minuteHand.left }}px; top: {{ faceLayout.minuteHand.top }}px; width: {{ faceLayout.minuteHand.width }}px; height: {{ faceLayout.minuteHand.height }}px; border-radius: {{ faceLayout.minuteHand.radius }}px; transform-origin: {{ faceLayout.minuteHand.originX }}px {{ faceLayout.minuteHand.originY }}px; transform: {{ minuteHandTransform }};"></div><div class="mechanical-second-hand" style="left: {{ faceLayout.secondHand.left }}px; top: {{ faceLayout.secondHand.top }}px; width: {{ faceLayout.secondHand.width }}px; height: {{ faceLayout.secondHand.height }}px; transform-origin: {{ faceLayout.secondHand.originX }}px {{ faceLayout.secondHand.originY }}px; transform: {{ secondHandTransform }};"></div><div class="mechanical-center-pin" style="left: {{ faceLayout.centerPin.left }}px; top: {{ faceLayout.centerPin.top }}px; width: {{ faceLayout.centerPin.width }}px; height: {{ faceLayout.centerPin.height }}px; border-radius: {{ faceLayout.centerPin.radius }}px;"></div><div class="mechanical-center-cap" style="left: {{ faceLayout.centerCap.left }}px; top: {{ faceLayout.centerCap.top }}px; width: {{ faceLayout.centerCap.width }}px; height: {{ faceLayout.centerCap.height }}px; border-radius: {{ faceLayout.centerCap.radius }}px;"></div>
    </stack>
  </div>
</template>

<script>
export default {
  props: ['faceLayout','displayMonth','displayDate','batteryPercent','currentHeartRate','analogTicks','hourHandTransform','minuteHandTransform','secondHandTransform'],
  tickGeometry(item) { return item.className === 'mechanical-major-tick' ? this.faceLayout.majorTick : this.faceLayout.minuteTick },
  tickLeft(item) { return this.tickGeometry(item).left },
  tickTop(item) { return this.tickGeometry(item).top },
  tickWidth(item) { return this.tickGeometry(item).width },
  tickHeight(item) { return this.tickGeometry(item).height },
  tickOriginX(item) { return this.tickGeometry(item).originX },
  tickOriginY(item) { return this.tickGeometry(item).originY },
  openHealth() { this.$emit('openHealth') },
  openToday() { this.$emit('openToday') }
}
</script>

<style>
.mechanical-circle-face { position: absolute; background-color: #050607; }
.mechanical-dial { position: absolute; }
.mechanical-bezel { border-color: #B89A61; background-color: #07090B; }
.mechanical-inner-ring { border-color: #55482F; }
.mechanical-minute-tick { background-color: #6E6658; }
.mechanical-major-tick { background-color: #D6B878; }
.mechanical-roman { font-weight: bold; color: #E7D6AF; text-align: center; }
.mechanical-brand { font-weight: bold; color: #E7D6AF; text-align: center; }
.mechanical-caption { color: #81745D; text-align: center; }
.mechanical-power { color: #A6977A; text-align: center; }
.mechanical-date-window { border-color: #66583D; background-color: #111317; flex-direction: column; justify-content: center; align-items: center; }
.mechanical-date-label { color: #8E8065; text-align: center; }
.mechanical-date-value { font-weight: bold; color: #F2E7CC; text-align: center; }
.mechanical-subdial-ring { border-color: #5A4D35; background-color: #090B0E; }
.mechanical-subdial-copy { flex-direction: column; justify-content: center; align-items: center; }
.mechanical-subdial-label { color: #9A8B6E; text-align: center; }
.mechanical-subdial-value { font-weight: bold; color: #D9C18C; text-align: center; }
.mechanical-hour-hand { background-color: #E7D6AF; }
.mechanical-minute-hand { background-color: #D6B878; }
.mechanical-second-hand { background-color: #B64232; }
.mechanical-center-pin { background-color: #D6B878; }
.mechanical-center-cap { background-color: #3A2E1D; }
</style>
