<template>
  <div class="circle-sport-face" style="width: {{ faceLayout.root.width }}px; height: {{ faceLayout.root.height }}px;">
    <stack class="activity-ring" style="width: {{ faceLayout.ring.width }}px; height: {{ faceLayout.ring.height }}px; margin-top: {{ faceLayout.ring.marginTop }}px;"><progress class="activity-arc" type="arc" percent="{{ goalPercent }}" style="width: {{ faceLayout.arc.width }}px; height: {{ faceLayout.arc.height }}px; stroke-width: {{ faceLayout.arc.strokeWidth }}px; start-angle: {{ faceLayout.arc.startAngle }}deg; total-angle: {{ faceLayout.arc.totalAngle }}deg; center-x: {{ faceLayout.arc.centerX }}px; center-y: {{ faceLayout.arc.centerY }}px; radius: {{ faceLayout.arc.radius }}px; color: {{ faceAccent }};"></progress><div class="circle-time-block" style="width: {{ faceLayout.timeBlock.width }}px; height: {{ faceLayout.timeBlock.height }}px;"><div class="vital-time" style="width: {{ faceLayout.vitalTime.width }}px; height: {{ faceLayout.vitalTime.height }}px;"><text class="vital-minute" style="width: {{ faceLayout.minute.width }}px; height: {{ faceLayout.minute.height }}px; font-size: {{ faceLayout.minute.fontSize }}px; margin-left: {{ faceLayout.minute.marginLeft }}px; margin-bottom: {{ faceLayout.minute.marginBottom }}px; color: {{ faceAccent }}">{{ displayMinutes }}</text><text class="vital-hour" style="width: {{ faceLayout.hour.width }}px; height: {{ faceLayout.hour.height }}px; font-size: {{ faceLayout.hour.fontSize }}px; margin-top: {{ faceLayout.hour.marginTop }}px; margin-right: {{ faceLayout.hour.marginRight }}px;">{{ displayHours }}</text></div><text class="circle-date" style="font-size: {{ faceLayout.date.fontSize }}px; margin-top: {{ faceLayout.date.marginTop }}px; color: {{ faceAccent }}">{{ displayMonth }} {{ displayDate }}</text><text class="circle-goal" style="font-size: {{ faceLayout.goal.fontSize }}px; margin-top: {{ faceLayout.goal.marginTop }}px;">目标 {{ goalPercent }}%</text></div></stack>
    <div class="circle-metric-row" style="width: {{ faceLayout.metricRow.width }}px; height: {{ faceLayout.metricRow.height }}px; margin-top: {{ faceLayout.metricRow.marginTop }}px;"><div class="circle-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;" @click="openSteps"><image class="circle-metric-icon" style="width: {{ faceLayout.metricIcon.width }}px; height: {{ faceLayout.metricIcon.height }}px;" src="/common/shoes.png"></image><text class="circle-metric-value step-color" style="width: {{ faceLayout.metricValue.width }}px; font-size: {{ faceLayout.metricValue.fontSize }}px; margin-top: {{ faceLayout.metricValue.marginTop }}px;">{{ stepsText }}</text></div><div class="circle-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;" @click="openHealth"><image class="circle-metric-icon" style="width: {{ faceLayout.metricIcon.width }}px; height: {{ faceLayout.metricIcon.height }}px;" src="/common/heart.png"></image><text class="circle-metric-value heart-color" style="width: {{ faceLayout.metricValue.width }}px; font-size: {{ faceLayout.metricValue.fontSize }}px; margin-top: {{ faceLayout.metricValue.marginTop }}px;">{{ currentHeartRate }}</text></div><div class="circle-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;"><image class="circle-metric-icon" style="width: {{ faceLayout.metricIcon.width }}px; height: {{ faceLayout.metricIcon.height }}px;" src="/common/lightning.png"></image><text class="circle-metric-value" style="width: {{ faceLayout.metricValue.width }}px; font-size: {{ faceLayout.metricValue.fontSize }}px; margin-top: {{ faceLayout.metricValue.marginTop }}px; color: {{ batteryColor }}">{{ batteryPercent }}%</text></div></div>
  </div>
</template>

<script>
export default {
  props: ['faceLayout','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','goalPercent','currentHeartRate','stepsText','batteryPercent','batteryColor'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.circle-sport-face { flex-direction: column; align-items: center; justify-content: flex-start; background-color: #000000; }
.circle-date { font-weight: bold; }
.activity-arc { layer-color: #20242B; }
.circle-time-block { flex-direction: column; align-items: center; justify-content: center; }
.vital-time { flex-direction: column; align-items: center; }
.vital-hour { font-weight: bold; color: #FF9F0A; text-align: center; }
.vital-minute { font-weight: bold; text-align: center; opacity: 0.92; }
.circle-goal { color: #8E8E93; }
.circle-metric-row { flex-direction: row; justify-content: space-between; }
.circle-metric { flex-direction: column; align-items: center; }
.circle-metric-value { font-weight: bold; text-align: center; }
.heart-color { color: #FF375F; } .step-color { color: #FFD60A; }
</style>
