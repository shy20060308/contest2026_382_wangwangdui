<template>
  <div class="circle-simple-face" style="width: {{ faceLayout.root.width }}px; height: {{ faceLayout.root.height }}px;">
    <stack class="simple-circle-dial" style="width: {{ faceLayout.dial.width }}px; height: {{ faceLayout.dial.height }}px; margin-top: {{ faceLayout.dial.marginTop }}px;"><progress class="simple-circle-arc" type="arc" percent="{{ goalPercent }}" style="width: {{ faceLayout.arc.width }}px; height: {{ faceLayout.arc.height }}px; stroke-width: {{ faceLayout.arc.strokeWidth }}px; start-angle: {{ faceLayout.arc.startAngle }}deg; total-angle: {{ faceLayout.arc.totalAngle }}deg; center-x: {{ faceLayout.arc.centerX }}px; center-y: {{ faceLayout.arc.centerY }}px; radius: {{ faceLayout.arc.radius }}px; color: {{ faceAccent }};"></progress><div class="simple-circle-center" style="width: {{ faceLayout.center.width }}px; height: {{ faceLayout.center.height }}px;"><text class="simple-circle-week" style="font-size: {{ faceLayout.week.fontSize }}px; color: {{ faceAccent }}">{{ displayWeek }}</text><text class="simple-circle-time" style="font-size: {{ faceLayout.time.fontSize }}px; margin-top: {{ faceLayout.time.marginTop }}px;">{{ displayHours }}:{{ displayMinutes }}</text><text class="simple-circle-date" style="font-size: {{ faceLayout.date.fontSize }}px; margin-top: {{ faceLayout.date.marginTop }}px;">{{ displayMonth }} {{ displayDate }}</text><text class="simple-circle-label" style="font-size: {{ faceLayout.label.fontSize }}px; margin-top: {{ faceLayout.label.marginTop }}px; color: {{ faceAccent }}">目标 {{ goalPercent }}%</text></div></stack>
    <div class="simple-circle-footer" style="width: {{ faceLayout.footer.width }}px; height: {{ faceLayout.footer.height }}px; margin-top: {{ faceLayout.footer.marginTop }}px;"><div class="simple-circle-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;" @click="openSteps"><image class="simple-circle-icon" style="width: {{ faceLayout.icon.width }}px; height: {{ faceLayout.icon.height }}px;" src="/common/shoes.png"></image><text class="simple-circle-stat step-color" style="width: {{ faceLayout.stat.width }}px; font-size: {{ faceLayout.stat.fontSize }}px; margin-top: {{ faceLayout.stat.marginTop }}px;">{{ stepsText }}</text></div><div class="simple-circle-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;" @click="openHealth"><image class="simple-circle-icon" style="width: {{ faceLayout.icon.width }}px; height: {{ faceLayout.icon.height }}px;" src="/common/heart.png"></image><text class="simple-circle-stat heart-color" style="width: {{ faceLayout.stat.width }}px; font-size: {{ faceLayout.stat.fontSize }}px; margin-top: {{ faceLayout.stat.marginTop }}px;">{{ currentHeartRate }}</text></div><div class="simple-circle-metric" style="width: {{ faceLayout.metric.width }}px; height: {{ faceLayout.metric.height }}px;"><image class="simple-circle-icon" style="width: {{ faceLayout.icon.width }}px; height: {{ faceLayout.icon.height }}px;" src="/common/lightning.png"></image><text class="simple-circle-stat" style="width: {{ faceLayout.stat.width }}px; font-size: {{ faceLayout.stat.fontSize }}px; margin-top: {{ faceLayout.stat.marginTop }}px; color: {{ batteryColor }}">{{ batteryPercent }}%</text></div></div>
  </div>
</template>

<script>
export default {
  props: ['faceLayout','displayWeek','displayMonth','displayDate','displayHours','displayMinutes','faceAccent','goalPercent','stepsText','currentHeartRate','batteryPercent','batteryColor'],
  openHealth() { this.$emit('openHealth') },
  openSteps() { this.$emit('openSteps') }
}
</script>

<style>
.circle-simple-face { flex-direction: column; align-items: center; justify-content: flex-start; background-color: #05060A; }
.simple-circle-week { font-weight: bold; }
.simple-circle-time { color: #FFFFFF; font-weight: bold; }
.simple-circle-date { color: #8E8E93; }
.simple-circle-arc { layer-color: #20242B; }
.simple-circle-center { flex-direction: column; align-items: center; justify-content: center; }
.simple-circle-label { font-weight: bold; }
.simple-circle-footer { flex-direction: row; justify-content: space-between; align-items: center; }
.simple-circle-metric { flex-direction: column; align-items: center; }
.simple-circle-stat { font-weight: bold; text-align: center; }
.heart-color { color: #FF375F; } .step-color { color: #FFD60A; }
</style>
