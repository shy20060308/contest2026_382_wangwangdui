<import name="surfacepreview" src="./surface_preview.ux"></import>

<template>
  <stack class="collection-root" style="left: {{ model.frame.left }}px; top: {{ model.frame.top }}px; width: {{ model.frame.width }}px; height: {{ model.frame.height }}px;" @swipe="onSwipe">
    <stack class="honeycomb" if="{{ model.mode === 'honeycomb' }}" style="width: {{ model.frame.width }}px; height: {{ model.frame.height }}px; background-color: {{ model.tokens.background }};" @touchstart="onHoneyStart" @touchmove="onHoneyMove" @touchend="onHoneyEnd">
      <div class="honey-item" for="{{ honeyVisible }}" tid="slotKey" @click="tapHoney($item)" style="left: {{ $item.left }}px; top: {{ $item.top }}px; width: {{ $item.size }}px; height: {{ $item.size }}px; opacity: {{ $item.opacity }};">
        <image class="honey-icon" src="{{ $item.icon }}" style="width: {{ $item.size }}px; height: {{ $item.size }}px; border-radius: {{ $item.radius }}px;"></image>
      </div>
      <text class="honey-label" style="left: {{ model.tokens.labelLeft }}px; top: {{ model.tokens.labelTop }}px; width: {{ model.tokens.labelWidth }}px; height: {{ model.tokens.labelHeight }}px; line-height: {{ model.tokens.labelHeight }}px; font-size: {{ model.tokens.labelSize }}px; color: {{ model.tokens.labelColor }}; opacity: {{ honeyLabelOpacity }}; text-align: center;">{{ focusedLabel }}</text>
    </stack>

    <div class="preview-swiper" if="{{ model.mode === 'preview-swiper' }}" style="width: {{ model.frame.width }}px; height: {{ model.frame.height }}px;">
      <div class="selector-head" style="left: {{ model.tokens.headerLeft }}px; top: {{ model.tokens.headerTop }}px; width: {{ model.tokens.headerWidth }}px; height: {{ model.tokens.headerHeight }}px;">
        <text class="selector-title" style="font-size: {{ model.tokens.titleSize }}px; color: {{ model.tokens.titleColor }}; font-weight: {{ model.tokens.titleWeight }};">{{ model.tokens.title }}</text>
        <text class="selector-back" style="font-size: {{ model.tokens.backSize }}px; color: {{ model.tokens.backColor }}; text-align: right;" @click="goBack">{{ model.tokens.backText }}</text>
      </div>
      <swiper class="selector-swiper" index="{{ selectorIndex }}" indicator="{{ model.tokens.indicator }}" @change="onSelectorChange" style="left: {{ model.tokens.previewLeft }}px; top: {{ model.tokens.previewTop }}px; width: {{ model.tokens.previewWidth }}px; height: {{ model.tokens.previewHeight }}px;">
        <div class="selector-slide" for="{{ model.items }}" tid="id" @click="activateItem($item)">
          <div class="circle-preview" style="width: {{ model.tokens.previewSize }}px; height: {{ model.tokens.previewSize }}px; border-radius: {{ model.tokens.previewRadius }}px; border-width: {{ model.tokens.previewBorderWidth }}px; background-color: {{ $item.background }}; border-color: {{ $item.accent }};">
            <surfacepreview if="{{ $item.preview }}" model="{{ $item.preview }}"></surfacepreview>
          </div>
        </div>
      </swiper>
      <text class="selector-footer" style="left: {{ model.tokens.footerLeft }}px; top: {{ model.tokens.footerTop }}px; width: {{ model.tokens.footerWidth }}px; height: {{ model.tokens.footerHeight }}px; line-height: {{ model.tokens.footerHeight }}px; font-size: {{ model.tokens.footerSize }}px; color: {{ model.tokens.footerColor }}; text-align: center;">{{ selectorPreviewName }}{{ model.tokens.footerSuffix }}</text>
    </div>

    <div class="cards-pager" if="{{ model.mode === 'cards-pager' }}" style="width: {{ model.frame.width }}px; height: {{ model.frame.height }}px;">
      <div class="selector-head" style="left: {{ model.tokens.headerLeft }}px; top: {{ model.tokens.headerTop }}px; width: {{ model.tokens.headerWidth }}px; height: {{ model.tokens.headerHeight }}px;">
        <text class="selector-title" style="font-size: {{ model.tokens.titleSize }}px; color: {{ model.tokens.titleColor }}; font-weight: {{ model.tokens.titleWeight }};">{{ model.tokens.title }}</text>
        <text class="selector-back" style="font-size: {{ model.tokens.backSize }}px; color: {{ model.tokens.backColor }}; text-align: right;" @click="goBack">{{ model.tokens.backText }}</text>
      </div>
      <div class="selector-card-list" style="left: {{ model.tokens.contentLeft }}px; top: {{ model.tokens.contentTop }}px; width: {{ model.tokens.contentWidth }}px; height: {{ model.tokens.contentHeight }}px;">
        <div class="selector-card" for="{{ pageItems }}" tid="id" @click="activateItem($item)" style="width: {{ model.tokens.contentWidth }}px; height: {{ model.tokens.cardHeight }}px; margin-bottom: {{ model.tokens.cardGap }}px; border-width: {{ model.tokens.cardBorderWidth }}px; border-radius: {{ model.tokens.cardRadius }}px; padding: {{ model.tokens.cardPadding }}px; border-color: {{ $item.borderColor }}; background-color: {{ model.tokens.cardBackground }};">
          <div class="pill-preview" style="width: {{ model.tokens.previewWidth }}px; height: {{ model.tokens.previewHeight }}px; border-width: {{ model.tokens.previewBorderWidth }}px; border-radius: {{ model.tokens.previewRadius }}px; background-color: {{ $item.background }}; border-color: {{ $item.accent }};">
            <surfacepreview if="{{ $item.preview }}" model="{{ $item.preview }}"></surfacepreview>
          </div>
          <div class="selector-card-copy" style="margin-left: {{ model.tokens.copyMarginLeft }}px;">
            <div class="selector-name-row"><text class="selector-card-name" style="font-size: {{ model.tokens.nameSize }}px; color: {{ model.tokens.nameColor }}; font-weight: {{ model.tokens.nameWeight }};">{{ $item.label }}</text><text class="selector-badge" if="{{ $item.selected }}" style="height: {{ model.tokens.badgeHeight }}px; border-radius: {{ model.tokens.badgeRadius }}px; padding-left: {{ model.tokens.badgePaddingX }}px; padding-right: {{ model.tokens.badgePaddingX }}px; font-size: {{ model.tokens.badgeSize }}px; color: {{ model.tokens.badgeTextColor }}; background-color: {{ $item.accent }};">{{ model.tokens.selectedBadgeText }}</text></div>
            <text class="selector-description" style="font-size: {{ model.tokens.descriptionSize }}px; line-height: {{ model.tokens.descriptionLineHeight }}px; margin-top: {{ model.tokens.descriptionMarginTop }}px; color: {{ model.tokens.descriptionColor }};">{{ $item.description }}</text>
            <text class="selector-tag" style="font-size: {{ model.tokens.tagSize }}px; margin-top: {{ model.tokens.tagMarginTop }}px; color: {{ $item.accent }};">{{ $item.tag }}</text>
          </div>
        </div>
      </div>
      <div class="selector-pager" style="left: {{ model.tokens.pagerLeft }}px; top: {{ model.tokens.pagerTop }}px; width: {{ model.tokens.pagerWidth }}px; height: {{ model.tokens.pagerHeight }}px;">
        <text class="selector-pager-button" style="width: {{ model.tokens.pagerButtonWidth }}px; font-size: {{ model.tokens.pagerButtonSize }}px; color: {{ model.tokens.pagerButtonColor }}; text-align: center;" @click="previousPage">{{ model.tokens.pagerPreviousText }}</text>
        <text class="selector-pager-text" style="font-size: {{ model.tokens.pagerTextSize }}px; color: {{ model.tokens.pagerTextColor }}; text-align: center;">{{ pageText }}</text>
        <text class="selector-pager-button" style="width: {{ model.tokens.pagerButtonWidth }}px; font-size: {{ model.tokens.pagerButtonSize }}px; color: {{ model.tokens.pagerButtonColor }}; text-align: center;" @click="nextPage">{{ model.tokens.pagerNextText }}</text>
      </div>
    </div>

    <div class="preview-grid" if="{{ model.mode === 'preview-grid' }}" style="width: {{ model.frame.width }}px; height: {{ model.frame.height }}px;">
      <div class="selector-head" style="left: {{ model.tokens.headerLeft }}px; top: {{ model.tokens.headerTop }}px; width: {{ model.tokens.headerWidth }}px; height: {{ model.tokens.headerHeight }}px;">
        <text class="selector-title" style="font-size: {{ model.tokens.titleSize }}px; color: {{ model.tokens.titleColor }}; font-weight: {{ model.tokens.titleWeight }};">{{ model.tokens.title }}</text>
        <text class="selector-back" style="font-size: {{ model.tokens.backSize }}px; color: {{ model.tokens.backColor }}; text-align: right;" @click="goBack">{{ model.tokens.backText }}</text>
      </div>
      <div class="selector-grid" style="left: {{ model.tokens.contentLeft }}px; top: {{ model.tokens.contentTop }}px; width: {{ model.tokens.contentWidth }}px; height: {{ model.tokens.contentHeight }}px;">
        <div class="selector-grid-card" for="{{ gridItems }}" tid="id" @click="activateItem($item)" style="left: {{ $item.left }}px; top: {{ $item.top }}px; width: {{ model.tokens.gridItemWidth }}px; height: {{ model.tokens.cardHeight }}px; border-width: {{ model.tokens.cardBorderWidth }}px; border-radius: {{ model.tokens.cardRadius }}px; padding: {{ model.tokens.cardPadding }}px; border-color: {{ $item.borderColor }}; background-color: {{ model.tokens.cardBackground }};">
          <div class="rect-preview" style="width: 100%; height: {{ model.tokens.previewHeight }}px; border-radius: {{ model.tokens.previewRadius }}px; background-color: {{ $item.background }};">
            <surfacepreview if="{{ $item.preview }}" model="{{ $item.preview }}"></surfacepreview>
          </div>
          <text class="rect-preview-name" style="font-size: {{ model.tokens.nameSize }}px; margin-top: {{ model.tokens.nameMarginTop }}px; color: {{ model.tokens.nameColor }}; font-weight: {{ model.tokens.nameWeight }};">{{ $item.label }}</text>
          <text class="rect-selected" if="{{ $item.selected }}" style="font-size: {{ model.tokens.selectedSize }}px; margin-top: {{ model.tokens.selectedMarginTop }}px; color: {{ $item.accent }};">{{ model.tokens.selectedText }}</text>
        </div>
        <div class="selector-current" if="{{ selectedItem }}" style="left: {{ model.tokens.currentLeft }}px; top: {{ model.tokens.currentTop }}px; width: {{ model.tokens.currentWidth }}px; height: {{ model.tokens.currentHeight }}px; border-radius: {{ model.tokens.cardRadius }}px; padding: {{ model.tokens.cardPadding }}px; background-color: {{ model.tokens.cardBackground }};">
          <text class="current-label" style="font-size: {{ model.tokens.currentLabelSize }}px; letter-spacing: {{ model.tokens.currentLetterSpacing }}px; color: {{ model.tokens.currentLabelColor }};">{{ model.tokens.currentLabel }}</text>
          <text class="current-name" style="font-size: {{ model.tokens.currentNameSize }}px; margin-top: {{ model.tokens.currentNameMarginTop }}px; color: {{ selectedItem.accent }}; font-weight: {{ model.tokens.currentNameWeight }};">{{ selectedItem.label }}</text>
          <div class="current-line" style="width: {{ model.tokens.currentLineWidth }}px; height: {{ model.tokens.currentLineHeight }}px; margin-top: {{ model.tokens.currentLineMarginTop }}px; border-radius: {{ model.tokens.currentLineRadius }}px; background-color: {{ selectedItem.accent }};"></div>
          <text class="current-hint" style="font-size: {{ model.tokens.currentHintSize }}px; margin-top: {{ model.tokens.currentHintMarginTop }}px; color: {{ model.tokens.currentHintColor }};">{{ model.tokens.currentHint }}</text>
        </div>
      </div>
    </div>

    <div class="segmented" if="{{ model.mode === 'segmented' }}" style="width: {{ model.frame.width }}px; height: {{ model.frame.height }}px;">
      <text class="segment-item" for="{{ segmentItems }}" tid="id" @click="activateItem($item)" style="left: {{ $item.left }}px; top: {{ $item.top }}px; width: {{ $item.width }}px; height: {{ $item.height }}px; line-height: {{ $item.height }}px; border-width: {{ model.tokens.itemBorderWidth }}px; border-radius: {{ model.tokens.itemRadius }}px; border-color: {{ $item.borderColor }}; background-color: {{ $item.background }}; font-size: {{ model.tokens.fontSize }}px; color: {{ $item.color }}; font-weight: {{ model.tokens.fontWeight }}; text-align: center;">{{ $item.label }}</text>
    </div>

    <div class="paged-list" if="{{ model.mode === 'paged-list' }}" style="width: {{ model.frame.width }}px; height: {{ model.frame.height }}px;">
      <div class="collection-head" style="left: {{ model.tokens.headerLeft }}px; top: {{ model.tokens.headerTop }}px; width: {{ model.tokens.headerWidth }}px; height: {{ model.tokens.headerHeight }}px;">
        <text class="collection-title" style="font-size: {{ model.tokens.titleSize }}px; color: {{ model.tokens.titleColor }}; font-weight: {{ model.tokens.titleWeight }};">{{ model.tokens.title }}</text>
        <text class="collection-page" style="font-size: {{ model.tokens.pageSize }}px; color: {{ model.tokens.pageColor }};">{{ pageText }}</text>
      </div>
      <div class="list-content" style="left: {{ model.tokens.contentLeft }}px; top: {{ model.tokens.contentTop }}px; width: {{ model.tokens.contentWidth }}px; height: {{ model.tokens.contentHeight }}px;">
        <div class="list-item" for="{{ pageItems }}" tid="id" @click="activateItem($item)" style="width: {{ model.tokens.contentWidth }}px; height: {{ model.tokens.itemHeight }}px; margin-bottom: {{ model.tokens.itemGap }}px; border-radius: {{ model.tokens.itemRadius }}px; padding-left: {{ model.tokens.itemPaddingX }}px; padding-right: {{ model.tokens.itemPaddingX }}px; background-color: {{ model.tokens.itemBackground }};">
          <image class="list-icon" src="{{ $item.icon }}" style="width: {{ model.tokens.iconSize }}px; height: {{ model.tokens.iconSize }}px; border-radius: {{ model.tokens.iconRadius }}px;"></image>
          <div class="list-copy" style="margin-left: {{ model.tokens.copyGap }}px;"><text class="list-name" style="font-size: {{ model.tokens.nameSize }}px; color: {{ model.tokens.nameColor }}; font-weight: {{ model.tokens.nameWeight }};">{{ $item.label }}</text><text class="list-subtitle" style="font-size: {{ model.tokens.subtitleSize }}px; color: {{ model.tokens.subtitleColor }};">{{ $item.subtitle }}</text></div>
          <text class="list-arrow" style="width: {{ model.tokens.arrowWidth }}px; font-size: {{ model.tokens.arrowSize }}px; color: {{ $item.accent }}; text-align: right;">{{ model.tokens.arrowText }}</text>
        </div>
      </div>
      <div class="pager" style="left: {{ model.tokens.pagerLeft }}px; top: {{ model.tokens.pagerTop }}px; width: {{ model.tokens.pagerWidth }}px; height: {{ model.tokens.pagerHeight }}px;">
        <text class="pager-button" style="width: {{ model.tokens.pagerButtonWidth }}px; font-size: {{ model.tokens.pagerButtonSize }}px; color: {{ previousColor }};" @click="previousPage">{{ model.tokens.pagerPreviousText }}</text>
        <div class="pager-track" style="width: {{ model.tokens.pagerTrackWidth }}px; height: {{ model.tokens.pagerTrackHeight }}px; border-radius: {{ model.tokens.pagerTrackRadius }}px; background-color: {{ model.tokens.pagerTrackBackground }};"><div class="pager-fill" style="width: {{ pageProgressWidth }}px; height: {{ model.tokens.pagerTrackHeight }}px; border-radius: {{ model.tokens.pagerTrackRadius }}px; background-color: {{ model.tokens.pagerAccent }};"></div></div>
        <text class="pager-button" style="width: {{ model.tokens.pagerButtonWidth }}px; font-size: {{ model.tokens.pagerButtonSize }}px; color: {{ nextColor }}; text-align: right;" @click="nextPage">{{ model.tokens.pagerNextText }}</text>
      </div>
    </div>

    <div class="designed-grid" if="{{ model.mode === 'designed-grid' }}" style="width: {{ model.frame.width }}px; height: {{ model.frame.height }}px;">
      <div class="collection-head" style="left: {{ model.tokens.headerLeft }}px; top: {{ model.tokens.headerTop }}px; width: {{ model.tokens.headerWidth }}px; height: {{ model.tokens.headerHeight }}px;">
        <text class="collection-title" style="font-size: {{ model.tokens.titleSize }}px; color: {{ model.tokens.titleColor }}; font-weight: {{ model.tokens.titleWeight }};">{{ model.tokens.title }}</text>
        <text class="collection-page" style="font-size: {{ model.tokens.pageSize }}px; color: {{ model.tokens.pageColor }};">{{ pageText }}</text>
      </div>
      <div class="grid-content" style="left: {{ model.tokens.contentLeft }}px; top: {{ model.tokens.contentTop }}px; width: {{ model.tokens.contentWidth }}px; height: {{ model.tokens.contentHeight }}px;">
        <div class="grid-item" for="{{ gridItems }}" tid="id" @click="activateItem($item)" style="left: {{ $item.left }}px; top: {{ $item.top }}px; width: {{ model.tokens.gridItemWidth }}px; height: {{ model.tokens.itemHeight }}px; border-radius: {{ model.tokens.itemRadius }}px; border-width: {{ model.tokens.itemBorderWidth }}px; border-color: {{ $item.accent }}; background-color: {{ model.tokens.itemBackground }};">
          <image class="grid-icon" src="{{ $item.icon }}" style="width: {{ model.tokens.iconSize }}px; height: {{ model.tokens.iconSize }}px; border-radius: {{ model.tokens.iconRadius }}px;"></image>
          <text class="grid-name" style="font-size: {{ model.tokens.nameSize }}px; color: {{ model.tokens.nameColor }}; font-weight: {{ model.tokens.nameWeight }}; text-align: center;">{{ $item.label }}</text>
          <div class="grid-accent" style="width: {{ model.tokens.accentWidth }}px; height: {{ model.tokens.accentHeight }}px; bottom: {{ model.tokens.accentBottom }}px; border-radius: {{ model.tokens.accentRadius }}px; background-color: {{ $item.accent }};"></div>
        </div>
      </div>
      <div class="pager" style="left: {{ model.tokens.pagerLeft }}px; top: {{ model.tokens.pagerTop }}px; width: {{ model.tokens.pagerWidth }}px; height: {{ model.tokens.pagerHeight }}px;">
        <text class="pager-button" style="width: {{ model.tokens.pagerButtonWidth }}px; font-size: {{ model.tokens.pagerButtonSize }}px; color: {{ previousColor }};" @click="previousPage">{{ model.tokens.pagerPreviousText }}</text>
        <div class="pager-track" style="width: {{ model.tokens.pagerTrackWidth }}px; height: {{ model.tokens.pagerTrackHeight }}px; border-radius: {{ model.tokens.pagerTrackRadius }}px; background-color: {{ model.tokens.pagerTrackBackground }};"><div class="pager-fill" style="width: {{ pageProgressWidth }}px; height: {{ model.tokens.pagerTrackHeight }}px; border-radius: {{ model.tokens.pagerTrackRadius }}px; background-color: {{ model.tokens.pagerAccent }};"></div></div>
        <text class="pager-button" style="width: {{ model.tokens.pagerButtonWidth }}px; font-size: {{ model.tokens.pagerButtonSize }}px; color: {{ nextColor }}; text-align: right;" @click="nextPage">{{ model.tokens.pagerNextText }}</text>
      </div>
    </div>
  </stack>
</template>

<script>
import honeycomb from '../product/frontend/engines/honeycomb'

export default {
  props: ['model'],
  private: {
    pageIndex: 0, pageItems: [], gridItems: [], segmentItems: [], pageText: '', pageProgressWidth: 0,
    previousColor: '', nextColor: '', honeySlots: [], honeyVisible: [], focusedLabel: '',
    selectorIndex: 0, selectorPreviewName: '', selectedItem: null,
    honeyPanX: 0, honeyPanY: 0, honeyVelocityX: 0, honeyVelocityY: 0, honeyTouchActive: false,
    honeyLabelOpacity: 1, dragMoved: false, suppressTapUntil: 0, layoutTimer: null, motionTimer: null
  },
  onInit() {
    this.$watch('model.selectedId', 'onModelSelectionChanged')
    this.$watch('model.selectedIndex', 'onModelSelectionChanged')
    this.$watch('model.items', 'onModelItemsChanged')
    this.$watch('model.active', 'onActiveChanged')
    this.refreshModel()
  },
  onDestroy() { this.stopHoneyMotion(); this.honeySlots = []; this.honeyVisible = []; this.pageItems = []; this.gridItems = []; this.segmentItems = [] },
  onModelSelectionChanged() { this.refreshModel() },
  onModelItemsChanged() { this.refreshModel() },
  onActiveChanged(active) {
    if (active !== false) return
    this.stopHoneyMotion()
    this.honeyTouchActive = false
    this.dragMoved = false
    this.honeyLabelOpacity = 1
  },
  tokenNumber(name) {
    var value = Number(this.model && this.model.tokens ? this.model.tokens[name] : undefined)
    if (!isFinite(value)) throw new Error('Collection requires numeric token ' + name)
    return value
  },
  syncSelection() {
    var index = Number(this.model.selectedIndex)
    if (!isFinite(index) || index < 0 || index >= this.model.items.length) index = 0
    this.selectorIndex = index
    this.selectedItem = this.model.selectedItem || (this.model.items.length ? this.model.items[index] : null)
    this.selectorPreviewName = this.model.items[index] ? this.model.items[index].label : ''
    if (this.model.mode === 'cards-pager') {
      var size = Math.max(1, Math.round(this.tokenNumber('pageItemCount')))
      this.pageIndex = Math.floor(index / size)
    }
  },
  refreshModel() {
    if (!this.model) return
    this.syncSelection()
    if (this.model.mode === 'segmented') { this.buildSegmented(); return }
    if (this.model.mode === 'honeycomb') { this.initHoneycomb(); return }
    if (this.model.mode === 'preview-swiper') return
    if (this.model.mode === 'preview-grid') { this.pageItems = this.model.items.slice(); this.buildGrid(); return }
    this.refreshPage()
  },
  buildSegmented() {
    var count = Math.max(1, this.model.items.length)
    var inset = this.tokenNumber('contentInset')
    var gap = this.tokenNumber('gap')
    var itemHeight = this.tokenNumber('itemHeight')
    var top = this.tokenNumber('contentTop')
    var usable = this.model.frame.width - inset * 2 - gap * (count - 1)
    var width = Math.floor(usable / count)
    var items = []
    for (var i = 0; i < this.model.items.length; i++) {
      var item = this.model.items[i]
      var copy = {}; for (var key in item) copy[key] = item[key]
      copy.left = inset + i * (width + gap)
      copy.top = top
      copy.width = width
      copy.height = itemHeight
      copy.background = item.selected ? this.model.tokens.selectedBackground : this.model.tokens.itemBackground
      copy.color = item.selected ? this.model.tokens.selectedColor : this.model.tokens.itemColor
      copy.borderColor = item.selected ? this.model.tokens.selectedBorderColor : this.model.tokens.itemBorderColor
      items.push(copy)
    }
    this.segmentItems = items
  },
  pageCount() { var size = Math.max(1, Math.round(this.tokenNumber('pageItemCount'))); return Math.max(1, Math.ceil(this.model.items.length / size)) },
  buildGrid() {
    var columns = Math.max(1, Math.round(this.tokenNumber('columns')))
    var gap = this.tokenNumber('gridGap')
    var width = this.tokenNumber('gridItemWidth')
    var itemHeight = this.model.mode === 'preview-grid' ? this.tokenNumber('cardHeight') : this.tokenNumber('itemHeight')
    var rowHeight = itemHeight + this.tokenNumber('gridRowGap')
    var grid = []
    for (var i = 0; i < this.pageItems.length; i++) {
      var item = this.pageItems[i]
      var copy = {}; for (var key in item) copy[key] = item[key]
      copy.left = (i % columns) * (width + gap)
      copy.top = Math.floor(i / columns) * rowHeight
      grid.push(copy)
    }
    this.gridItems = grid
  },
  refreshPage() {
    var size = Math.max(1, Math.round(this.tokenNumber('pageItemCount')))
    var count = this.pageCount()
    if (this.pageIndex >= count) this.pageIndex = count - 1
    if (this.pageIndex < 0) this.pageIndex = 0
    this.pageItems = this.model.items.slice(this.pageIndex * size, this.pageIndex * size + size)
    this.pageText = (this.pageIndex + 1) + ' / ' + count
    if (this.model.mode === 'paged-list' || this.model.mode === 'designed-grid') {
      var trackWidth = this.tokenNumber('pagerTrackWidth')
      var minimum = this.tokenNumber('pagerMinProgressWidth')
      this.pageProgressWidth = Math.max(minimum, Math.round(trackWidth * (this.pageIndex + 1) / count))
      this.previousColor = this.pageIndex > 0 ? this.model.tokens.pagerAccent : this.model.tokens.pagerDisabledColor
      this.nextColor = this.pageIndex < count - 1 ? this.model.tokens.pagerAccent : this.model.tokens.pagerDisabledColor
    }
    if (this.model.mode === 'designed-grid') this.buildGrid()
    else this.gridItems = []
  },
  previousPage() { if (this.pageIndex <= 0) return; this.pageIndex -= 1; this.refreshPage() },
  nextPage() { if (this.pageIndex >= this.pageCount() - 1) return; this.pageIndex += 1; this.refreshPage() },
  onSwipe(event) {
    if (!event || this.model.active === false || this.model.mode === 'honeycomb' || this.model.mode === 'segmented' || this.model.mode === 'preview-swiper' || this.model.mode === 'preview-grid') return
    var direction = event.direction || (event.detail && event.detail.direction) || ''
    if (direction === 'left') this.nextPage()
    else if (direction === 'right') {
      if (this.pageIndex > 0) this.previousPage()
      else if (this.model.actions && this.model.actions.edgeBack) this.emitAction(this.model.actions.edgeBack)
    }
  },
  onSelectorChange(event) {
    if (this.model.active === false) return
    var index = event && (event.index !== undefined ? event.index : event.detail && event.detail.index)
    if (index === undefined || index === null || !this.model.items[index]) return
    this.selectorIndex = index
    this.selectorPreviewName = this.model.items[index].label
  },
  goBack() { if (this.model.active !== false && this.model.actions && this.model.actions.back) this.emitAction(this.model.actions.back) },
  activateItem(item) { if (this.model.active !== false && item && item.action) this.emitAction(item.action) },
  emitAction(action) { this.$emit('surfaceaction', { action: action }) },
  honeyConfig() { return honeycomb.config(this.model.tokens || {}, this.model.frame.width, this.model.frame.height) },
  initHoneycomb() {
    var cfg = this.honeyConfig()
    this.honeySlots = honeycomb.buildSlots(this.model.items, cfg)
    var first = this.honeySlots.length ? honeycomb.panForSlot(this.honeySlots[0], cfg) : null
    this.honeyPanX = first ? first.x : 0
    this.honeyPanY = first ? first.y : 0
    this.renderHoneycomb()
  },
  renderHoneycomb() {
    var cfg = this.honeyConfig()
    var frame = honeycomb.layoutSlots(this.honeySlots, this.honeyPanX, this.honeyPanY, cfg)
    this.honeyVisible = honeycomb.visibleSlots(frame.slots, cfg)
    if (frame.nearestIndex >= 0 && this.honeySlots[frame.nearestIndex]) this.focusedLabel = this.honeySlots[frame.nearestIndex].label
  },
  scheduleHoneyLayout() {
    if (this.model.active === false || this.layoutTimer) return
    var self = this, cfg = this.honeyConfig()
    this.layoutTimer = setTimeout(function () {
      self.layoutTimer = null
      if (self.model.active !== false) self.renderHoneycomb()
    }, cfg.frameMs)
  },
  stopHoneyMotion() {
    clearTimeout(this.layoutTimer); clearTimeout(this.motionTimer)
    this.layoutTimer = null; this.motionTimer = null; this.honeyVelocityX = 0; this.honeyVelocityY = 0
  },
  onHoneyStart(event) {
    if (this.model.active === false || !event.touches || !event.touches[0]) return
    this.stopHoneyMotion()
    var p = event.touches[0]
    this.touchStartX = p.pageX; this.touchStartY = p.pageY; this.touchLastX = p.pageX; this.touchLastY = p.pageY; this.touchLastAt = Date.now()
    this.honeyTouchActive = true; this.dragMoved = false; this.honeyLabelOpacity = 0
  },
  onHoneyMove(event) {
    if (this.model.active === false || !this.honeyTouchActive || !event.touches || !event.touches[0]) return
    var p = event.touches[0], now = Date.now(), cfg = this.honeyConfig()
    var dx = p.pageX - this.touchLastX, dy = p.pageY - this.touchLastY, dt = Math.max(8, now - (this.touchLastAt || now))
    this.touchLastX = p.pageX; this.touchLastY = p.pageY; this.touchLastAt = now
    var dragThreshold = this.tokenNumber('dragThreshold')
    if (Math.abs(p.pageX - this.touchStartX) > dragThreshold || Math.abs(p.pageY - this.touchStartY) > dragThreshold) this.dragMoved = true
    if (this.dragMoved) { if (event.preventDefault) event.preventDefault(); if (event.stopPropagation) event.stopPropagation() }
    var pan = honeycomb.nextPan(this.honeySlots, this.honeyPanX, this.honeyPanY, dx, dy, cfg)
    this.honeyPanX = pan.x; this.honeyPanY = pan.y
    var previousWeight = this.tokenNumber('velocityPreviousWeight')
    var sampleWeight = this.tokenNumber('velocitySampleWeight')
    this.honeyVelocityX = this.honeyVelocityX * previousWeight + (dx / dt) * sampleWeight
    this.honeyVelocityY = this.honeyVelocityY * previousWeight + (dy / dt) * sampleWeight
    this.scheduleHoneyLayout()
  },
  onHoneyEnd(event) {
    if (this.model.active === false || !this.honeyTouchActive) return
    this.honeyTouchActive = false
    var p = event.changedTouches && event.changedTouches[0]
    var totalX = p ? p.pageX - this.touchStartX : 0, totalY = p ? p.pageY - this.touchStartY : 0
    var edgeDistance = this.tokenNumber('edgeBackDistance')
    var edgeStart = this.tokenNumber('edgeBackStart')
    var verticalLimit = this.tokenNumber('edgeBackVerticalLimit')
    if (totalX > edgeDistance && Math.abs(totalY) < verticalLimit && this.touchStartX < edgeStart && this.model.actions && this.model.actions.edgeBack) {
      if (event.preventDefault) event.preventDefault(); if (event.stopPropagation) event.stopPropagation()
      this.stopHoneyMotion(); this.emitAction(this.model.actions.edgeBack); return
    }
    if (!this.dragMoved) { this.honeyLabelOpacity = 1; this.scheduleHoneyLayout(); return }
    if (event.preventDefault) event.preventDefault(); if (event.stopPropagation) event.stopPropagation()
    this.suppressTapUntil = Date.now() + this.tokenNumber('tapSuppressDuration')
    this.startHoneyInertia(this.honeyVelocityX, this.honeyVelocityY)
  },
  startHoneyInertia(vx, vy) {
    if (this.model.active === false) return
    clearTimeout(this.motionTimer)
    this.honeyVelocityX = Number(vx) || 0; this.honeyVelocityY = Number(vy) || 0; this.honeyLabelOpacity = this.tokenNumber('movingLabelOpacity')
    var self = this, cfg = this.honeyConfig()
    function tick() {
      if (self.model.active === false) { self.stopHoneyMotion(); return }
      var speed = Math.sqrt(self.honeyVelocityX * self.honeyVelocityX + self.honeyVelocityY * self.honeyVelocityY)
      if (speed < cfg.minVelocity) { self.motionTimer = null; self.settleHoneycomb(); return }
      var pan = honeycomb.nextPan(self.honeySlots, self.honeyPanX, self.honeyPanY, self.honeyVelocityX * cfg.frameMs, self.honeyVelocityY * cfg.frameMs, cfg)
      self.honeyPanX = pan.x; self.honeyPanY = pan.y
      self.honeyVelocityX *= cfg.inertiaDecay; self.honeyVelocityY *= cfg.inertiaDecay
      self.renderHoneycomb(); self.motionTimer = setTimeout(tick, cfg.frameMs)
    }
    tick()
  },
  settleHoneycomb() {
    if (this.model.active === false) return
    var cfg = this.honeyConfig()
    var strict = honeycomb.clampPan(this.honeySlots, this.honeyPanX, this.honeyPanY, 0, cfg)
    var frame = honeycomb.layoutSlots(this.honeySlots, strict.x, strict.y, cfg)
    var target = strict
    if (frame.nearestIndex >= 0 && frame.nearestDistance <= cfg.magnetDistance) target = honeycomb.panForSlot(this.honeySlots[frame.nearestIndex], cfg) || strict
    target = honeycomb.clampPan(this.honeySlots, target.x, target.y, 0, cfg)
    this.animateHoneyPan(target)
  },
  animateHoneyPan(target) {
    if (this.model.active === false) return
    clearTimeout(this.motionTimer)
    var startX = this.honeyPanX, startY = this.honeyPanY, startedAt = Date.now(), duration = this.tokenNumber('snapDuration')
    var self = this, cfg = this.honeyConfig()
    function tick() {
      if (self.model.active === false) { self.stopHoneyMotion(); return }
      var progress = Math.min(1, (Date.now() - startedAt) / duration), eased = 1 - Math.pow(1 - progress, 3)
      self.honeyPanX = startX + (target.x - startX) * eased; self.honeyPanY = startY + (target.y - startY) * eased; self.renderHoneycomb()
      if (progress >= 1) { self.motionTimer = null; self.honeyLabelOpacity = 1; return }
      self.motionTimer = setTimeout(tick, cfg.frameMs)
    }
    tick()
  },
  tapHoney(item) { if (!item || this.model.active === false || Date.now() < this.suppressTapUntil) return; this.stopHoneyMotion(); this.activateItem(item) }
}
</script>

<style>
.collection-root, .honeycomb, .honey-item, .honey-label, .preview-swiper, .cards-pager, .preview-grid, .selector-head, .selector-swiper, .selector-footer, .selector-card-list, .selector-pager, .selector-grid, .selector-grid-card, .selector-current, .segmented, .segment-item, .paged-list, .designed-grid, .collection-head, .list-content, .grid-content, .grid-item, .pager { position: absolute; }
.selector-head, .selector-name-row, .selector-pager, .collection-head, .pager { flex-direction: row; align-items: center; justify-content: space-between; }
.selector-title, .collection-title { flex: 1; }
.selector-slide, .circle-preview, .pill-preview, .rect-preview { justify-content: center; align-items: center; }
.circle-preview, .pill-preview, .rect-preview, .selector-card-copy, .selector-current { flex-direction: column; }
.selector-card-list, .list-content { flex-direction: column; }
.selector-card { flex-direction: row; align-items: center; }
.selector-card-copy { flex: 1; }
.selector-grid-card { flex-direction: column; }
.list-item { flex-direction: row; align-items: center; }
.list-copy { flex: 1; flex-direction: column; }
.grid-item { align-items: center; justify-content: center; flex-direction: column; }
.grid-accent { position: absolute; }
.pager-track { overflow: hidden; flex-direction: row; align-items: center; }
</style>