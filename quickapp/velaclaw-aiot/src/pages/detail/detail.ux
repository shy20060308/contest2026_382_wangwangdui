<template>
  <div class="demo-page {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;">
    <text class="title" style="{{ titleStyle }}">{{ text }}</text>
  </div>
</template>

<script>
import pageMotion from '../../common/page_motion'
import layoutRuntime from '../../presentation/layout/runtime'

var DETAIL_LAYOUT = {
  id: 'detail-l1-auto',
  default: {
    mode: 'auto-stack',
    verticalAlign: 'center',
    minScale: 0.78,
    regions: [
      { id: 'title', width: 148, height: 32 }
    ]
  }
}

export default {
  private: {
    text: '欢迎打开详情页',
    titleStyle: '',
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px'
  },

  onInit() {
    var self = this
    layoutRuntime.bind(this, DETAIL_LAYOUT, function (plan) {
      var title = plan && plan.regions && plan.regions[0]
      var fontSize = Math.max(15, Math.round(20 * (plan ? plan.scale : 1)))
      self.titleStyle = layoutRuntime.regionStyle(title) + 'font-size: ' + fontSize + 'px; text-align: center;'
    })
  },

  onShow() {
    pageMotion.enter(this)
  },

  onHide() {
    pageMotion.clear(this)
  },

  onDestroy() {
    pageMotion.clear(this)
  }
}
</script>

<style>
.demo-page {
  background-color: #000000;
}

.title {
  color: #FFFFFF;
  text-align: center;
}
</style>
