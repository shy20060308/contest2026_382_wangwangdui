<template>
  <div class="select-page {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <div class="pill-surface" if="{{ profileReady && isPillSurface }}">
      <div class="pill-top-row">
        <text class="pill-title">{{ surfaceTitle }}</text>
        <text class="pill-back" @click="goBack">返回</text>
      </div>

      <div class="face-card" if="{{ pillPageIndex === 0 }}" style="border-color: {{ sportBorder }}" @click="selectSport">
        <div class="preview-panel sport-preview">
          <text class="preview-date">06/01</text>
          <text class="preview-big sport-time">08</text>
          <text class="preview-small">4,567 步</text>
        </div>
        <div class="face-copy">
          <div class="face-name-row">
            <text class="face-name">活力数字</text>
            <text class="face-badge" if="{{ sportSelected }}">已选</text>
          </div>
          <text class="face-desc">时间、心率、步数集中展示</text>
          <text class="face-tag">运动日常</text>
        </div>
      </div>

      <div class="face-card" if="{{ pillPageIndex === 0 }}" style="border-color: {{ simpleBorder }}" @click="selectSimple">
        <div class="preview-panel simple-preview">
          <text class="simple-preview-time">08:32</text>
          <stack class="mini-ring">
            <progress class="mini-arc" type="arc" percent="68"></progress>
            <div class="mini-ring-center"><text class="mini-ring-text">68%</text></div>
          </stack>
        </div>
        <div class="face-copy">
          <div class="face-name-row">
            <text class="face-name">极简霓虹</text>
            <text class="face-badge cyan-badge" if="{{ simpleSelected }}">已选</text>
          </div>
          <text class="face-desc">大时间和目标完成度</text>
          <text class="face-tag">简洁耐看</text>
        </div>
      </div>

      <div class="face-card" if="{{ pillPageIndex === 1 }}" style="border-color: {{ dashboardBorder }}" @click="selectDashboard">
        <div class="preview-panel dash-preview">
          <text class="dash-preview-time">08:32</text>
          <div class="mini-bars">
            <div class="mini-bar bar-one"></div>
            <div class="mini-bar bar-two"></div>
            <div class="mini-bar bar-three"></div>
          </div>
          <text class="preview-small">心率 88</text>
        </div>
        <div class="face-copy">
          <div class="face-name-row">
            <text class="face-name">运动仪表</text>
            <text class="face-badge green-badge" if="{{ dashboardSelected }}">已选</text>
          </div>
          <text class="face-desc">进度条和心率趋势图</text>
          <text class="face-tag">数据控</text>
        </div>
      </div>

      <div class="face-card" if="{{ pillPageIndex === 1 }}" style="border-color: {{ alpineBorder }}" @click="selectAlpine">
        <stack class="preview-panel alpine-preview">
          <image class="alpine-preview-background" src="/common/watchfaces/alpine_night.jpg"></image>
          <div class="alpine-preview-veil"></div>
          <text class="alpine-preview-hour">08</text>
          <text class="alpine-preview-minute">32</text>
          <text class="alpine-preview-label">ALPINE</text>
        </stack>
        <div class="face-copy">
          <div class="face-name-row">
            <text class="face-name">星野远山</text>
            <text class="face-badge orange-badge" if="{{ alpineSelected }}">已选</text>
          </div>
          <text class="face-desc">星空雪山和透明数据层</text>
          <text class="face-tag">沉浸夜景</text>
        </div>
      </div>

      <div class="pill-face-pager">
        <text class="pill-page-button" @click="previousPillPage">‹</text>
        <text class="pill-page-number">{{ pillPageText }}</text>
        <text class="pill-page-button" @click="nextPillPage">›</text>
      </div>
      <text class="pill-hint">{{ surfaceHint }}</text>
    </div>

    <div class="circle-surface" if="{{ profileReady && isCircleSurface }}">
      <div class="circle-select-header">
        <text class="circle-select-title">{{ surfaceTitle }}</text>
        <text class="circle-back" @click="goBack">返回</text>
      </div>
      <swiper class="circle-face-swiper" index="{{ circlePreviewIndex }}" indicator="true" @change="onCircleFaceChange">
        <div class="circle-preview-slide" @click="selectSport">
          <stack class="circle-preview sport-preview-circle">
            <progress class="circle-preview-arc sport-circle-arc" type="arc" percent="72"></progress>
            <div class="circle-preview-center">
              <div class="circle-preview-vital">
                <text class="circle-preview-minute">32</text>
                <text class="circle-preview-hour">08</text>
              </div>
              <text class="circle-preview-sub">4,567 步</text>
            </div>
          </stack>
        </div>
        <div class="circle-preview-slide" @click="selectSimple">
          <stack class="circle-preview simple-preview-circle">
            <progress class="circle-preview-arc simple-circle-arc" type="arc" percent="68"></progress>
            <div class="circle-preview-center">
              <text class="circle-preview-time">08:32</text>
              <text class="circle-preview-sub">目标 68%</text>
            </div>
          </stack>
        </div>
        <div class="circle-preview-slide" @click="selectDashboard">
          <div class="circle-preview dash-preview-circle">
            <text class="circle-preview-time">08:32</text>
            <div class="circle-preview-metrics">
              <text class="circle-preview-chip">步数</text>
              <text class="circle-preview-chip">心率</text>
            </div>
            <text class="circle-preview-sub">运动仪表</text>
          </div>
        </div>
        <div class="circle-preview-slide" @click="selectMechanical">
          <stack class="circle-preview mechanical-preview-circle">
            <div class="mechanical-preview-ring"></div>
            <text class="mechanical-preview-twelve">XII</text>
            <text class="mechanical-preview-six">VI</text>
            <text class="mechanical-preview-brand">VELA</text>
            <div class="mechanical-preview-hour"></div>
            <div class="mechanical-preview-minute"></div>
            <div class="mechanical-preview-second"></div>
            <div class="mechanical-preview-pin"></div>
          </stack>
        </div>
      </swiper>
      <text class="circle-preview-name">{{ circlePreviewName }} · {{ surfaceHint }}</text>
    </div>

    <div class="rect-surface" if="{{ profileReady && isRectSurface }}">
      <div class="rect-header">
        <text class="rect-title">{{ surfaceTitle }}</text>
        <text class="rect-back" @click="goBack">返回</text>
      </div>
      <div class="rect-grid-row">
        <div class="rect-face-card" style="border-color: {{ sportBorder }}" @click="selectSport">
          <div class="rect-preview sport-preview"><text class="rect-preview-time">08</text><text class="rect-preview-sub">活力</text></div>
          <text class="rect-face-name">活力数字</text>
          <text class="rect-selected" if="{{ sportSelected }}">已选</text>
        </div>
        <div class="rect-face-card" style="border-color: {{ simpleBorder }}" @click="selectSimple">
          <div class="rect-preview simple-preview"><text class="rect-preview-wide-time">08:32</text><div class="rect-neon-line"></div></div>
          <text class="rect-face-name">极简霓虹</text>
          <text class="rect-selected cyan-text" if="{{ simpleSelected }}">已选</text>
        </div>
      </div>
      <div class="rect-grid-row rect-second-row">
        <div class="rect-face-card" style="border-color: {{ dashboardBorder }}" @click="selectDashboard">
          <div class="rect-preview dash-preview"><div class="rect-bars"><div class="rect-bar rect-bar-a"></div><div class="rect-bar rect-bar-b"></div><div class="rect-bar rect-bar-c"></div></div><text class="rect-preview-sub">数据</text></div>
          <text class="rect-face-name">运动仪表</text>
          <text class="rect-selected green-text" if="{{ dashboardSelected }}">已选</text>
        </div>
        <div class="rect-current-card">
          <text class="rect-current-label">CURRENT</text>
          <text class="rect-current-name" style="color: {{ rectSelectedAccent }}">{{ rectSelectedName }}</text>
          <div class="rect-current-line" style="background-color: {{ rectSelectedAccent }}"></div>
          <text class="rect-current-hint">{{ surfaceHint }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import pageMotion from '../../common/page_motion'
import watchfaceStore from '../../domain/watchface/store'
import faceCatalog from '../../domain/watchface/catalog'
import selectorMapper from '../../presentation/mappers/watchface_selector'
import layoutRuntime from '../../presentation/layout/runtime'
import freeSurface from '../../presentation/layout/free_surface'
import selectorLayout from '../../presentation/layout/specs/watchface_selector'

export default {
  private: {
    sportBorder: '#0A84FF',
    simpleBorder: '#2C2C2E',
    dashboardBorder: '#2C2C2E',
    alpineBorder: '#2C2C2E',
    sportSelected: true,
    simpleSelected: false,
    dashboardSelected: false,
    mechanicalSelected: false,
    alpineSelected: false,
    profileReady: false,
    isPillSurface: false,
    isCircleSurface: false,
    isRectSurface: false,
    surfaceTitle: '表盘库',
    surfaceHint: '点击应用',
    faceIds: [],
    surfacePageSize: 1,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px',
    circlePreviewIndex: 0,
    circlePreviewName: '活力数字',
    loadedFaceId: 'sport',
    pillPageIndex: 0,
    pillPageText: '1 / 2',
    rectSelectedName: '活力数字',
    rectSelectedAccent: '#0A84FF',
    pageOpacity: 1,
    pageOffset: 0
  },

  onInit() {
    var self = this
    layoutRuntime.bind(this, function (profile) {
      return freeSurface.resolve(profile, selectorLayout)
    }, function (plan) {
      self.applySurface(plan)
      self.profileReady = true
      self.updateSelectedState(self.loadedFaceId)
    })
  },

  onShow() {
    pageMotion.enter(this)
    this.loadSelectedState()
  },

  onHide() {
    pageMotion.clear(this)
  },

  onDestroy() {
    pageMotion.clear(this)
  },

  applySurface(plan) {
    this.isPillSurface = plan.surface === 'cards-pager'
    this.isCircleSurface = plan.surface === 'preview-swiper'
    this.isRectSurface = plan.surface === 'preview-grid'
    this.faceIds = plan.itemIds || []
    this.surfacePageSize = plan.pageSize || 1
    this.surfaceTitle = plan.tokens && plan.tokens.title ? plan.tokens.title : '表盘库'
    this.surfaceHint = plan.tokens && plan.tokens.hint ? plan.tokens.hint : '点击应用'
  },

  loadSelectedState() {
    var self = this
    watchfaceStore.loadSelectedFaceId(function (selected) {
      self.loadedFaceId = selected
      if (self.profileReady) self.updateSelectedState(selected)
    })
  },

  updateSelectedState(selected) {
    var mapped = selectorMapper.mapFaces(this.faceIds, selected)
    var normalized = mapped.selectedId
    var current = faceCatalog.get(normalized)
    this.loadedFaceId = normalized
    this.sportSelected = normalized === 'sport'
    this.simpleSelected = normalized === 'simple'
    this.dashboardSelected = normalized === 'dashboard'
    this.mechanicalSelected = normalized === 'mechanical'
    this.alpineSelected = normalized === 'alpine'
    this.sportBorder = this.sportSelected ? '#0A84FF' : '#2C2C2E'
    this.simpleBorder = this.simpleSelected ? '#00E5FF' : '#2C2C2E'
    this.dashboardBorder = this.dashboardSelected ? '#32D74B' : '#2C2C2E'
    this.alpineBorder = this.alpineSelected ? '#FF9F4A' : '#2C2C2E'
    this.circlePreviewIndex = mapped.selectedIndex
    this.circlePreviewName = current ? current.name : '活力数字'
    this.rectSelectedName = current ? current.name : '活力数字'
    this.rectSelectedAccent = current ? current.accent : '#0A84FF'
    this.pillPageIndex = selectorMapper.pageIndex(mapped.selectedIndex, this.surfacePageSize)
    this.refreshPillPageText()
  },

  onCircleFaceChange(event) {
    var index = event && (event.index !== undefined ? event.index : event.detail && event.detail.index)
    if (index === undefined || index === null) return
    this.circlePreviewIndex = index
    var face = faceCatalog.get(this.faceIds[index])
    if (face) this.circlePreviewName = face.name
  },

  selectSport() { this.selectFace('sport') },
  selectSimple() { this.selectFace('simple') },
  selectDashboard() { this.selectFace('dashboard') },
  selectMechanical() { this.selectFace('mechanical') },
  selectAlpine() { this.selectFace('alpine') },

  refreshPillPageText() {
    var count = Math.max(1, Math.ceil(this.faceIds.length / Math.max(1, this.surfacePageSize)))
    if (this.pillPageIndex >= count) this.pillPageIndex = count - 1
    this.pillPageText = this.pillPageIndex + 1 + ' / ' + count
  },

  previousPillPage() {
    if (this.pillPageIndex > 0) this.pillPageIndex--
    this.refreshPillPageText()
  },

  nextPillPage() {
    var count = Math.max(1, Math.ceil(this.faceIds.length / Math.max(1, this.surfacePageSize)))
    if (this.pillPageIndex < count - 1) this.pillPageIndex++
    this.refreshPillPageText()
  },

  selectFace(id) {
    if (this.savingFace) return
    var normalized = selectorMapper.selectedId(this.faceIds, id)
    this.savingFace = true
    this.updateSelectedState(normalized)
    var self = this
    watchfaceStore.setSelectedFaceId(normalized, function () {
      self.savingFace = false
      pageMotion.back(self, router)
    })
  },

  goBack() {
    pageMotion.back(this, router)
  },

  onTouchStart(e) {
    if (e.touches && e.touches[0]) this.touchStartX = e.touches[0].pageX
  },

  onTouchEnd(e) {
    if (!e.changedTouches || !e.changedTouches[0]) return
    var diffX = e.changedTouches[0].pageX - this.touchStartX
    if (this.isPillSurface && diffX < -30) this.nextPillPage()
    else if (this.isPillSurface && diffX > 30 && this.pillPageIndex > 0) this.previousPillPage()
    else if (diffX > 30) pageMotion.back(this, router)
  }
}
</script>

<style>
.select-page {
  background-color: #000000;
  width: 100%;
  height: 100%;
}

.pill-surface,
.circle-surface,
.rect-surface {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
}

.pill-top-row {
  width: 168px;
  height: 32px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 50px;
  margin-bottom: 12px;
}

.pill-title {
  font-size: 20px;
  font-weight: bold;
  color: #FFFFFF;
}

.pill-back {
  font-size: 11px;
  color: #8E8E93;
}

.face-card {
  flex-direction: row;
  align-items: center;
  width: 168px;
  height: 128px;
  background-color: #111317;
  border-width: 2px;
  border-radius: 18px;
  padding: 10px;
  margin-bottom: 12px;
}

.preview-panel {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 64px;
  height: 106px;
  border-radius: 25px;
  margin-right: 10px;
}

.sport-preview { background-color: #050505; }
.simple-preview { background-color: #040810; }
.dash-preview { background-color: #071007; }
.alpine-preview { background-color: #020713; }

.alpine-preview-background,
.alpine-preview-veil {
  width: 64px;
  height: 106px;
  border-radius: 25px;
}

.alpine-preview-background { object-fit: cover; }
.alpine-preview-veil { background-color: #020713; opacity: 0.18; }
.alpine-preview-hour { left: 5px; top: 20px; width: 40px; height: 36px; font-size: 30px; font-weight: bold; color: #FFFFFF; }
.alpine-preview-minute { left: 34px; top: 53px; width: 25px; height: 21px; font-size: 16px; font-weight: bold; color: #FFD2A1; }
.alpine-preview-label { left: 8px; top: 82px; width: 48px; height: 10px; font-size: 6px; color: #FFFFFF; text-align: center; }

.preview-date { font-size: 10px; color: #8E8E93; }
.preview-big { font-weight: bold; color: #FFFFFF; }
.sport-time { font-size: 35px; color: #0A84FF; }
.preview-small { font-size: 9px; color: #FFD60A; margin-top: 5px; }
.simple-preview-time { font-size: 17px; color: #FFFFFF; font-weight: bold; margin-bottom: 9px; }

.mini-ring,
.mini-ring-center { width: 42px; height: 42px; }
.mini-ring-center { justify-content: center; align-items: center; }
.mini-arc { width: 42px; height: 42px; color: #00E5FF; stroke-width: 3px; layer-color: #2C2C2E; start-angle: 0deg; total-angle: 360deg; center-x: 21px; center-y: 21px; radius: 19px; }
.mini-ring-text { font-size: 11px; color: #FFFFFF; font-weight: bold; }
.dash-preview-time { font-size: 15px; color: #FFFFFF; font-weight: bold; }
.mini-bars { flex-direction: row; align-items: flex-end; width: 45px; height: 32px; margin-top: 7px; }
.mini-bar { width: 8px; border-radius: 3px; background-color: #32D74B; margin-right: 6px; }
.bar-one { height: 15px; }
.bar-two { height: 26px; }
.bar-three { height: 19px; }

.face-copy { flex-direction: column; width: 82px; }
.face-name-row { flex-direction: row; align-items: center; width: 82px; height: 22px; }
.face-name { font-size: 15px; color: #FFFFFF; font-weight: bold; }
.face-badge { width: 28px; height: 16px; font-size: 9px; color: #000000; text-align: center; background-color: #0A84FF; border-radius: 8px; margin-left: 4px; }
.cyan-badge { background-color: #00E5FF; }
.green-badge { background-color: #32D74B; }
.orange-badge { background-color: #FF9F4A; }
.face-desc { width: 82px; font-size: 10px; color: #C7C7CC; margin-top: 7px; line-height: 14px; }
.face-tag { width: 62px; height: 20px; font-size: 9px; color: #8E8E93; text-align: center; background-color: #1C1C1E; border-radius: 10px; margin-top: 10px; }

.pill-face-pager { width: 124px; height: 30px; flex-direction: row; justify-content: space-between; align-items: center; margin-top: 2px; }
.pill-page-button { width: 34px; height: 28px; font-size: 24px; color: #FFFFFF; text-align: center; }
.pill-page-number { width: 52px; font-size: 10px; color: #8E8E93; text-align: center; }
.pill-hint { width: 168px; font-size: 10px; color: #666666; text-align: center; margin-top: 3px; }

.circle-select-header { width: 128px; height: 24px; flex-direction: row; justify-content: space-between; align-items: center; margin-top: 9px; }
.circle-select-title { font-size: 12px; color: #FFFFFF; font-weight: bold; }
.circle-back { font-size: 7px; color: #8E8E93; }
.circle-face-swiper { width: 152px; height: 136px; indicator-color: #3A3A3C; indicator-selected-color: #FFFFFF; indicator-size: 4px; }
.circle-preview-slide { width: 152px; height: 132px; justify-content: center; align-items: center; }
.circle-preview { width: 116px; height: 116px; border-radius: 58px; justify-content: center; align-items: center; }
.sport-preview-circle { background-color: #050505; }
.simple-preview-circle { background-color: #040810; }
.dash-preview-circle { flex-direction: column; background-color: #071007; }
.mechanical-preview-circle { background-color: #060708; }
.mechanical-preview-ring { left: 3px; top: 3px; width: 110px; height: 110px; border-radius: 55px; border-width: 2px; border-color: #B89A61; }
.mechanical-preview-twelve,
.mechanical-preview-six { left: 47px; width: 22px; height: 12px; font-size: 7px; font-weight: bold; color: #E7D6AF; text-align: center; }
.mechanical-preview-twelve { top: 10px; }
.mechanical-preview-six { top: 94px; }
.mechanical-preview-brand { left: 39px; top: 31px; width: 38px; height: 10px; font-size: 7px; font-weight: bold; color: #D6B878; text-align: center; }
.mechanical-preview-hour { left: 56px; top: 38px; width: 3px; height: 22px; border-radius: 2px; transform: rotate(45deg); transform-origin: 1px 20px; background-color: #E7D6AF; }
.mechanical-preview-minute { left: 57px; top: 27px; width: 2px; height: 34px; border-radius: 1px; transform: rotate(140deg); transform-origin: 1px 31px; background-color: #D6B878; }
.mechanical-preview-second { left: 58px; top: 24px; width: 1px; height: 39px; transform: rotate(235deg); transform-origin: 0px 34px; background-color: #B64232; }
.mechanical-preview-pin { left: 54px; top: 54px; width: 9px; height: 9px; border-radius: 5px; background-color: #D6B878; }
.circle-preview-arc { width: 116px; height: 116px; stroke-width: 5px; layer-color: #2C2C2E; start-angle: -132deg; total-angle: 264deg; center-x: 58px; center-y: 58px; radius: 51px; }
.sport-circle-arc { color: #0A84FF; }
.simple-circle-arc { color: #00E5FF; }
.circle-preview-center { width: 116px; height: 116px; flex-direction: column; justify-content: center; align-items: center; }
.circle-preview-time { font-size: 22px; color: #FFFFFF; font-weight: bold; }
.circle-preview-vital { width: 92px; height: 48px; flex-direction: column; align-items: center; }
.circle-preview-hour { width: 92px; height: 32px; font-size: 27px; color: #FF9F0A; font-weight: bold; text-align: center; margin-top: -1px; margin-right: 18px; }
.circle-preview-minute { width: 92px; height: 32px; font-size: 27px; color: #0A84FF; font-weight: bold; text-align: center; margin-left: 18px; margin-bottom: -15px; opacity: 0.92; }
.circle-preview-sub { font-size: 7px; color: #8E8E93; margin-top: 5px; }
.circle-preview-metrics { width: 84px; height: 29px; flex-direction: row; justify-content: space-between; margin-top: 7px; }
.circle-preview-chip { width: 39px; height: 25px; border-radius: 8px; background-color: #14181F; color: #32D74B; font-size: 7px; text-align: center; }
.circle-preview-name { width: 132px; height: 14px; font-size: 7px; color: #C7C7CC; text-align: center; margin-bottom: 7px; }

.rect-header { width: 164px; height: 28px; margin-top: 8px; flex-direction: row; justify-content: space-between; align-items: center; }
.rect-title { font-size: 17px; color: #FFFFFF; font-weight: bold; }
.rect-back { font-size: 9px; color: #8E8E93; }
.rect-grid-row { width: 164px; height: 82px; flex-direction: row; justify-content: space-between; margin-top: 5px; }
.rect-second-row { margin-top: 6px; }
.rect-face-card,
.rect-current-card { width: 79px; height: 82px; border-radius: 12px; background-color: #111317; }
.rect-face-card { border-width: 1px; padding: 5px; flex-direction: column; align-items: center; }
.rect-preview { width: 67px; height: 43px; border-radius: 9px; justify-content: center; align-items: center; }
.rect-preview-time { font-size: 22px; font-weight: bold; color: #0A84FF; }
