<template>
  <stack class="launcher-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="launcher-scene" if="{{ ready }}" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <stack class="honeycomb" if="{{ surface === 'honeycomb' }}" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;" @touchstart="onHoneyStart" @touchmove="onHoneyMove" @touchend="onHoneyEnd">
        <div class="honey-app" for="{{ circleVisibleSlots }}" tid="slotKey" style="left: {{ $item.left }}px; top: {{ $item.top }}px; width: {{ $item.size }}px; height: {{ $item.size }}px; opacity: {{ $item.opacity }};" @click="tapHoney($item)"><image class="honey-icon" src="{{ $item.icon }}" style="width: {{ $item.size }}px; height: {{ $item.size }}px; border-radius: {{ $item.radius }}px;"></image></div>
        <div class="honey-label" style="left: {{ honeyLabelLeft }}px; top: {{ honeyLabelTop }}px; width: {{ honeyLabelWidth }}px; height: {{ honeyLabelHeight }}px; border-radius: {{ honeyLabelRadius }}px; opacity: {{ honeyLabelOpacity }};"><text class="honey-name" style="width: {{ honeyNameWidth }}px; font-size: {{ honeyNameSize }}px;">{{ focusedLabel }}</text></div>
      </stack>

      <div class="list-surface" if="{{ surface === 'paged-list' }}" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;" @swipe="handleListSwipe">
        <div class="launcher-header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="launcher-title" style="font-size: {{ titleSize }}px;">应用</text><text class="page-text" style="font-size: {{ pageTextSize }}px;">{{ pageText }}</text></div>
        <div class="pill-list" style="left: {{ contentLeft }}px; top: {{ contentTop }}px; width: {{ contentWidth }}px; height: {{ contentHeight }}px;">
          <div class="pill-app" for="{{ pageApps }}" tid="id" @click="openApp($item)" style="width: {{ contentWidth }}px; height: {{ itemHeight }}px; margin-bottom: {{ itemGap }}px; border-radius: {{ itemRadius }}px; padding-left: {{ listPaddingX }}px; padding-right: {{ listPaddingX }}px;"><image class="pill-icon" src="{{ $item.icon }}" style="width: {{ iconSize }}px; height: {{ iconSize }}px; border-radius: {{ iconRadius }}px;"></image><text class="pill-name" style="font-size: {{ nameSize }}px; margin-left: {{ listNameGap }}px;">{{ $item.label }}</text><text class="pill-arrow" style="width: {{ arrowWidth }}px; font-size: {{ arrowSize }}px;">›</text></div>
        </div>
        <div class="pager" style="left: {{ pagerLeft }}px; top: {{ pagerTop }}px; width: {{ pagerWidth }}px; height: {{ pagerHeight }}px;"><text class="pager-button" style="width: {{ pagerButtonWidth }}px; height: {{ pagerButtonHeight }}px; font-size: {{ pagerButtonSize }}px; color: {{ previousColor }};" @click="previousPage">‹</text><div class="pager-track" style="width: {{ pagerTrackWidth }}px; height: {{ pagerTrackHeight }}px; border-radius: {{ pagerTrackRadius }}px;"><div class="pager-fill" style="width: {{ pageProgress }}; height: {{ pagerTrackHeight }}px; border-radius: {{ pagerTrackRadius }}px;"></div></div><text class="pager-button" style="width: {{ pagerButtonWidth }}px; height: {{ pagerButtonHeight }}px; font-size: {{ pagerButtonSize }}px; color: {{ nextColor }};" @click="nextPage">›</text></div>
      </div>

      <div class="grid-surface" if="{{ surface === 'designed-grid' }}" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;" @swipe="handleListSwipe">
        <div class="launcher-header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="launcher-title" style="font-size: {{ titleSize }}px;">应用</text><text class="page-text" style="font-size: {{ pageTextSize }}px;">{{ pageText }}</text></div>
        <div class="rect-grid" style="left: {{ contentLeft }}px; top: {{ contentTop }}px; width: {{ contentWidth }}px; height: {{ contentHeight }}px;">
          <div class="grid-app" for="{{ gridApps }}" tid="id" @click="openApp($item)" style="width: {{ itemWidth }}px; height: {{ itemHeight }}px; margin-right: {{ $item.marginRight }}px; margin-bottom: {{ $item.marginBottom }}px; border-radius: {{ itemRadius }}px; border-width: {{ gridBorderWidth }}px; border-color: {{ $item.accent }}; padding: {{ gridPadding }}px;"><image class="grid-icon" src="{{ $item.icon }}" style="width: {{ iconSize }}px; height: {{ iconSize }}px; border-radius: {{ iconRadius }}px;"></image><text class="grid-name" style="font-size: {{ nameSize }}px; margin-left: {{ gridNameGap }}px;">{{ $item.label }}</text><div class="grid-accent" style="width: {{ gridAccentWidth }}px; height: {{ gridAccentHeight }}px; border-radius: {{ gridAccentRadius }}px; margin-left: {{ gridAccentGap }}px; background-color: {{ $item.accent }};"></div></div>
        </div>
        <div class="pager" style="left: {{ pagerLeft }}px; top: {{ pagerTop }}px; width: {{ pagerWidth }}px; height: {{ pagerHeight }}px;"><text class="pager-button" style="width: {{ pagerButtonWidth }}px; height: {{ pagerButtonHeight }}px; font-size: {{ pagerButtonSize }}px; color: {{ previousColor }};" @click="previousPage">‹</text><div class="pager-track" style="width: {{ pagerTrackWidth }}px; height: {{ pagerTrackHeight }}px; border-radius: {{ pagerTrackRadius }}px;"><div class="pager-fill" style="width: {{ pageProgress }}; height: {{ pagerTrackHeight }}px; border-radius: {{ pagerTrackRadius }}px;"></div></div><text class="pager-button" style="width: {{ pagerButtonWidth }}px; height: {{ pagerButtonHeight }}px; font-size: {{ pagerButtonSize }}px; color: {{ nextColor }};" @click="nextPage">›</text></div>
      </div>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../runtime/page_runtime'
import navigation from '../../runtime/navigation'
import appRoutes from '../../runtime/app_routes'
import { createLauncherController } from '../../v2/features/launcher/controller'
import launcherDesign from '../../v2/design/apps/launcher'
import launcherView from '../../v2/design/apps/launcher/view'
import honeycomb from '../../v2/design/engines/honeycomb'

export default {
  private: {
    ready: false, surface: '', pageApps: [], gridApps: [], pageText: '1 / 1', pageProgress: '100%', previousColor: '#3A3A3C', nextColor: '#3A3A3C', hasPrevious: false, hasNext: false,
    headerLeft: 0, headerTop: 0, headerWidth: 0, headerHeight: 0, contentLeft: 0, contentTop: 0, contentWidth: 0, contentHeight: 0, pagerLeft: 0, pagerTop: 0, pagerWidth: 0, pagerHeight: 0,
    itemHeight: 0, itemGap: 0, itemWidth: 0, itemRadius: 0, titleSize: 0, pageTextSize: 0, nameSize: 0, arrowSize: 0, iconSize: 0, iconRadius: 0,
    listPaddingX: 0, listNameGap: 0, arrowWidth: 0,
    gridBorderWidth: 0, gridPadding: 0, gridNameGap: 0, gridAccentWidth: 0, gridAccentHeight: 0, gridAccentRadius: 0, gridAccentGap: 0,
    pagerButtonWidth: 0, pagerButtonHeight: 0, pagerButtonSize: 0, pagerTrackWidth: 0, pagerTrackHeight: 0, pagerTrackRadius: 0,
    honeyLabelLeft: 0, honeyLabelTop: 0, honeyLabelWidth: 0, honeyLabelHeight: 0, honeyLabelRadius: 0, honeyNameWidth: 0, honeyNameSize: 0, honeyInitialFocusDistance: 0,
    circleSlots: [], circleVisibleSlots: [], focusedLabel: '', honeyLabelOpacity: 1, circleFocusIndex: 0, circlePanX: 0, circlePanY: 0, circleTouchActive: false, circleVelocityX: 0, circleVelocityY: 0,
    sceneWidth: 0, sceneHeight: 0, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createLauncherController(function (state) { self.applyState(state) })
    pageRuntime.bind(this, function (profile, scene, safe) {
      self.plan = launcherDesign.resolve(profile, scene, safe)
      self.applyPlan(self.plan)
      self.ready = true
      self.controller.configure(self.plan.appIds, self.plan.pageSize)
    })
  },
  onHide() { this.circleTouchActive = false; this.stopHoneycombMotion() },
  onDestroy() { this.circleTouchActive = false; this.stopHoneycombMotion(); this.circleSlots = []; this.circleVisibleSlots = [] },
  onBackPress() { navigation.back(); return true },

  applyPlan(plan) {
    this.surface = plan.surface
    this.headerLeft = plan.header.left; this.headerTop = plan.header.top; this.headerWidth = plan.header.width; this.headerHeight = plan.header.height
    this.contentLeft = plan.content.left; this.contentTop = plan.content.top; this.contentWidth = plan.content.width; this.contentHeight = plan.content.height
    this.pagerLeft = plan.pager.left; this.pagerTop = plan.pager.top; this.pagerWidth = plan.pager.width; this.pagerHeight = plan.pager.height
    this.itemHeight = plan.itemHeight; this.itemGap = plan.itemGap; this.itemWidth = plan.itemWidth; this.itemRadius = plan.itemRadius
    this.titleSize = plan.titleSize; this.pageTextSize = plan.pageTextSize; this.nameSize = plan.nameSize; this.arrowSize = plan.arrowSize; this.iconSize = plan.iconSize; this.iconRadius = plan.iconRadius
    this.listPaddingX = plan.listChrome.paddingX; this.listNameGap = plan.listChrome.nameGap; this.arrowWidth = plan.listChrome.arrowWidth
    this.gridBorderWidth = plan.gridChrome.borderWidth; this.gridPadding = plan.gridChrome.padding; this.gridNameGap = plan.gridChrome.nameGap; this.gridAccentWidth = plan.gridChrome.accentWidth; this.gridAccentHeight = plan.gridChrome.accentHeight; this.gridAccentRadius = plan.gridChrome.accentRadius; this.gridAccentGap = plan.gridChrome.accentGap
    this.pagerButtonWidth = plan.pagerChrome.buttonWidth; this.pagerButtonHeight = plan.pagerChrome.buttonHeight; this.pagerButtonSize = plan.pagerChrome.buttonSize; this.pagerTrackWidth = plan.pagerChrome.trackWidth; this.pagerTrackHeight = plan.pagerChrome.trackHeight; this.pagerTrackRadius = plan.pagerChrome.trackRadius
    if (plan.honeycomb && plan.honeycomb.label) {
      this.honeyLabelLeft = plan.honeycomb.label.left; this.honeyLabelTop = plan.honeycomb.label.top; this.honeyLabelWidth = plan.honeycomb.label.width; this.honeyLabelHeight = plan.honeycomb.label.height; this.honeyLabelRadius = plan.honeycomb.label.radius
      this.honeyNameWidth = plan.honeycomb.nameWidth; this.honeyNameSize = plan.honeycomb.nameSize; this.honeyInitialFocusDistance = plan.honeycomb.initialFocusDistance
    }
  },

  applyState(state) {
    var view = launcherView.project(state, this.plan)
    this.pageApps = view.pageApps
    this.gridApps = view.gridApps
    this.pageText = view.pageText
    this.pageProgress = view.pageProgress
    this.previousColor = view.previousColor
    this.nextColor = view.nextColor
    this.hasPrevious = !!(state && state.hasPrevious)
    this.hasNext = !!(state && state.hasNext)
    if (this.surface === 'honeycomb' && !this.circleSlots.length) this.initHoneycomb(view.allApps)
  },

  initHoneycomb(apps) {
    this.circleSlots = honeycomb.buildSlots(apps)
    this.circleFocusIndex = 0
    var target = honeycomb.panForSlot(this.circleSlots[0], this.honeyInitialFocusDistance)
    this.circlePanX = target ? target.x : 0
    this.circlePanY = target ? target.y : 0
    this.renderHoneycomb()
  },

  renderHoneycomb() {
    if (!this.circleSlots.length) { this.circleVisibleSlots = []; return }
    var frame = honeycomb.layoutSlots(this.circleSlots, this.circlePanX, this.circlePanY, 0, 0)
    this.circleVisibleSlots = honeycomb.visibleSlots(frame.slots)
    if (frame.nearestIndex >= 0) {
      this.circleFocusIndex = frame.nearestIndex
      this.focusedLabel = this.circleSlots[frame.nearestIndex].label
      this.circleFocusDistance = frame.nearestDistance
    }
  },

  scheduleHoneycombLayout() {
    if (this.honeyLayoutTimer) return
    var self = this
    this.honeyLayoutTimer = setTimeout(function () {
      self.honeyLayoutTimer = null
      self.renderHoneycomb()
    }, honeycomb.FRAME_MS)
  },
  stopHoneycombMotion() {
    clearTimeout(this.honeyLayoutTimer)
    clearTimeout(this.honeyMotionTimer)
    this.honeyLayoutTimer = null
    this.honeyMotionTimer = null
    this.circleVelocityX = 0
    this.circleVelocityY = 0
  },

  onHoneyStart(event) {
    if (!event.touches || !event.touches[0]) return
    this.stopHoneycombMotion()
    var p = event.touches[0]
    this.touchStartX = p.pageX; this.touchStartY = p.pageY; this.touchLastX = p.pageX; this.touchLastY = p.pageY; this.touchLastAt = Date.now()
    this.circleTouchActive = true; this.dragMoved = false; this.honeyLabelOpacity = 0
  },
  onHoneyMove(event) {
    if (!this.circleTouchActive || !event.touches || !event.touches[0]) return
    var p = event.touches[0]
    var now = Date.now()
    var dx = p.pageX - this.touchLastX
    var dy = p.pageY - this.touchLastY
    var dt = Math.max(8, now - (this.touchLastAt || now))
    this.touchLastX = p.pageX; this.touchLastY = p.pageY; this.touchLastAt = now
    if (Math.abs(p.pageX - this.touchStartX) > 6 || Math.abs(p.pageY - this.touchStartY) > 6) this.dragMoved = true
    if (this.dragMoved) {
      if (event.preventDefault) event.preventDefault()
      if (event.stopPropagation) event.stopPropagation()
    }
    var pan = honeycomb.nextPan(this.circleSlots, this.circlePanX, this.circlePanY, dx, dy)
    this.circlePanX = pan.x; this.circlePanY = pan.y
    this.circleVelocityX = this.circleVelocityX * 0.45 + (dx / dt) * 0.55
    this.circleVelocityY = this.circleVelocityY * 0.45 + (dy / dt) * 0.55
    this.scheduleHoneycombLayout()
  },
  onHoneyEnd(event) {
    if (!this.circleTouchActive) return
    this.circleTouchActive = false
    var p = event.changedTouches && event.changedTouches[0]
    var totalX = p ? p.pageX - this.touchStartX : 0
    var totalY = p ? p.pageY - this.touchStartY : 0
    if (totalX > 58 && Math.abs(totalY) < 30 && this.touchStartX < 26) {
      if (event && event.preventDefault) event.preventDefault()
      if (event && event.stopPropagation) event.stopPropagation()
      this.stopHoneycombMotion(); navigation.back(); return
    }
    if (!this.dragMoved) { this.honeyLabelOpacity = 1; this.scheduleHoneycombLayout(); return }
    if (event && event.preventDefault) event.preventDefault()
    if (event && event.stopPropagation) event.stopPropagation()
    this.suppressTapUntil = Date.now() + 220
    this.startHoneyInertia(this.circleVelocityX, this.circleVelocityY)
  },

  startHoneyInertia(vx, vy) {
    clearTimeout(this.honeyMotionTimer)
    this.circleVelocityX = Number(vx) || 0
    this.circleVelocityY = Number(vy) || 0
    this.honeyLabelOpacity = 0.45
    var self = this
    function tick() {
      var speed = Math.sqrt(self.circleVelocityX * self.circleVelocityX + self.circleVelocityY * self.circleVelocityY)
      if (speed < honeycomb.MIN_VELOCITY) { self.honeyMotionTimer = null; self.settleHoneycomb(); return }
      var pan = honeycomb.nextPan(self.circleSlots, self.circlePanX, self.circlePanY, self.circleVelocityX * honeycomb.FRAME_MS, self.circleVelocityY * honeycomb.FRAME_MS)
      self.circlePanX = pan.x; self.circlePanY = pan.y
      self.circleVelocityX *= honeycomb.INERTIA_DECAY
      self.circleVelocityY *= honeycomb.INERTIA_DECAY
      self.renderHoneycomb()
      self.honeyMotionTimer = setTimeout(tick, honeycomb.FRAME_MS)
    }
    tick()
  },

  settleHoneycomb() {
    if (!this.circleSlots.length) return
    var strict = honeycomb.clampPan(this.circleSlots, this.circlePanX, this.circlePanY, 0)
    var frame = honeycomb.layoutSlots(this.circleSlots, strict.x, strict.y, 0, 0)
    var target = strict
    if (frame.nearestIndex >= 0 && frame.nearestDistance <= honeycomb.MAGNET_DISTANCE) target = honeycomb.panForSlot(this.circleSlots[frame.nearestIndex]) || strict
    target = honeycomb.clampPan(this.circleSlots, target.x, target.y, 0)
    this.animateHoneyPan(target)
  },

  animateHoneyPan(target) {
    clearTimeout(this.honeyMotionTimer)
    var startX = this.circlePanX
    var startY = this.circlePanY
    var startedAt = Date.now()
    var duration = 144
    var self = this
    function tick() {
      var progress = Math.min(1, (Date.now() - startedAt) / duration)
      var eased = 1 - Math.pow(1 - progress, 3)
      self.circlePanX = startX + (target.x - startX) * eased
      self.circlePanY = startY + (target.y - startY) * eased
      self.renderHoneycomb()
      if (progress >= 1) { self.honeyMotionTimer = null; self.honeyLabelOpacity = 1; return }
      self.honeyMotionTimer = setTimeout(tick, honeycomb.FRAME_MS)
    }
    tick()
  },

  tapHoney(item) {
    if (!item || Date.now() < (this.suppressTapUntil || 0)) return
    this.stopHoneycombMotion()
    this.openApp(item)
  },

  handleListSwipe(event) {
    if (!event || this.surface === 'honeycomb') return
    if (event.preventDefault) event.preventDefault()
    if (event.stopPropagation) event.stopPropagation()
    if (event.direction === 'down') navigation.back()
    else if (event.direction === 'left' && this.hasNext) this.controller.next()
    else if (event.direction === 'right') {
      if (this.hasPrevious) this.controller.previous()
      else navigation.back()
    }
  },

  previousPage() { this.controller.previous() },
  nextPage() { this.controller.next() },
  openApp(item) {
    if (!item) return
    navigation.push(appRoutes.routeFor(item.id))
  }
}
</script>

<style>
.launcher-root, .launcher-scene { background-color: #000000; }
.launcher-scene { position: absolute; left: 0px; top: 0px; }
.list-surface, .grid-surface { position: absolute; left: 0px; top: 0px; background-color: #000000; }
.honeycomb { position: absolute; left: 0px; top: 0px; background-color: #000000; }
.honey-app { position: absolute; } .honey-icon { object-fit: cover; }
.honey-label { position: absolute; background-color: #111317; justify-content: center; align-items: center; }
.honey-name { color: #FFFFFF; font-weight: bold; text-align: center; lines: 1; }
.launcher-header, .pill-list, .rect-grid, .pager { position: absolute; }
.launcher-header { flex-direction: row; justify-content: space-between; align-items: center; }
.launcher-title { color: #FFFFFF; font-weight: bold; } .page-text { color: #636366; }
.pill-list { flex-direction: column; overflow: hidden; }
.pill-app { background-color: #14161A; flex-direction: row; align-items: center; }
.pill-icon { object-fit: cover; } .pill-name { flex: 1; color: #FFFFFF; font-weight: bold; } .pill-arrow { color: #636366; text-align: right; }
.rect-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.grid-app { background-color: #111317; flex-direction: row; align-items: center; }
.grid-icon { object-fit: cover; } .grid-name { flex: 1; color: #FFFFFF; font-weight: bold; lines: 1; }
.pager { flex-direction: row; justify-content: space-between; align-items: center; }
.pager-button { text-align: center; }
.pager-track { background-color: #242426; }
.pager-fill { background-color: #0A84FF; }
</style>