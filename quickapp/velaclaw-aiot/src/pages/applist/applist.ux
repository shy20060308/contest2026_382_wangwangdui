<import name="surfacecollection" src="../../components/surface_collection.ux"></import>
<template><surfacecollection if="{{ surfaceReady && surfacePlan && surfacePlan.collection }}" model="{{ surfacePlan.collection }}" @surfaceaction="onSurfaceAction"></surfacecollection></template>
<script>
import surfacePage from '../../runtime/surface_page'
var surface = require('../../product/frontend/surfaces/applist.json')
export default { private: { surfaceReady: false, surfacePlan: null }, onInit() { surfacePage.bind(this, surface) }, onShow() { surfacePage.show(this) }, onHide() { surfacePage.hide(this) }, onDestroy() { surfacePage.destroy(this) }, onBackPress() { return surfacePage.back(this) }, onSurfaceAction(event) { surfacePage.action(this, event) } }
</script>
