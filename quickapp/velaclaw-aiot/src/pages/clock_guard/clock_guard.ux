<template>
  <div class="guard"></div>
</template>

<script>
import navigation from '../../v2/app/navigation'

export default {
  private: {
    visible: false,
    redirectTimer: null
  },
  onShow() {
    this.visible = true
    this.queueClock()
  },
  onHide() {
    this.visible = false
    this.clearRedirect()
  },
  onDestroy() {
    this.visible = false
    this.clearRedirect()
  },
  onBackPress() {
    this.queueClock()
    return true
  },
  clearRedirect() {
    if (!this.redirectTimer) return
    clearTimeout(this.redirectTimer)
    this.redirectTimer = null
  },
  queueClock() {
    if (!this.visible || this.redirectTimer) return
    var self = this
    this.redirectTimer = setTimeout(function () {
      self.redirectTimer = null
      if (self.visible) navigation.push('/pages/clock')
    }, 30)
  }
}
</script>

<style>
.guard {
  width: 100%;
  height: 100%;
  background-color: #000000;
}
</style>
