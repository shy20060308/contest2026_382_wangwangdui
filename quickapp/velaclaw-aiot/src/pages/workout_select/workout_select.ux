<template>
  <div class="select-page {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <div class="top-row" style="position: absolute; left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;">
      <text class="page-title" style="font-size: {{ titleFontSize }}px;">运动模式</text>
      <text class="history-link" style="font-size: {{ historyFontSize }}px;" @click="openHistory">记录</text>
    </div>

    <scroll class="mode-stream" scroll-y="true" style="position: absolute; left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
      <div class="mode-card walk-card" style="width: {{ cardWidth }}px; height: {{ cardHeight }}px; padding: {{ cardPadding }}px; border-radius: {{ cardRadius }}px; margin-bottom: {{ cardGap }}px;" @click="startWalk">
        <div class="mode-icon walk-icon" style="width: {{ iconSize }}px; height: {{ iconSize }}px; border-radius: {{ iconRadius }}px; margin-right: {{ iconGap }}px;"><text class="mode-letter" style="font-size: {{ modeLetterFontSize }}px;">W</text></div>
        <div class="mode-copy" style="width: {{ copyWidth }}px;">
          <text class="mode-name" style="font-size: {{ modeNameFontSize }}px;">步行</text>
          <text class="mode-desc" style="font-size: {{ modeDescFontSize }}px;">轻量有氧与日常健走</text>
          <text class="mode-meta" style="font-size: {{ modeMetaFontSize }}px;">约 90 步/分钟</text>
        </div>
        <text class="mode-arrow" style="width: {{ arrowWidth }}px; font-size: {{ arrowFontSize }}px;">›</text>
      </div>

      <div class="mode-card run-card" style="width: {{ cardWidth }}px; height: {{ cardHeight }}px; padding: {{ cardPadding }}px; border-radius: {{ cardRadius }}px; margin-bottom: {{ cardGap }}px;" @click="startRun">
        <div class="mode-icon run-icon" style="width: {{ iconSize }}px; height: {{ iconSize }}px; border-radius: {{ iconRadius }}px; margin-right: {{ iconGap }}px;"><text class="mode-letter" style="font-size: {{ modeLetterFontSize }}px;">R</text></div>
        <div class="mode-copy" style="width: {{ copyWidth }}px;">
          <text class="mode-name" style="font-size: {{ modeNameFontSize }}px;">跑步</text>
          <text class="mode-desc" style="font-size: {{ modeDescFontSize }}px;">更高步频与热量消耗</text>
          <text class="mode-meta" style="font-size: {{ modeMetaFontSize }}px;">约 150 步/分钟</text>
        </div>
        <text class="mode-arrow" style="width: {{ arrowWidth }}px; font-size: {{ arrowFontSize }}px;">›</text>
      </div>

      <div class="active-card" if="{{ activeVisible }}" style="width: {{ cardWidth }}px; height: {{ activeHeight }}px; padding-left: {{ activePadding }}px; border-radius: {{ activeRadius }}px; margin-bottom: {{ cardGap }}px;" @click="continueWorkout">
        <text class="active-title" style="font-size: {{ activeTitleFontSize }}px;">继续上次运动</text>
        <text class="active-value" style="font-size: {{ activeValueFontSize }}px;">{{ activeType }} · {{ activeDuration }}</text>
      </div>

      <text class="page-tip" style="width: {{ cardWidth }}px; font-size: {{ tipFontSize }}px;">模拟器使用运动模型估算数据</text>
      <div class="stream-bottom-space" style="height: {{ streamBottomPadding }}px;"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import workoutManager from '../../common/workout_manager'
import pageMotion from '../../common/page_motion'
import swipeBack from '../../common/swipe_back'
import layoutRuntime from '../../presentation/layout/runtime'
import scrollFlow from '../../presentation/layout/scroll_flow'
import workoutSelectLayout from '../../presentation/layout/specs/workout_select'

function region(plan, id) {
  var list = plan && plan.regions ? plan.regions : []
  for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i]
  return null
}

export default {
  private: {
    activeVisible: false,
    activeType: '',
    activeDuration: '',
    headerLeft: 36,
    headerTop: 22,
    headerWidth: 120,
    headerHeight: 20,
    streamLeft: 22,
    streamTop: 46,
    streamWidth: 148,
    streamHeight: 110,
    cardWidth: 148,
    cardHeight: 72,
    cardGap: 8,
    cardPadding: 9,
    cardRadius: 20,
    iconSize: 35,
    iconRadius: 18,
    iconGap: 8,
    copyWidth: 82,
    arrowWidth: 12,
    titleFontSize: 13,
    historyFontSize: 7,
    modeLetterFontSize: 14,
    modeNameFontSize: 13,
    modeDescFontSize: 7,
    modeMetaFontSize: 7,
    arrowFontSize: 12,
    activeHeight: 43,
    activePadding: 10,
    activeRadius: 16,
    activeTitleFontSize: 9,
    activeValueFontSize: 7,
    tipFontSize: 7,
    streamBottomPadding: 16,
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px'
  },

  onInit() {
    var self = this
    layoutRuntime.bind(this, function (profile) {
      return scrollFlow.resolve(profile, workoutSelectLayout)
    }, function (plan) {
      self.applyLayout(plan)
    })
  },

  onShow() {
    pageMotion.enter(this)
    var self = this
    workoutManager.loadActive(function (session) {
      self.activeVisible = !!session
      if (session) {
        self.activeType = session.typeName
        self.activeDuration = session.durationText
      }
    })
  },

  onHide() { pageMotion.clear(this) },
  onDestroy() { pageMotion.clear(this) },

  applyLayout(plan) {
    var header = region(plan, 'header')
    var stream = plan && plan.stream
    if (!header || !stream) return
    this.headerLeft = header.left
    this.headerTop = header.top
    this.headerWidth = header.width
    this.headerHeight = header.height
    this.streamLeft = stream.left
    this.streamTop = stream.top
    this.streamWidth = stream.width
    this.streamHeight = stream.viewportHeight
    this.cardWidth = stream.width
    this.cardHeight = stream.itemHeight
    this.cardGap = stream.gap
    this.streamBottomPadding = stream.bottomPadding

    var scale = plan.scale || 1
    var visualScale = Math.max(0.9, Math.min(1.24, scale))
    this.cardPadding = Math.max(8, Math.round(9 * scale))
    this.cardRadius = Math.max(16, Math.round(20 * visualScale))
    this.iconSize = Math.max(32, Math.round(35 * visualScale))
    this.iconRadius = Math.round(this.iconSize / 2)
    this.iconGap = Math.max(7, Math.round(8 * scale))
    this.arrowWidth = Math.max(11, Math.round(12 * scale))
    this.copyWidth = Math.max(66, Math.round(this.cardWidth - this.cardPadding * 2 - this.iconSize - this.iconGap - this.arrowWidth))
    this.titleFontSize = Math.max(12, Math.round(13 * visualScale))
    this.historyFontSize = Math.max(7, Math.round(7 * visualScale))
    this.modeLetterFontSize = Math.max(13, Math.round(14 * visualScale))
    this.modeNameFontSize = Math.max(12, Math.round(13 * visualScale))
    this.modeDescFontSize = Math.max(7, Math.round(7 * visualScale))
    this.modeMetaFontSize = Math.max(7, Math.round(7 * visualScale))
    this.arrowFontSize = Math.max(12, Math.round(12 * visualScale))
    this.activeHeight = Math.max(40, Math.round(43 * visualScale))
    this.activePadding = Math.max(9, Math.round(10 * scale))
    this.activeRadius = Math.max(14, Math.round(16 * visualScale))
    this.activeTitleFontSize = Math.max(9, Math.round(9 * visualScale))
    this.activeValueFontSize = Math.max(7, Math.round(7 * visualScale))
    this.tipFontSize = Math.max(7, Math.round(7 * visualScale))
  },

  startWalk() { this.startMode('walk') },
  startRun() { this.startMode('run') },

  startMode(type) {
    var self = this
    workoutManager.start(type, function () {
      pageMotion.push(self, router, '/pages/workout')
    })
  },

  continueWorkout() { pageMotion.push(this, router, '/pages/workout') },
  openHistory() { pageMotion.push(this, router, '/pages/workout_history') },
  onTouchStart(e) { swipeBack.start(this, e) },
  onTouchEnd(e) { swipeBack.end(this, e, router) }
}
</script>

<style>
.select-page { width: 100%; height: 100%; background-color: #000000; }
.top-row,
.mode-card { flex-direction: row; align-items: center; }
.top-row { justify-content: space-between; }
.page-title { font-weight: bold; color: #FFFFFF; }
.history-link { color: #0A84FF; }
.mode-stream { flex-direction: column; }
.mode-card { border-width: 1px; }
.walk-card { background-color: #0A1812; border-color: #245C3C; }
.run-card { background-color: #1A1108; border-color: #684114; }
.mode-icon { justify-content: center; align-items: center; }
.walk-icon { background-color: #30D158; }
.run-icon { background-color: #FF9F0A; }
.mode-letter { font-weight: bold; color: #000000; }
.mode-copy { flex-direction: column; }
.mode-name { color: #FFFFFF; font-weight: bold; }
.mode-desc { color: #C7C7CC; margin-top: 4px; }
.mode-meta { color: #8E8E93; margin-top: 5px; }
.mode-arrow { color: #8E8E93; text-align: right; }
.active-card { flex-direction: column; justify-content: center; background-color: #111317; }
.active-title { font-weight: bold; color: #FFFFFF; }
.active-value { color: #FFD60A; margin-top: 4px; }
.page-tip { color: #666666; text-align: center; }
</style>
