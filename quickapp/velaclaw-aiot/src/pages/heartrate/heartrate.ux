<template>
  <stack class="health-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <stack class="health-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <scroll class="circle-health" if="{{ ready && isCircle }}" scroll-y="true" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
        <text class="circle-title">健康</text>
        <div class="circle-summary"><text class="circle-summary-text" style="color: {{ summaryColor }};">{{ summaryText }}</text><text class="circle-summary-source">{{ sourceText }}</text></div>
        <div class="circle-hero">
          <div class="hero-head"><text class="hero-label">心率</text><text class="hero-source">{{ heartSource }} · {{ heartTrendText }}</text></div>
          <div class="hero-value-row"><text class="hero-value">{{ heartRate }}</text><text class="hero-unit">bpm</text><text class="hero-status" style="color: {{ heartStatusColor }};">{{ heartStatus }}</text></div>
          <div class="trend-row circle-trend"><div class="trend-bar" for="{{ heartBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div>
          <text class="hero-footer">{{ heartRangeText }}</text>
        </div>
        <div class="circle-mini-row">
          <div class="circle-mini spo2-mini"><div class="mini-head"><text class="mini-label spo2-color">血氧</text><text class="mini-source">{{ spo2Source }}</text></div><text class="mini-value">{{ spo2 }}%</text><text class="mini-status" style="color: {{ spo2StatusColor }};">{{ spo2Status }}</text></div>
          <div class="circle-mini stress-mini"><div class="mini-head"><text class="mini-label stress-color">压力</text><text class="mini-source">{{ stressSource }}</text></div><text class="mini-value">{{ stress }}</text><text class="mini-status" style="color: {{ stressStatusColor }};">{{ stressStatus }}</text></div>
        </div>
        <div class="circle-detail"><div class="detail-head"><text class="detail-title">血氧变化</text><text class="detail-meta">{{ spo2TrendText }}</text></div><div class="trend-row compact-trend"><div class="trend-bar" for="{{ spo2Bars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="detail-foot">{{ spo2RangeText }}</text></div>
        <div class="circle-detail"><div class="detail-head"><text class="detail-title">压力变化</text><text class="detail-meta">{{ stressTrendText }}</text></div><div class="trend-row compact-trend"><div class="trend-bar" for="{{ stressBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="detail-foot">{{ stressRangeText }}</text></div>
      </scroll>

      <scroll class="pill-health" if="{{ ready && isPill }}" scroll-y="true" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <div class="pill-head"><div><text class="pill-title">健康状态</text><text class="pill-subtitle">心率 · 血氧 · 压力</text></div><div class="pill-head-right"><text class="pill-summary" style="color: {{ summaryColor }};">{{ summaryText }}</text><text class="pill-source">{{ sourceText }}</text></div></div>
        <div class="pill-card heart-card"><div class="card-head"><text class="card-title">心率</text><text class="card-source">{{ heartSource }} · {{ heartTrendText }}</text></div><div class="card-value-row"><text class="card-value heart-color">{{ heartRate }}</text><text class="card-unit">bpm</text><text class="card-status" style="color: {{ heartStatusColor }};">{{ heartStatus }}</text></div><div class="trend-row pill-trend"><div class="trend-bar wide" for="{{ heartBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="card-foot">{{ heartRangeText }}</text></div>
        <div class="pill-card spo2-card"><div class="card-head"><text class="card-title">血氧</text><text class="card-source">{{ spo2Source }} · {{ spo2TrendText }}</text></div><div class="card-value-row"><text class="card-value spo2-color">{{ spo2 }}</text><text class="card-unit">%</text><text class="card-status" style="color: {{ spo2StatusColor }};">{{ spo2Status }}</text></div><div class="trend-row pill-trend"><div class="trend-bar wide" for="{{ spo2Bars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="card-foot">{{ spo2RangeText }} · 参考 95–100%</text></div>
        <div class="pill-card stress-card"><div class="card-head"><text class="card-title">压力</text><text class="card-source">{{ stressSource }} · {{ stressTrendText }}</text></div><div class="card-value-row"><text class="card-value stress-color">{{ stress }}</text><text class="card-unit">/100</text><text class="card-status" style="color: {{ stressStatusColor }};">{{ stressStatus }}</text></div><div class="trend-row pill-trend"><div class="trend-bar wide" for="{{ stressBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="card-foot">{{ stressRangeText }}</text></div>
        <text class="updated">更新于 {{ updatedAtText }}</text>
      </scroll>

      <div class="rect-health" if="{{ ready && isRect }}" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <div class="rect-head"><div><text class="rect-title">健康</text><text class="rect-sub">{{ sourceText }}</text></div><div class="rect-head-right"><text class="rect-summary" style="color: {{ summaryColor }};">{{ summaryText }}</text><text class="rect-updated">{{ updatedAtText }}</text></div></div>
        <div class="rect-heart"><div class="rect-heart-left"><div class="rect-label-row"><text class="rect-label heart-color">心率</text><text class="rect-trend-meta">{{ heartTrendText }}</text></div><div class="rect-heart-value-row"><text class="rect-heart-value">{{ heartRate }}</text><text class="rect-unit">bpm</text></div><text class="rect-status" style="color: {{ heartStatusColor }};">{{ heartStatus }} · {{ heartRangeText }}</text></div><div class="trend-row rect-heart-trend"><div class="trend-bar" for="{{ heartBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div></div>
        <div class="rect-mini-row">
          <div class="rect-mini spo2-card"><div class="rect-label-row"><text class="rect-label spo2-color">血氧</text><text class="rect-trend-meta">{{ spo2TrendText }}</text></div><text class="rect-mini-value spo2-color">{{ spo2 }}%</text><text class="rect-status" style="color: {{ spo2StatusColor }};">{{ spo2Status }}</text><div class="trend-row rect-mini-trend"><div class="trend-bar" for="{{ spo2Bars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div></div>
          <div class="rect-mini stress-card"><div class="rect-label-row"><text class="rect-label stress-color">压力</text><text class="rect-trend-meta">{{ stressTrendText }}</text></div><text class="rect-mini-value stress-color">{{ stress }}</text><text class="rect-status" style="color: {{ stressStatusColor }};">{{ stressStatus }}</text><div class="trend-row rect-mini-trend"><div class="trend-bar" for="{{ stressBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div></div>
        </div>
      </div>
    </stack>
  </stack>
</template>

<script>
import pageRuntime from '../../v2/app/page_runtime'
import navigation from '../../v2/app/navigation'
import { createHealthController } from '../../v2/features/health/controller'
import healthDesign from '../../v2/design/specs/health'
import healthView from '../../v2/design/views/health'

export default {
  private: {
    ready: false, pageVisible: false, isCircle: false, isPill: false, isRect: false, contentWidth: 148, designPlan: null, healthModel: null,
    sceneWidth: 192, sceneHeight: 192, sceneSafeLeft: 22, sceneSafeTop: 35, sceneSafeHeight: 120,
    viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%',
    heartRate: 0, spo2: 0, stress: 0, dailyMin: 0, dailyMax: 0,
    heartStatus: '等待', heartStatusColor: '#8E8E93', spo2Status: '等待', spo2StatusColor: '#8E8E93', stressStatus: '等待', stressStatusColor: '#8E8E93',
    summaryText: '等待健康数据', summaryColor: '#8E8E93', heartSource: '等待', spo2Source: '等待', stressSource: '等待', sourceText: '等待系统数据', updatedAtText: '--:--',
    heartTrendText: '当前', spo2TrendText: '当前', stressTrendText: '当前', heartRangeText: '等待数据', spo2RangeText: '等待数据', stressRangeText: '等待数据',
    stressMin: 0, stressAvg: 0, stressMax: 0, heartBars: [], spo2Bars: [], stressBars: []
  },
  onInit() {
    var self = this
    this.controller = createHealthController(function (model) { self.acceptModel(model) })
    pageRuntime.bind(this, { contentWidth: function (profile) { return healthDesign.contentWidth(profile) } }, function (profile, scene, safe) {
      var plan = healthDesign.resolve(profile, scene, safe)
      self.designPlan = plan; self.contentWidth = safe.width
      self.isCircle = plan.shape === 'circle'; self.isPill = plan.shape === 'pill'; self.isRect = plan.shape === 'rect'; self.ready = true
      if (self.pageVisible) self.controller.start()
    })
  },
  onShow() { this.pageVisible = true; if (this.ready && this.controller) this.controller.start() },
  onHide() { this.pageVisible = false; if (this.controller) this.controller.stop() },
  onDestroy() { this.pageVisible = false; if (this.controller) this.controller.stop(); this.healthModel = null; this.heartBars = []; this.spo2Bars = []; this.stressBars = [] },
  onBackPress() { navigation.back(); return true },
  acceptModel(model) { this.healthModel = model; if (this.designPlan) this.applyModel(healthView.project(model, this.designPlan)) },
  applyModel(model) {
    this.heartRate = model.heartRate; this.spo2 = model.spo2; this.stress = model.stress; this.dailyMin = model.dailyMin; this.dailyMax = model.dailyMax
    this.heartStatus = model.heartStatus; this.heartStatusColor = model.heartStatusColor; this.spo2Status = model.spo2Status; this.spo2StatusColor = model.spo2StatusColor; this.stressStatus = model.stressStatus; this.stressStatusColor = model.stressStatusColor
    this.summaryText = model.summaryText; this.summaryColor = model.summaryColor; this.heartSource = model.heartSource; this.spo2Source = model.spo2Source; this.stressSource = model.stressSource; this.sourceText = model.sourceText; this.updatedAtText = model.updatedAtText
    this.heartTrendText = model.heartTrendText; this.spo2TrendText = model.spo2TrendText; this.stressTrendText = model.stressTrendText; this.heartRangeText = model.heartRangeText; this.spo2RangeText = model.spo2RangeText; this.stressRangeText = model.stressRangeText
    this.stressMin = model.stressMin; this.stressAvg = model.stressAvg; this.stressMax = model.stressMax; this.heartBars = model.heartBars; this.spo2Bars = model.spo2Bars; this.stressBars = model.stressBars
  }
}
</script>

<style>
.health-root, .health-scene { background-color: #000000; } .health-scene { position: absolute; left: 0px; top: 0px; }
.trend-row { flex-direction: row; align-items: flex-end; justify-content: space-between; } .trend-bar { width: 5px; border-radius: 3px; } .trend-bar.wide { width: 7px; }
.circle-health { position: absolute; left: 0px; top: 0px; flex-direction: column; align-items: center; padding-top: 16px; padding-bottom: 28px; background-color: #000000; }
.circle-title { width: 120px; height: 18px; font-size: 12px; color: #FFFFFF; font-weight: bold; text-align: center; }
.circle-summary { width: 120px; height: 18px; margin-top: 1px; border-radius: 9px; background-color: #101215; padding-left: 9px; padding-right: 9px; flex-direction: row; justify-content: space-between; align-items: center; } .circle-summary-text { font-size: 6px; font-weight: bold; } .circle-summary-source { font-size: 5px; color: #636366; }
.circle-hero { width: 144px; height: 98px; margin-top: 4px; border-radius: 22px; background-color: #211015; padding: 8px 10px; flex-direction: column; }
.hero-head, .card-head { width: 100%; flex-direction: row; justify-content: space-between; align-items: center; } .hero-label { font-size: 8px; color: #FF375F; font-weight: bold; } .hero-source { font-size: 6px; color: #8E8E93; }
.hero-value-row { width: 124px; height: 28px; flex-direction: row; align-items: flex-end; } .hero-value { font-size: 25px; color: #FFFFFF; font-weight: bold; } .hero-unit { font-size: 6px; color: #8E8E93; margin-left: 3px; margin-bottom: 4px; } .hero-status { font-size: 6px; margin-left: 7px; margin-bottom: 4px; }
.circle-trend { width: 124px; height: 24px; margin-top: 1px; } .hero-footer { width: 124px; height: 8px; font-size: 5px; color: #8E8E93; margin-top: 2px; }
.circle-mini-row { width: 148px; height: 50px; margin-top: 8px; flex-direction: row; justify-content: space-between; } .circle-mini { width: 71px; height: 50px; border-radius: 15px; padding: 6px 7px; flex-direction: column; } .spo2-mini { background-color: #102129; } .stress-mini { background-color: #211226; }
.mini-head { width: 57px; height: 9px; flex-direction: row; justify-content: space-between; align-items: center; } .mini-label { font-size: 6px; font-weight: bold; } .mini-source { font-size: 5px; color: #636366; } .mini-value { font-size: 15px; color: #FFFFFF; font-weight: bold; margin-top: 2px; } .mini-status { font-size: 5px; }
.circle-detail { width: 148px; height: 58px; margin-top: 8px; border-radius: 16px; background-color: #101215; padding: 7px 9px; flex-direction: column; } .detail-head { width: 130px; height: 9px; flex-direction: row; justify-content: space-between; } .detail-title { font-size: 6px; color: #D1D1D6; font-weight: bold; } .detail-meta { font-size: 5px; color: #636366; } .compact-trend { width: 130px; height: 24px; margin-top: 3px; } .detail-foot { width: 130px; font-size: 5px; color: #8E8E93; }
.pill-health { position: absolute; flex-direction: column; } .pill-head { width: 168px; height: 52px; flex-direction: row; justify-content: space-between; align-items: center; } .pill-title { font-size: 18px; color: #FFFFFF; font-weight: bold; } .pill-subtitle { font-size: 8px; color: #636366; margin-top: 2px; } .pill-head-right { width: 76px; flex-direction: column; align-items: flex-end; } .pill-summary { font-size: 9px; font-weight: bold; text-align: right; } .pill-source { font-size: 7px; color: #636366; margin-top: 3px; text-align: right; }
.pill-card { width: 168px; height: 110px; border-radius: 22px; padding: 11px 12px; margin-bottom: 10px; flex-direction: column; } .heart-card { background-color: #211015; } .spo2-card { background-color: #102129; } .stress-card { background-color: #211226; }
.card-title { font-size: 11px; color: #FFFFFF; font-weight: bold; } .card-source { font-size: 7px; color: #8E8E93; } .card-value-row { height: 34px; flex-direction: row; align-items: flex-end; } .card-value { font-size: 29px; font-weight: bold; } .heart-color { color: #FF375F; } .spo2-color { color: #5AC8FA; } .stress-color { color: #BF5AF2; } .card-unit { font-size: 8px; color: #8E8E93; margin-left: 4px; margin-bottom: 5px; } .card-status { font-size: 8px; margin-left: 8px; margin-bottom: 5px; }
.pill-trend { width: 144px; height: 38px; } .card-foot { width: 144px; font-size: 7px; color: #8E8E93; margin-top: 2px; lines: 1; } .updated { width: 168px; font-size: 7px; color: #636366; text-align: center; margin-bottom: 8px; }
.rect-health { position: absolute; flex-direction: column; } .rect-head { width: 164px; height: 36px; flex-direction: row; justify-content: space-between; align-items: center; } .rect-title { font-size: 16px; color: #FFFFFF; font-weight: bold; } .rect-sub, .rect-updated { font-size: 7px; color: #8E8E93; } .rect-head-right { width: 76px; flex-direction: column; align-items: flex-end; } .rect-summary { font-size: 8px; font-weight: bold; text-align: right; }
.rect-heart { width: 164px; height: 72px; border-radius: 18px; background-color: #211015; padding: 9px; flex-direction: row; justify-content: space-between; } .rect-heart-left { width: 82px; flex-direction: column; } .rect-label-row { width: 100%; height: 10px; flex-direction: row; justify-content: space-between; align-items: center; } .rect-label { font-size: 7px; font-weight: bold; } .rect-trend-meta { font-size: 5px; color: #636366; } .rect-heart-value-row { height: 31px; flex-direction: row; align-items: flex-end; } .rect-heart-value { font-size: 27px; color: #FF375F; font-weight: bold; } .rect-unit { font-size: 6px; color: #8E8E93; margin-left: 3px; margin-bottom: 4px; } .rect-status { font-size: 5px; lines: 1; }
.rect-heart-trend { width: 62px; height: 44px; align-self: flex-end; } .rect-mini-row { width: 164px; height: 94px; margin-top: 8px; flex-direction: row; justify-content: space-between; } .rect-mini { width: 78px; height: 94px; border-radius: 17px; padding: 8px; flex-direction: column; } .rect-mini-value { font-size: 23px; font-weight: bold; margin-top: 5px; } .rect-mini-trend { width: 62px; height: 28px; margin-top: 5px; }
</style>
