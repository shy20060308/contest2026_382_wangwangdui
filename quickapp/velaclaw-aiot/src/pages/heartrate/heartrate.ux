<template>
  <stack class="health-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <stack class="health-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <scroll class="circle-health" if="{{ ready && isCircle }}" scroll-y="true" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <text class="circle-title">健康</text>
        <div class="circle-hero"><div class="hero-head"><text class="hero-label">心率</text><text class="hero-source">{{ heartSource }}</text></div><div class="hero-value-row"><text class="hero-value">{{ heartRate }}</text><text class="hero-unit">bpm</text><text class="hero-status" style="color: {{ heartStatusColor }};">{{ heartStatus }}</text></div><div class="trend-row circle-trend"><div class="trend-bar" for="{{ heartBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="hero-footer">今日 {{ dailyMin }}–{{ dailyMax }} bpm</text></div>
        <div class="circle-mini-row"><div class="circle-mini"><text class="mini-label">血氧</text><text class="mini-value">{{ spo2 }}%</text><text class="mini-status" style="color: {{ spo2StatusColor }};">{{ spo2Status }}</text></div><div class="circle-mini"><text class="mini-label">压力</text><text class="mini-value">{{ stress }}</text><text class="mini-status" style="color: {{ stressStatusColor }};">{{ stressStatus }}</text></div></div>
        <div class="circle-detail"><text class="detail-title">血氧趋势 · {{ spo2Source }}</text><div class="trend-row compact-trend"><div class="trend-bar" for="{{ spo2Bars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div></div>
        <div class="circle-detail"><text class="detail-title">压力趋势 · {{ stressSource }}</text><div class="trend-row compact-trend"><div class="trend-bar" for="{{ stressBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="detail-foot">{{ stressMin }} / {{ stressAvg }} / {{ stressMax }}</text></div>
      </scroll>

      <scroll class="pill-health" if="{{ ready && isPill }}" scroll-y="true" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <div class="pill-head"><div><text class="pill-title">健康状态</text><text class="pill-subtitle">心率 · 血氧 · 压力</text></div><text class="pill-source">{{ sourceText }}</text></div>
        <div class="pill-card heart-card"><div class="card-head"><text class="card-title">心率</text><text class="card-source">{{ heartSource }}</text></div><div class="card-value-row"><text class="card-value heart-color">{{ heartRate }}</text><text class="card-unit">bpm</text><text class="card-status" style="color: {{ heartStatusColor }};">{{ heartStatus }}</text></div><div class="trend-row pill-trend"><div class="trend-bar wide" for="{{ heartBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="card-foot">今日范围 {{ dailyMin }}–{{ dailyMax }} bpm</text></div>
        <div class="pill-card spo2-card"><div class="card-head"><text class="card-title">血氧</text><text class="card-source">{{ spo2Source }}</text></div><div class="card-value-row"><text class="card-value spo2-color">{{ spo2 }}</text><text class="card-unit">%</text><text class="card-status" style="color: {{ spo2StatusColor }};">{{ spo2Status }}</text></div><div class="trend-row pill-trend"><div class="trend-bar wide" for="{{ spo2Bars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="card-foot">参考区间 95–100%</text></div>
        <div class="pill-card stress-card"><div class="card-head"><text class="card-title">压力</text><text class="card-source">{{ stressSource }}</text></div><div class="card-value-row"><text class="card-value stress-color">{{ stress }}</text><text class="card-unit">/100</text><text class="card-status" style="color: {{ stressStatusColor }};">{{ stressStatus }}</text></div><div class="trend-row pill-trend"><div class="trend-bar wide" for="{{ stressBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="card-foot">低 / 均 / 高  {{ stressMin }} / {{ stressAvg }} / {{ stressMax }}</text></div>
        <text class="updated">更新于 {{ updatedAtText }}</text>
      </scroll>

      <div class="rect-health" if="{{ ready && isRect }}" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <div class="rect-head"><div><text class="rect-title">健康</text><text class="rect-sub">{{ sourceText }}</text></div><text class="rect-updated">{{ updatedAtText }}</text></div>
        <div class="rect-heart"><div class="rect-heart-left"><text class="rect-label">心率</text><div class="rect-heart-value-row"><text class="rect-heart-value">{{ heartRate }}</text><text class="rect-unit">bpm</text></div><text class="rect-status" style="color: {{ heartStatusColor }};">{{ heartStatus }} · {{ dailyMin }}–{{ dailyMax }}</text></div><div class="trend-row rect-heart-trend"><div class="trend-bar" for="{{ heartBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div></div>
        <div class="rect-mini-row"><div class="rect-mini spo2-card"><text class="rect-label">血氧 · {{ spo2Source }}</text><text class="rect-mini-value spo2-color">{{ spo2 }}%</text><text class="rect-status" style="color: {{ spo2StatusColor }};">{{ spo2Status }}</text><div class="trend-row rect-mini-trend"><div class="trend-bar" for="{{ spo2Bars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div></div><div class="rect-mini stress-card"><text class="rect-label">压力 · {{ stressSource }}</text><text class="rect-mini-value stress-color">{{ stress }}</text><text class="rect-status" style="color: {{ stressStatusColor }};">{{ stressStatus }}</text><div class="trend-row rect-mini-trend"><div class="trend-bar" for="{{ stressBars }}" tid="index" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div></div></div>
      </div>
    </stack>
  </stack>
</template>

<script>
import pageRuntime from '../../v2/app/page_runtime'
import navigation from '../../v2/app/navigation'
import { createHealthController } from '../../v2/features/health/controller'

export default {
  private: {
    ready: false, isCircle: false, isPill: false, isRect: false, contentWidth: 148,
    sceneWidth: 192, sceneHeight: 192, sceneSafeLeft: 22, sceneSafeTop: 35, sceneSafeHeight: 120,
    viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%',
    heartRate: 88, spo2: 97, stress: 28, dailyMin: 48, dailyMax: 95,
    heartStatus: '正常', heartStatusColor: '#30D158', spo2Status: '良好', spo2StatusColor: '#30D158', stressStatus: '放松', stressStatusColor: '#30D158',
    heartSource: '演示', spo2Source: '演示', stressSource: '演示', sourceText: '兼容演示数据', updatedAtText: '--:--',
    stressMin: 18, stressAvg: 25, stressMax: 31, heartBars: [], spo2Bars: [], stressBars: []
  },
  onInit() {
    var self = this
    this.controller = createHealthController(function (model) { self.applyModel(model) })
    pageRuntime.bind(this, { contentWidth: function (profile) { return profile.formFactor === 'circle' ? 148 : (profile.formFactor === 'rect' ? 164 : 168) } }, function (profile, scene, safe) {
      self.contentWidth = safe.width; self.isCircle = profile.formFactor === 'circle'; self.isPill = profile.formFactor === 'pill'; self.isRect = profile.formFactor === 'rect'; self.ready = true
      self.controller.start(profile.formFactor === 'pill' ? 42 : (profile.formFactor === 'rect' ? 30 : 24))
    })
  },
  onShow() { if (this.controller) this.controller.refresh() },
  onHide() { if (this.controller) this.controller.stop() },
  onDestroy() { if (this.controller) this.controller.stop(); this.heartBars = []; this.spo2Bars = []; this.stressBars = [] },
  onBackPress() { navigation.back(); return true },
  applyModel(model) {
    this.heartRate = model.heartRate; this.spo2 = model.spo2; this.stress = model.stress; this.dailyMin = model.dailyMin; this.dailyMax = model.dailyMax
    this.heartStatus = model.heartStatus; this.heartStatusColor = model.heartStatusColor; this.spo2Status = model.spo2Status; this.spo2StatusColor = model.spo2StatusColor; this.stressStatus = model.stressStatus; this.stressStatusColor = model.stressStatusColor
    this.heartSource = model.heartSource; this.spo2Source = model.spo2Source; this.stressSource = model.stressSource; this.sourceText = model.sourceText; this.updatedAtText = model.updatedAtText
    this.stressMin = model.stressMin; this.stressAvg = model.stressAvg; this.stressMax = model.stressMax; this.heartBars = model.heartBars; this.spo2Bars = model.spo2Bars; this.stressBars = model.stressBars
  }
}
</script>

<style>
.health-root, .health-scene { background-color: #000000; } .health-scene { position: absolute; left: 0px; top: 0px; }
.trend-row { flex-direction: row; align-items: flex-end; justify-content: space-between; } .trend-bar { width: 5px; border-radius: 3px; } .trend-bar.wide { width: 7px; }
.circle-health { position: absolute; flex-direction: column; } .circle-title { width: 148px; height: 18px; font-size: 12px; color: #FFFFFF; font-weight: bold; text-align: center; }
.circle-hero { width: 148px; height: 74px; border-radius: 20px; background-color: #211015; padding: 8px 10px; flex-direction: column; }
.hero-head, .card-head { width: 100%; flex-direction: row; justify-content: space-between; align-items: center; } .hero-label { font-size: 8px; color: #FF375F; font-weight: bold; } .hero-source { font-size: 6px; color: #8E8E93; }
.hero-value-row { height: 27px; flex-direction: row; align-items: flex-end; } .hero-value { font-size: 23px; color: #FFFFFF; font-weight: bold; } .hero-unit { font-size: 6px; color: #8E8E93; margin-left: 3px; margin-bottom: 4px; } .hero-status { font-size: 6px; margin-left: 7px; margin-bottom: 4px; }
.circle-trend { width: 128px; height: 24px; } .hero-footer { font-size: 5px; color: #8E8E93; }
.circle-mini-row { width: 148px; height: 44px; margin-top: 6px; flex-direction: row; justify-content: space-between; } .circle-mini { width: 71px; height: 44px; border-radius: 15px; background-color: #15171B; padding: 6px; flex-direction: column; }
.mini-label { font-size: 6px; color: #8E8E93; } .mini-value { font-size: 15px; color: #FFFFFF; font-weight: bold; margin-top: 2px; } .mini-status { font-size: 5px; }
.circle-detail { width: 148px; height: 52px; margin-top: 6px; border-radius: 16px; background-color: #101215; padding: 7px 9px; flex-direction: column; } .detail-title { font-size: 6px; color: #D1D1D6; } .compact-trend { width: 130px; height: 24px; margin-top: 2px; } .detail-foot { font-size: 5px; color: #8E8E93; }
.pill-health { position: absolute; flex-direction: column; } .pill-head { width: 168px; height: 48px; flex-direction: row; justify-content: space-between; align-items: center; } .pill-title { font-size: 18px; color: #FFFFFF; font-weight: bold; } .pill-subtitle { font-size: 8px; color: #636366; margin-top: 2px; } .pill-source { font-size: 8px; color: #30D158; }
.pill-card { width: 168px; height: 116px; border-radius: 24px; padding: 12px; margin-bottom: 10px; flex-direction: column; } .heart-card { background-color: #211015; } .spo2-card { background-color: #102129; } .stress-card { background-color: #211226; }
.card-title { font-size: 11px; color: #FFFFFF; font-weight: bold; } .card-source { font-size: 8px; color: #8E8E93; } .card-value-row { height: 36px; flex-direction: row; align-items: flex-end; } .card-value { font-size: 30px; font-weight: bold; } .heart-color { color: #FF375F; } .spo2-color { color: #5AC8FA; } .stress-color { color: #BF5AF2; } .card-unit { font-size: 8px; color: #8E8E93; margin-left: 4px; margin-bottom: 5px; } .card-status { font-size: 8px; margin-left: 8px; margin-bottom: 5px; }
.pill-trend { width: 144px; height: 42px; } .card-foot { font-size: 7px; color: #8E8E93; margin-top: 2px; } .updated { width: 168px; font-size: 7px; color: #636366; text-align: center; margin-bottom: 8px; }
.rect-health { position: absolute; flex-direction: column; } .rect-head { width: 164px; height: 34px; flex-direction: row; justify-content: space-between; align-items: center; } .rect-title { font-size: 16px; color: #FFFFFF; font-weight: bold; } .rect-sub, .rect-updated { font-size: 7px; color: #8E8E93; }
.rect-heart { width: 164px; height: 72px; border-radius: 18px; background-color: #211015; padding: 9px; flex-direction: row; justify-content: space-between; } .rect-heart-left { width: 76px; flex-direction: column; } .rect-label { font-size: 7px; color: #8E8E93; } .rect-heart-value-row { height: 32px; flex-direction: row; align-items: flex-end; } .rect-heart-value { font-size: 27px; color: #FF375F; font-weight: bold; } .rect-unit { font-size: 6px; color: #8E8E93; margin-left: 3px; margin-bottom: 4px; } .rect-status { font-size: 6px; }
.rect-heart-trend { width: 68px; height: 46px; align-self: flex-end; } .rect-mini-row { width: 164px; height: 94px; margin-top: 8px; flex-direction: row; justify-content: space-between; } .rect-mini { width: 78px; height: 94px; border-radius: 17px; padding: 8px; flex-direction: column; } .rect-mini-value { font-size: 23px; font-weight: bold; margin-top: 5px; } .rect-mini-trend { width: 62px; height: 30px; margin-top: 5px; }
</style>
