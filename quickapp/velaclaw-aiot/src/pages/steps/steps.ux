<template>
  <div class="steps-page {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @touchstart="onTouchStart" @touchend="onTouchEnd">
    <text class="page-title" static style="position: absolute; left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px; font-size: {{ titleFontSize }}px;">运动</text>

    <div class="history-entry" @click="goToHistory" style="position: absolute; left: {{ historyLeft }}px; top: {{ historyTop }}px; width: {{ historyWidth }}px; height: {{ historyHeight }}px; border-radius: {{ historyRadius }}px; padding-left: {{ historyPadding }}px; padding-right: {{ historyPadding }}px;">
      <text class="history-title" static style="font-size: {{ historyTitleFontSize }}px;">7日趋势</text>
      <text class="history-sub" static style="font-size: {{ historySubFontSize }}px;">查看历史记录</text>
    </div>

    <scroll class="metric-scroll" scroll-y="true" style="position: absolute; left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
      <div for="{{ metrics }}" class="metric-section" tid="name" style="width: {{ metricWidth }}px; margin-bottom: {{ metricGap }}px;">
        <div class="ml-row">
          <text class="ml-label" style="font-size: {{ labelFontSize }}px; color: {{ $item.color }}">{{ $item.name }}</text>
        </div>
        <text class="mc-val" style="font-size: {{ valueFontSize }}px; line-height: {{ valueLineHeight }}px; color: {{ $item.color }}">{{ $item.current }}</text>
        <text class="mg-val" style="font-size: {{ goalFontSize }}px; line-height: {{ goalLineHeight }}px; color: #888888;">/ {{ $item.goal }} {{ $item.unit }}</text>
        <div class="chart-area">
          <div class="cb-row">
            <div class="bc" for="{{ $item.bars }}" tid="t" style="width: {{ barColumnWidth }}px;">
              <div class="bar-space" style="width: {{ barColumnWidth }}px; height: {{ chartHeight }}px;">
                <div class="bar-inner" style="width: {{ barWidth }}px; height: {{ $item.h }}px; background-color: {{ $item.color }};"></div>
              </div>
              <text class="bl" style="width: {{ barColumnWidth }}px; font-size: {{ tickFontSize }}px;">{{ $item.t }}</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import activityStore from '../../domain/activity/store'
import { mapStepsMetrics } from '../../presentation/mappers/steps'
import pageMotion from '../../common/page_motion'
import swipeBack from '../../common/swipe_back'
import layoutRuntime from '../../presentation/layout/runtime'
import scrollFlow from '../../presentation/layout/scroll_flow'
import stepsLayout from '../../presentation/layout/specs/steps'

function region(plan, id) {
  var list = plan && plan.regions ? plan.regions : []
  for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i]
  return null
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value))
}

export default {
  private: {
    metrics: [],
    chartHeight: 56,
    headerLeft: 36, headerTop: 23, headerWidth: 120, headerHeight: 22,
    historyLeft: 22, historyTop: 49, historyWidth: 148, historyHeight: 30,
    streamLeft: 22, streamTop: 83, streamWidth: 148, streamHeight: 70,
    metricWidth: 148, metricGap: 8,
    titleFontSize: 14, historyRadius: 15, historyPadding: 10, historyTitleFontSize: 9, historySubFontSize: 7,
    labelFontSize: 8, valueFontSize: 22, valueLineHeight: 24, goalFontSize: 8, goalLineHeight: 10,
    barColumnWidth: 18.5, barWidth: 10, tickFontSize: 7,
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px'
  },

  onInit() {
    var self = this
    layoutRuntime.bind(this, function (profile) {
      return scrollFlow.resolve(profile, stepsLayout)
    }, function (plan) {
      self.applyLayout(plan)
      self.loadCurrentData()
    })
  },

  onShow() {
    pageMotion.enter(this)
    this.loadCurrentData()
  },

  onHide() {
    pageMotion.clear(this)
    this.releaseMetrics()
  },

  onDestroy() {
    pageMotion.clear(this)
    this.releaseMetrics()
  },

  applyLayout(plan) {
    var header = region(plan, 'header')
    var history = region(plan, 'history')
    if (header) {
      this.headerLeft = header.left
      this.headerTop = header.top
      this.headerWidth = header.width
      this.headerHeight = header.height
    }
    if (history) {
      this.historyLeft = history.left
      this.historyTop = history.top
      this.historyWidth = history.width
      this.historyHeight = history.height
    }
    if (plan.stream) {
      this.streamLeft = plan.stream.left
      this.streamTop = plan.stream.top
      this.streamWidth = plan.stream.width
      this.streamHeight = plan.stream.viewportHeight
      this.metricWidth = plan.stream.width
      this.metricGap = plan.stream.gap
    }

    var scale = plan.scale || 1
    var tokens = plan.tokens || {}
    this.titleFontSize = clamp(Math.round(14 * scale), 12, 18)
    this.historyRadius = Math.round(this.historyHeight / 2)
    this.historyPadding = clamp(Math.round(10 * scale), 8, 12)
    this.historyTitleFontSize = clamp(Math.round(9 * scale), 8, 12)
    this.historySubFontSize = clamp(Math.round(7 * scale), 6, 10)
    this.labelFontSize = clamp(Math.round(8 * scale), 7, 11)
    this.valueFontSize = clamp(Math.round(22 * scale), 19, 30)
    this.valueLineHeight = this.valueFontSize + 2
    this.goalFontSize = clamp(Math.round(8 * scale), 7, 12)
    this.goalLineHeight = this.goalFontSize + 2
    this.chartHeight = clamp(
      Math.round((plan.stream ? plan.stream.itemHeight : 118) * (tokens.chartRatio || 0.5)),
      tokens.minChartHeight || 48,
      tokens.maxChartHeight || 68
    )
    this.barColumnWidth = Math.round((this.metricWidth / 8) * 100) / 100
    this.barWidth = clamp(Math.round(this.barColumnWidth * 0.56), 9, 13)
    this.tickFontSize = clamp(Math.round(7 * scale), 6, 9)
  },

  loadCurrentData() {
    var self = this
    this.metrics = mapStepsMetrics(activityStore.getSnapshot(), this.chartHeight)
    activityStore.hydrate(function (snapshot) {
      self.metrics = mapStepsMetrics(snapshot, self.chartHeight)
    })
  },

  releaseMetrics() {
    this.metrics = []
  },

  goToHistory() {
    pageMotion.push(this, router, '/pages/history')
  },

  onTouchStart(e) {
    swipeBack.start(this, e)
  },

  onTouchEnd(e) {
    swipeBack.end(this, e, router)
  }
}
</script>

<style>
.steps-page { width: 100%; height: 100%; background-color: #000000; }
.page-title { font-weight: bold; color: #FFD60A; text-align: center; }
.history-entry { flex-direction: row; justify-content: space-between; align-items: center; background-color: #14181F; }
.history-title { color: #FFFFFF; font-weight: bold; }
.history-sub { color: #8E8E93; }
.metric-scroll { flex-direction: column; }
.metric-section { flex-direction: column; }
.ml-row { flex-direction: row; align-items: center; }
.ml-label { font-weight: bold; }
.mc-val { font-weight: bold; }
.chart-area { flex-direction: column; }
.cb-row { flex-direction: row; align-items: flex-start; }
.bc { flex-direction: column; align-items: center; }
.bar-space { flex-direction: column; align-items: center; justify-content: flex-end; }
.bar-inner { border-radius: 2px; }
.bl { color: #666666; text-align: center; margin-top: 2px; }
</style>
