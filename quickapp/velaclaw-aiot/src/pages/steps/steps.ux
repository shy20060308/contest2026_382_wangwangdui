<template>
  <stack class="steps-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="steps-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <text class="steps-title" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; font-size: {{ titleSize }}px;">运动</text>
      <div class="history-entry" @click="goToHistory" style="left: {{ sceneSafeLeft }}px; top: {{ historyTop }}px; width: {{ contentWidth }}px; height: {{ historyHeight }}px; border-radius: {{ historyRadius }}px;">
        <text class="history-title" style="font-size: {{ historyTitleSize }}px;">7日趋势</text><text class="history-sub" style="font-size: {{ historySubSize }}px;">查看历史记录 ›</text>
      </div>
      <scroll class="metric-scroll" scroll-y="true" style="left: {{ sceneSafeLeft }}px; top: {{ streamTop }}px; width: {{ contentWidth }}px; height: {{ streamHeight }}px;">
        <div class="metric-card" for="{{ metrics }}" tid="id" style="width: {{ contentWidth }}px; min-height: {{ metricHeight }}px; margin-bottom: {{ metricGap }}px; border-radius: {{ metricRadius }}px;">
          <div class="metric-head"><text class="metric-name" style="font-size: {{ labelSize }}px; color: {{ $item.color }};">{{ $item.name }}</text><text class="metric-goal" style="font-size: {{ goalSize }}px;">目标 {{ $item.goal }} {{ $item.unit }}</text></div>
          <text class="metric-value" style="font-size: {{ valueSize }}px; color: {{ $item.color }};">{{ $item.current }}</text>
          <div class="chart-row">
            <div class="bar-column" for="{{ $item.bars }}" tid="t" style="width: {{ barColumnWidth }}px;">
              <div class="bar-space" style="height: {{ chartHeight }}px; width: {{ barColumnWidth }}px;"><div class="bar" style="height: {{ $item.h }}px; width: {{ barWidth }}px; background-color: {{ $item.color }};"></div></div>
              <text class="bar-label" style="width: {{ barColumnWidth }}px; font-size: {{ tickSize }}px;">{{ $item.t }}</text>
            </div>
          </div>
        </div>
      </scroll>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../v2/app/page_runtime'
import navigation from '../../v2/app/navigation'
import { createActivityController } from '../../v2/features/activity/controller'

function clamp(value, min, max) { return Math.max(min, Math.min(max, value)) }

export default {
  private: {
    metrics: [], contentWidth: 148,
    titleSize: 14, historyTop: 52, historyHeight: 34, historyRadius: 17, historyTitleSize: 9, historySubSize: 7,
    streamTop: 92, streamHeight: 80, metricHeight: 118, metricGap: 9, metricRadius: 18,
    labelSize: 9, goalSize: 7, valueSize: 24, chartHeight: 52, barColumnWidth: 18, barWidth: 10, tickSize: 6,
    sceneWidth: 192, sceneHeight: 192, sceneSafeLeft: 22, sceneSafeTop: 35, sceneSafeHeight: 120,
    viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createActivityController(function (metrics) { self.metrics = metrics })
    pageRuntime.bind(this, { contentWidth: function (profile) { return profile.formFactor === 'circle' ? 148 : (profile.formFactor === 'rect' ? 164 : 168) } }, function (profile, scene, safe) {
      self.contentWidth = safe.width
      var tall = safe.height > 250
      var compact = safe.height < 170
      self.titleSize = compact ? 13 : (tall ? 17 : 15)
      self.historyHeight = compact ? 30 : (tall ? 42 : 34)
      self.historyRadius = Math.round(self.historyHeight / 2)
      self.historyTitleSize = compact ? 8 : (tall ? 11 : 9)
      self.historySubSize = compact ? 6 : (tall ? 9 : 7)
      self.historyTop = safe.top + (compact ? 24 : 30)
      self.streamTop = self.historyTop + self.historyHeight + (compact ? 5 : 8)
      self.streamHeight = Math.max(40, safe.bottom - self.streamTop)
      self.metricHeight = compact ? 100 : (tall ? 142 : 118)
      self.metricGap = compact ? 6 : 10
      self.metricRadius = compact ? 15 : 20
      self.labelSize = compact ? 8 : (tall ? 11 : 9)
      self.goalSize = compact ? 6 : (tall ? 9 : 7)
      self.valueSize = compact ? 20 : (tall ? 30 : 24)
      self.chartHeight = clamp(Math.round(self.metricHeight * 0.42), 40, 62)
      self.barColumnWidth = Math.round((self.contentWidth / 8) * 100) / 100
      self.barWidth = clamp(Math.round(self.barColumnWidth * 0.55), 9, 13)
      self.tickSize = compact ? 5 : 7
      self.controller.start(self.chartHeight)
    })
  },
  onShow() { if (this.controller) this.controller.refresh() },
  onHide() { this.metrics = [] },
  onDestroy() { this.metrics = [] },
  onBackPress() { navigation.back(); return true },
  goToHistory() { navigation.push('/pages/history') }
}
</script>

<style>
.steps-root, .steps-scene { background-color: #000000; }
.steps-scene { position: absolute; left: 0px; top: 0px; }
.steps-title { position: absolute; height: 22px; color: #FFD60A; font-weight: bold; text-align: center; }
.history-entry { position: absolute; background-color: #15171B; flex-direction: row; justify-content: space-between; align-items: center; padding-left: 12px; padding-right: 12px; }
.history-title { color: #FFFFFF; font-weight: bold; } .history-sub { color: #8E8E93; }
.metric-scroll { position: absolute; flex-direction: column; }
.metric-card { background-color: #101215; padding: 12px; flex-direction: column; }
.metric-head { width: 100%; height: 18px; flex-direction: row; justify-content: space-between; align-items: center; }
.metric-name { font-weight: bold; } .metric-goal { color: #8E8E93; }
.metric-value { height: 34px; font-weight: bold; margin-top: 2px; }
.chart-row { width: 100%; flex-direction: row; justify-content: center; align-items: flex-start; margin-top: 4px; }
.bar-column { flex-direction: column; align-items: center; }
.bar-space { flex-direction: column; align-items: center; justify-content: flex-end; }
.bar { border-radius: 3px; }
.bar-label { color: #636366; text-align: center; margin-top: 2px; }
</style>
