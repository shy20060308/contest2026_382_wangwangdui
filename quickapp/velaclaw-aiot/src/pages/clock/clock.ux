<import name="surfacehost" src="../../components/surface_host_stage.ux"></import>

<template>
  <stack class="stage-probe">
    <surfacehost if="{{ stageReady }}" plan="{{ stagePlan }}"></surfacehost>

    <div class="direct-model" if="{{ stageModelPresent }}">
      <text class="direct-model-title">MODEL OK</text>
      <text class="direct-model-text">{{ firstStageText }}</text>
      <text class="direct-model-counts">{{ stageCounts }}</text>
    </div>

    <div class="probe-banner">
      <text class="probe-title">{{ probeStatus }}</text>
      <text class="probe-detail">{{ probeDetail }}</text>
    </div>
  </stack>
</template>

<script>
var surfaceRuntime = require('../../product/frontend/runtime/surface_runtime')
var experienceRuntime = require('../../product/frontend/runtime/experience_runtime')
var surface = require('../../product/frontend/surfaces/clock.json')

export default {
  private: {
    stageReady: false,
    stagePlan: null,
    stageModelPresent: false,
    firstStageText: '',
    stageCounts: '',
    probeStatus: 'STAGE PROBE:init',
    probeDetail: 'fixed rect profile; no device/controller'
  },
  onInit() {
    try {
      this.probeStatus = 'STAGE PROBE:resolve'
      var profile = {
        shape: 'rect',
        formFactor: 'rect',
        isCircle: false,
        isPill: false,
        isRect: true,
        screenWidth: 336,
        screenHeight: 480,
        safeInsets: { left: 0, top: 2, right: 0, bottom: 2, gestureBar: 0 }
      }
      var scene = { width: 192, height: 275, hostTop: 0, hostBottom: 275, shape: 'rect' }
      var safe = { left: 0, top: 2, right: 192, bottom: 273, width: 192, height: 271, gestureBar: 0 }
      var state = {
        faceId: 'sport',
        timestamp: Date.now(),
        batteryPercent: 88,
        currentHeartRate: 76,
        steps: 9999,
        stepsGoal: 12000,
        goalPercent: 83,
        stepsPercent: 83,
        powerMode: 'ACTIVE',
        clockVisible: true,
        sleepVisible: false,
        notificationAppVisible: false,
        notificationCallVisible: false
      }
      var plan = surfaceRuntime.resolve(surface, profile, scene, safe, state)
      this.probeStatus = 'STAGE PROBE:decorate'
      this.stagePlan = experienceRuntime.decorate(plan, surface, profile, scene, safe, state)
      var stage = this.stagePlan && this.stagePlan.stage ? this.stagePlan.stage : null
      this.stageModelPresent = !!stage
      if (stage) {
        var textCount = stage.texts ? stage.texts.length : 0
        var metricCount = stage.metrics ? stage.metrics.length : 0
        var progressCount = stage.progresses ? stage.progresses.length : 0
        var panelCount = stage.panels ? stage.panels.length : 0
        this.stageCounts = 't' + textCount + ' m' + metricCount + ' p' + progressCount + ' b' + panelCount
        this.firstStageText = textCount ? String(stage.texts[0].text || '') : '(no stage text)'
      } else {
        this.stageCounts = 'stage=null'
        this.firstStageText = '(no stage model)'
      }
      this.stageReady = true
      this.probeStatus = 'STAGE PROBE:ready'
      this.probeDetail = this.stageModelPresent ? 'model generated; nested renderer below' : 'decorate returned no stage'
      console.log('STAGE PROBE:ready ' + this.stageCounts + ' first=' + this.firstStageText)
    } catch (error) {
      this.stageReady = false
      this.stageModelPresent = false
      this.probeStatus = 'STAGE PROBE:error'
      this.probeDetail = error && error.message ? error.message : String(error)
      console.log('STAGE PROBE:error ' + this.probeDetail)
    }
  }
}
</script>

<style>
.stage-probe {
  width: 192px;
  height: 275px;
  background-color: #000000;
}
.direct-model {
  position: absolute;
  left: 18px;
  top: 72px;
  width: 156px;
  height: 84px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background-color: #17324D;
}
.direct-model-title {
  width: 150px;
  height: 22px;
  line-height: 22px;
  font-size: 10px;
  text-align: center;
  color: #64D2FF;
}
.direct-model-text {
  width: 150px;
  height: 24px;
  line-height: 24px;
  font-size: 10px;
  text-align: center;
  color: #FFFFFF;
}
.direct-model-counts {
  width: 150px;
  height: 20px;
  line-height: 20px;
  font-size: 8px;
  text-align: center;
  color: #B8DFFF;
}
.probe-banner {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 192px;
  height: 36px;
  flex-direction: column;
  align-items: center;
  background-color: #202124;
}
.probe-title {
  width: 188px;
  height: 18px;
  line-height: 18px;
  font-size: 8px;
  text-align: center;
  color: #FFFFFF;
}
.probe-detail {
  width: 188px;
  height: 16px;
  line-height: 16px;
  font-size: 6px;
  text-align: center;
  color: #B0B3B8;
}
</style>
