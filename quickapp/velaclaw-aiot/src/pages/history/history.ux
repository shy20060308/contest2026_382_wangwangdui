<template>
  <stack class="history-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <stack class="history-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <scroll class="history-stream" if="{{ ready }}" scroll-y="true" style="left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
        <div class="history-head" style="width: {{ headerWidth }}px; height: {{ headerHeight }}px;">
          <div><text class="history-title" style="font-size: {{ titleSize }}px;">7日趋势</text><text class="history-subtitle" style="font-size: {{ subtitleSize }}px;">活动与健康摘要</text></div>
          <text class="goal" style="font-size: {{ summaryValueSize }}px;">{{ goalText }}</text>
        </div>

        <div class="summary-row" style="width: {{ streamWidth }}px; height: {{ summaryHeight }}px; margin-top: {{ cardGap }}px;">
          <div class="summary-card" style="width: {{ summaryWidth }}px; height: {{ summaryHeight }}px; border-radius: {{ cardRadius }}px;"><text class="summary-label" style="font-size: {{ summaryLabelSize }}px;">今日步数</text><text class="summary-value yellow" style="font-size: {{ summaryValueSize }}px;">{{ todayStepsText }}</text></div>
          <div class="summary-card" style="width: {{ summaryWidth }}px; height: {{ summaryHeight }}px; border-radius: {{ cardRadius }}px;"><text class="summary-label" style="font-size: {{ summaryLabelSize }}px;">日均步数</text><text class="summary-value blue" style="font-size: {{ summaryValueSize }}px;">{{ avgStepsText }}</text></div>
        </div>

        <div class="trend-card {{ trendMode }}" style="width: {{ streamWidth }}px; height: {{ trendHeight }}px; margin-top: {{ cardGap }}px; border-radius: {{ cardRadius }}px; padding-left: {{ trendPadding }}px; padding-right: {{ trendPadding }}px;">
          <div class="trend-head"><text class="trend-title">历史步数</text><text class="trend-caption">近7日</text></div>

          <div class="column-trend" if="{{ trendMode === 'compact-column' }}">
            <div class="column-cell" for="{{ bars }}" tid="date" style="width: {{ columnCellWidth }}px;">
              <div class="column-chart-area" style="height: {{ columnTrackHeight }}px;"><div class="column-fill" style="width: {{ columnBarWidth }}px; height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div>
              <text class="column-value {{ $item.isToday ? 'today-value' : '' }}" style="height: {{ columnValueLineHeight }}px; line-height: {{ columnValueLineHeight }}px; font-size: {{ columnValueSize }}px;">{{ $item.columnStepsText }}</text>
              <text class="column-weekday" style="height: {{ columnWeekdayLineHeight }}px; line-height: {{ columnWeekdayLineHeight }}px; font-size: {{ columnWeekdaySize }}px;">{{ $item.weekdayText }}</text>
              <text class="column-date" style="height: {{ columnDateLineHeight }}px; line-height: {{ columnDateLineHeight }}px; font-size: {{ columnDateSize }}px;">{{ $item.dateText }}</text>
            </div>
          </div>

          <div class="row-trend" if="{{ trendMode === 'comparative-row' }}">
            <div class="row-item" for="{{ bars }}" tid="date">
              <text class="row-label {{ $item.isToday ? 'today-text' : '' }}">{{ $item.displayLabel }}</text>
              <div class="row-track"><div class="row-fill" style="width: {{ $item.rowWidth }}px; background-color: {{ $item.color }};"></div></div>
              <text class="row-value {{ $item.isToday ? 'today-text' : '' }}">{{ $item.stepsText }}</text>
            </div>
          </div>
        </div>

        <div class="insight-row" style="width: {{ streamWidth }}px; height: {{ insightHeight }}px; margin-top: {{ cardGap }}px;">
          <div class="insight-card" style="width: {{ insightWidth }}px; height: {{ insightHeight }}px; border-radius: {{ cardRadius }}px;"><text class="insight-label" style="font-size: {{ insightLabelSize }}px;">最佳</text><text class="insight-value" style="font-size: {{ insightValueSize }}px;">{{ bestStepsText }}</text><text class="insight-detail">{{ bestDayText }}</text></div>
          <div class="insight-card" style="width: {{ insightWidth }}px; height: {{ insightHeight }}px; border-radius: {{ cardRadius }}px;"><text class="insight-label" style="font-size: {{ insightLabelSize }}px;">平均心率</text><text class="insight-value heart" style="font-size: {{ insightValueSize }}px;">{{ avgHeartText }}</text><text class="insight-detail">7日</text></div>
          <div class="insight-card" style="width: {{ insightWidth }}px; height: {{ insightHeight }}px; border-radius: {{ cardRadius }}px;"><text class="insight-label" style="font-size: {{ insightLabelSize }}px;">今日达成</text><text class="insight-value yellow" style="font-size: {{ insightValueSize }}px;">{{ goalText }}</text><text class="insight-detail">目标</text></div>
        </div>
      </scroll>
    </stack>
  </stack>
</template>

<script>
import pageRuntime from '../../v2/app/page_runtime'
import navigation from '../../v2/app/navigation'
import { createHistoryController } from '../../v2/features/history/controller'
import historyDesign from '../../v2/design/specs/history'
import historyView from '../../v2/design/views/history'

export default {
  private: {
    ready: false, designPlan: null, historyModel: null, trendMode: 'compact-column',
    streamLeft: 22, streamTop: 18, streamWidth: 148, streamHeight: 164, headerWidth: 116, headerHeight: 34, summaryHeight: 48, trendHeight: 116, insightHeight: 42,
    cardGap: 6, cardRadius: 18, summaryWidth: 71, insightWidth: 45, titleSize: 14, subtitleSize: 7, summaryLabelSize: 7, summaryValueSize: 15, insightLabelSize: 6, insightValueSize: 9,
    columnTrackHeight: 50, columnCellWidth: 20, columnBarWidth: 9, columnValueSize: 6, columnWeekdaySize: 6, columnDateSize: 5, columnValueLineHeight: 8, columnWeekdayLineHeight: 8, columnDateLineHeight: 7, trendPadding: 4,
    sceneWidth: 192, sceneHeight: 192, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%',
    todayStepsText: '0', avgStepsText: '0', bestStepsText: '0', bestDayText: '--', avgHeartText: '--', goalText: '0%', bars: []
  },
  onInit() {
    var self = this
    this.controller = createHistoryController(function (model) { self.acceptModel(model) })
    pageRuntime.bind(this, { contentWidth: function (profile) { return historyDesign.contentWidth(profile) } }, function (profile, scene, safe) {
      var plan = historyDesign.resolve(profile, scene, safe)
      self.designPlan = plan
      self.trendMode = plan.trendMode
      self.streamLeft = plan.stream.left; self.streamTop = plan.stream.top; self.streamWidth = plan.stream.width; self.streamHeight = plan.stream.height
      self.headerWidth = plan.headerWidth; self.headerHeight = plan.headerHeight; self.summaryHeight = plan.summaryHeight; self.trendHeight = plan.trendHeight; self.insightHeight = plan.insightHeight
      self.cardGap = plan.cardGap; self.cardRadius = plan.cardRadius; self.summaryWidth = plan.summaryWidth; self.insightWidth = plan.insightWidth
      self.titleSize = plan.titleSize; self.subtitleSize = plan.subtitleSize; self.summaryLabelSize = plan.summaryLabelSize; self.summaryValueSize = plan.summaryValueSize; self.insightLabelSize = plan.insightLabelSize; self.insightValueSize = plan.insightValueSize
      self.columnTrackHeight = plan.chartHeight; self.columnCellWidth = plan.columnCellWidth; self.columnBarWidth = plan.columnBarWidth; self.trendPadding = plan.trendPadding
      self.columnValueSize = plan.columnValueSize; self.columnWeekdaySize = plan.columnWeekdaySize; self.columnDateSize = plan.columnDateSize
      self.columnValueLineHeight = plan.columnValueLineHeight; self.columnWeekdayLineHeight = plan.columnWeekdayLineHeight; self.columnDateLineHeight = plan.columnDateLineHeight
      self.ready = true
      self.controller.load()
    })
  },
  onShow() { if (this.ready && this.controller) this.controller.load() },
  onHide() { this.bars = [] },
  onDestroy() { this.historyModel = null; this.bars = [] },
  onBackPress() { navigation.back(); return true },
  acceptModel(model) { this.historyModel = model; if (this.designPlan) this.applyModel(historyView.project(model, this.designPlan)) },
  applyModel(model) { this.todayStepsText = model.todayStepsText; this.avgStepsText = model.avgStepsText; this.bestStepsText = model.bestStepsText; this.bestDayText = model.bestDayText; this.avgHeartText = model.avgHeartText; this.goalText = model.goalText; this.bars = model.bars }
}
</script>

<style>
.history-root, .history-scene, .history-stream { background-color: #000000; }
.history-scene, .history-stream { position: absolute; }
.history-stream { flex-direction: column; align-items: center; padding-bottom: 18px; }
.history-head, .summary-row, .insight-row, .trend-head, .row-item { flex-direction: row; justify-content: space-between; align-items: center; }
.history-title { color: #FFFFFF; font-weight: bold; }
.history-subtitle, .trend-caption, .summary-label, .insight-label, .insight-detail { color: #8E8E93; }
.goal { color: #30D158; font-weight: bold; text-align: right; }
.summary-card, .insight-card { background-color: #111317; }
.summary-card { padding: 8px 9px; flex-direction: column; justify-content: center; }
.summary-value, .insight-value { font-weight: bold; margin-top: 4px; }
.yellow { color: #FFD60A; } .blue { color: #64D2FF; } .heart { color: #FF375F; }
.trend-card { flex-direction: column; }
.trend-card.compact-column { background-color: #000000; padding-top: 8px; padding-bottom: 8px; }
.trend-card.comparative-row { background-color: #111317; padding-top: 9px; padding-bottom: 9px; }
.trend-head { width: 100%; height: 14px; }
.trend-title { color: #FFFFFF; font-size: 9px; font-weight: bold; }
.trend-caption { font-size: 6px; }
.column-trend { width: 100%; flex: 1; flex-direction: row; align-items: flex-end; justify-content: space-between; margin-top: 5px; }
.column-cell { flex-direction: column; align-items: center; justify-content: flex-end; }
.column-chart-area { width: 100%; flex-direction: column; justify-content: flex-end; align-items: center; }
.column-fill { border-radius: 4px; }
.column-value { width: 100%; margin-top: 4px; color: #D1D1D6; text-align: center; lines: 1; }
.today-value { color: #FFFFFF; font-weight: bold; }
.column-weekday { width: 100%; color: #8E8E93; text-align: center; lines: 1; }
.column-date { width: 100%; color: #636366; text-align: center; lines: 1; }
.row-trend { width: 100%; flex: 1; flex-direction: column; justify-content: space-between; margin-top: 4px; }
.row-item { width: 100%; height: 20px; }
.row-label { width: 28px; font-size: 7px; color: #8E8E93; }
.row-track { flex: 1; height: 10px; margin-left: 4px; margin-right: 4px; border-radius: 5px; background-color: #24262C; overflow: hidden; }
.row-fill { height: 10px; border-radius: 5px; }
.row-value { width: 44px; font-size: 8px; color: #FFFFFF; font-weight: bold; text-align: right; }
.today-text { color: #64D2FF; font-weight: bold; }
.insight-card { padding: 6px; flex-direction: column; justify-content: center; }
.insight-detail { font-size: 5px; margin-top: 3px; }
</style>
