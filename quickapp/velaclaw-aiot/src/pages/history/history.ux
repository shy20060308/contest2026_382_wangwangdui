<template>
  <stack class="history-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <stack class="history-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <scroll class="history-stream" if="{{ ready }}" scroll-y="true" style="left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px; padding-bottom: {{ streamPaddingBottom }}px;">
        <div class="history-head" style="width: {{ headerWidth }}px; height: {{ headerHeight }}px;">
          <div class="history-title-row" style="width: {{ headerWidth }}px; height: {{ titleLineHeight }}px;">
            <text class="history-title" style="width: {{ titleWidth }}px; height: {{ titleLineHeight }}px; line-height: {{ titleLineHeight }}px; font-size: {{ titleSize }}px;">7日趋势</text>
            <text class="goal" style="width: {{ goalWidth }}px; height: {{ goalLineHeight }}px; line-height: {{ goalLineHeight }}px; font-size: {{ goalSize }}px;">{{ goalText }}</text>
          </div>
          <text class="history-subtitle" style="width: {{ headerWidth }}px; height: {{ subtitleLineHeight }}px; line-height: {{ subtitleLineHeight }}px; font-size: {{ subtitleSize }}px;">活动与健康摘要</text>
        </div>

        <div class="summary-row" style="width: {{ streamWidth }}px; height: {{ summaryRowHeight }}px; margin-top: {{ cardGap }}px;">
          <div class="summary-card" style="width: {{ summaryWidth }}px; height: {{ summaryHeight }}px; padding: {{ summaryPaddingY }}px {{ summaryPaddingX }}px; border-radius: {{ cardRadius }}px;"><text class="summary-label" style="font-size: {{ summaryLabelSize }}px;">今日步数</text><text class="summary-value yellow" style="font-size: {{ summaryValueSize }}px; margin-top: {{ summaryValueTop }}px;">{{ todayStepsText }}</text></div>
          <div class="summary-card" style="width: {{ summaryWidth }}px; height: {{ summaryHeight }}px; padding: {{ summaryPaddingY }}px {{ summaryPaddingX }}px; border-radius: {{ cardRadius }}px;"><text class="summary-label" style="font-size: {{ summaryLabelSize }}px;">日均步数</text><text class="summary-value blue" style="font-size: {{ summaryValueSize }}px; margin-top: {{ summaryValueTop }}px;">{{ avgStepsText }}</text></div>
        </div>

        <div class="trend-card {{ trendMode }}" style="width: {{ trendWidth }}px; height: {{ trendHeight }}px; padding: {{ trendPaddingY }}px {{ trendPaddingX }}px; margin-top: {{ cardGap }}px; border-radius: {{ cardRadius }}px;">
          <div class="trend-head" style="height: {{ trendHeadHeight }}px;"><text class="trend-title" style="font-size: {{ trendTitleSize }}px;">步数趋势</text><text class="trend-caption" style="font-size: {{ trendCaptionSize }}px;">近7日</text></div>
          <div class="column-trend" if="{{ trendMode === 'compact-column' }}" style="margin-top: {{ columnTrendTop }}px;">
            <div class="column-cell" for="{{ bars }}" tid="date" style="width: {{ columnCellWidth }}px;">
              <div class="column-chart-area" style="height: {{ columnTrackHeight }}px;"><div class="column-fill" style="width: {{ columnBarWidth }}px; height: {{ $item.height }}px; border-radius: {{ columnBarRadius }}px; background-color: {{ $item.color }};"></div></div>
              <text class="column-label {{ $item.isToday ? 'today-text' : '' }}" style="height: {{ columnLabelLineHeight }}px; line-height: {{ columnLabelLineHeight }}px; font-size: {{ columnLabelSize }}px; margin-top: {{ columnLabelTop }}px;">{{ $item.displayLabel }}</text>
            </div>
          </div>
          <div class="row-trend" if="{{ trendMode === 'comparative-row' }}" style="margin-top: {{ rowTrendTop }}px;">
            <div class="row-item" for="{{ bars }}" tid="date" style="height: {{ rowItemHeight }}px;">
              <text class="row-label {{ $item.isToday ? 'today-text' : '' }}" style="width: {{ rowLabelWidth }}px; font-size: {{ rowLabelSize }}px;">{{ $item.displayLabel }}</text>
              <div class="row-track" style="height: {{ rowTrackHeight }}px; margin-left: {{ rowTrackGap }}px; margin-right: {{ rowTrackGap }}px; border-radius: {{ rowTrackRadius }}px;"><div class="row-fill" style="width: {{ $item.rowWidth }}px; height: {{ rowTrackHeight }}px; border-radius: {{ rowTrackRadius }}px; background-color: {{ $item.color }};"></div></div>
              <text class="row-value {{ $item.isToday ? 'today-text' : '' }}" style="width: {{ rowValueWidth }}px; font-size: {{ rowValueSize }}px;">{{ $item.stepsText }}</text>
            </div>
          </div>
        </div>

        <div class="insight-row" style="width: {{ streamWidth }}px; height: {{ insightRowHeight }}px; margin-top: {{ cardGap }}px;">
          <div class="insight-card" style="width: {{ insightWidth }}px; height: {{ insightHeight }}px; padding: {{ insightPadding }}px; border-radius: {{ cardRadius }}px;"><text class="insight-label" style="font-size: {{ insightLabelSize }}px;">最佳</text><text class="insight-value" style="font-size: {{ insightValueSize }}px; margin-top: {{ summaryValueTop }}px;">{{ bestStepsText }}</text><text class="insight-detail" style="font-size: {{ insightDetailSize }}px; margin-top: {{ insightDetailTop }}px;">{{ bestDayText }}</text></div>
          <div class="insight-card" style="width: {{ insightWidth }}px; height: {{ insightHeight }}px; padding: {{ insightPadding }}px; border-radius: {{ cardRadius }}px;"><text class="insight-label" style="font-size: {{ insightLabelSize }}px;">平均心率</text><text class="insight-value heart" style="font-size: {{ insightValueSize }}px; margin-top: {{ summaryValueTop }}px;">{{ avgHeartText }}</text><text class="insight-detail" style="font-size: {{ insightDetailSize }}px; margin-top: {{ insightDetailTop }}px;">7日</text></div>
          <div class="insight-card" style="width: {{ insightWidth }}px; height: {{ insightHeight }}px; padding: {{ insightPadding }}px; border-radius: {{ cardRadius }}px;"><text class="insight-label" style="font-size: {{ insightLabelSize }}px;">今日达成</text><text class="insight-value yellow" style="font-size: {{ insightValueSize }}px; margin-top: {{ summaryValueTop }}px;">{{ goalText }}</text><text class="insight-detail" style="font-size: {{ insightDetailSize }}px; margin-top: {{ insightDetailTop }}px;">目标</text></div>
        </div>
      </scroll>
    </stack>
  </stack>
</template>

<script>
import pageRuntime from '../../runtime/page_runtime'
import navigation from '../../runtime/navigation'
import { createHistoryController } from '../../v2/features/history/controller'
import historyDesign from '../../v2/design/apps/history'
import historyView from '../../v2/design/apps/history/view'

export default {
  private: {
    ready: false, designPlan: null, historyModel: null, trendMode: 'compact-column',
    streamLeft: 0, streamTop: 0, streamWidth: 0, streamHeight: 0, streamPaddingBottom: 0, headerWidth: 0, headerHeight: 0,
    titleWidth: 0, goalWidth: 0, titleSize: 0, subtitleSize: 0, goalSize: 0, titleLineHeight: 0, subtitleLineHeight: 0, goalLineHeight: 0,
    cardGap: 0, cardRadius: 0,
    summaryRowHeight: 0, summaryWidth: 0, summaryHeight: 0, summaryPaddingX: 0, summaryPaddingY: 0, summaryLabelSize: 0, summaryValueSize: 0, summaryValueTop: 0,
    trendWidth: 0, trendHeight: 0, trendPaddingX: 0, trendPaddingY: 0, trendHeadHeight: 0, trendTitleSize: 0, trendCaptionSize: 0,
    columnTrackHeight: 0, columnCellWidth: 0, columnBarWidth: 0, columnBarRadius: 0, columnLabelSize: 0, columnLabelLineHeight: 0, columnTrendTop: 0, columnLabelTop: 0,
    rowTrendTop: 0, rowItemHeight: 0, rowLabelWidth: 0, rowLabelSize: 0, rowTrackHeight: 0, rowTrackGap: 0, rowTrackRadius: 0, rowValueWidth: 0, rowValueSize: 0,
    insightRowHeight: 0, insightWidth: 0, insightHeight: 0, insightPadding: 0, insightLabelSize: 0, insightValueSize: 0, insightDetailSize: 0, insightDetailTop: 0,
    sceneWidth: 0, sceneHeight: 0, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%',
    todayStepsText: '0', avgStepsText: '0', bestStepsText: '0', bestDayText: '--', avgHeartText: '--', goalText: '0%', bars: []
  },
  onInit() {
    var self = this
    this.controller = createHistoryController(function (model) { self.acceptModel(model) })
    pageRuntime.bind(this, function (profile, scene, safe) {
      var plan = historyDesign.resolve(profile, scene, safe)
      var chrome = plan.chrome
      self.designPlan = plan; self.trendMode = plan.trendMode
      self.streamLeft = plan.stream.left; self.streamTop = plan.stream.top; self.streamWidth = plan.stream.width; self.streamHeight = plan.stream.height; self.streamPaddingBottom = plan.streamPaddingBottom
      self.headerWidth = plan.headerWidth; self.headerHeight = plan.headerHeight; self.titleWidth = plan.titleWidth; self.goalWidth = plan.goalWidth
      self.titleSize = plan.titleSize; self.subtitleSize = plan.subtitleSize; self.goalSize = plan.goalSize; self.titleLineHeight = plan.titleLineHeight; self.subtitleLineHeight = plan.subtitleLineHeight; self.goalLineHeight = plan.goalLineHeight
      self.cardGap = plan.cardGap; self.cardRadius = plan.cardRadius
      self.summaryRowHeight = plan.summaryRowHeight; self.summaryWidth = plan.summaryWidth; self.summaryHeight = plan.summaryHeight; self.summaryPaddingX = plan.summaryPaddingX; self.summaryPaddingY = plan.summaryPaddingY; self.summaryLabelSize = plan.summaryLabelSize; self.summaryValueSize = plan.summaryValueSize; self.summaryValueTop = chrome.summaryValueTop
      self.trendWidth = plan.trendWidth; self.trendHeight = plan.trendHeight; self.trendPaddingX = plan.trendPaddingX; self.trendPaddingY = plan.trendPaddingY; self.trendHeadHeight = plan.trendHeadHeight; self.trendTitleSize = plan.trendTitleSize; self.trendCaptionSize = plan.trendCaptionSize
      self.columnTrackHeight = plan.chartHeight; self.columnCellWidth = plan.columnCellWidth; self.columnBarWidth = plan.columnBarWidth; self.columnBarRadius = chrome.columnBarRadius; self.columnLabelSize = plan.columnLabelSize; self.columnLabelLineHeight = plan.columnLabelLineHeight; self.columnTrendTop = chrome.columnTrendTop; self.columnLabelTop = chrome.columnLabelTop
      self.rowTrendTop = chrome.rowTrendTop; self.rowItemHeight = chrome.rowItemHeight; self.rowLabelWidth = chrome.rowLabelWidth; self.rowLabelSize = chrome.rowLabelSize; self.rowTrackHeight = chrome.rowTrackHeight; self.rowTrackGap = chrome.rowTrackGap; self.rowTrackRadius = chrome.rowTrackRadius; self.rowValueWidth = chrome.rowValueWidth; self.rowValueSize = chrome.rowValueSize
      self.insightRowHeight = plan.insightRowHeight; self.insightWidth = plan.insightWidth; self.insightHeight = plan.insightHeight; self.insightPadding = plan.insightPadding; self.insightLabelSize = plan.insightLabelSize; self.insightValueSize = plan.insightValueSize; self.insightDetailSize = chrome.insightDetailSize; self.insightDetailTop = chrome.insightDetailTop
      self.ready = true; self.controller.load()
    })
  },
  onShow() { if (this.ready && this.controller) this.controller.load() },
  onHide() { this.bars = [] },
  onDestroy() { this.historyModel = null; this.bars = [] },
  onBackPress() { navigation.back(); return true },
  acceptModel(model) { this.historyModel = model; if (this.designPlan) this.applyModel(historyView.project(model, this.designPlan)) },
  applyModel(model) { this.todayStepsText = model.todayStepsText; this.avgStepsText = model.avgStepsText; this.bestStepsText = model.bestStepsText; this.bestDayText = model.bestDayText; this.avgHeartText = model.avgHeartText; this.goalText = model.goalText; this.trendHeight = model.trendHeight; this.bars = model.bars }
}
</script>

<style>
.history-root, .history-scene, .history-stream { background-color: #000000; }
.history-scene, .history-stream { position: absolute; }
.history-stream { flex-direction: column; align-items: center; }
.history-head { flex-direction: column; }
.history-title-row, .summary-row, .insight-row, .trend-head, .row-item { flex-direction: row; justify-content: space-between; align-items: center; }
.history-title { color: #FFFFFF; font-weight: bold; lines: 1; }
.history-subtitle, .trend-caption, .summary-label, .insight-label, .insight-detail { color: #8E8E93; }
.history-subtitle { lines: 1; }
.goal { color: #30D158; font-weight: bold; text-align: right; lines: 1; }
.summary-card, .trend-card, .insight-card { background-color: #111317; }
.summary-card, .insight-card { flex-direction: column; justify-content: center; }
.summary-value, .insight-value { font-weight: bold; }
.yellow { color: #FFD60A; } .blue { color: #64D2FF; } .heart { color: #FF375F; }
.trend-card { flex-direction: column; }
.trend-head { width: 100%; }
.trend-title { color: #FFFFFF; font-weight: bold; }
.column-trend { width: 100%; flex: 1; flex-direction: row; align-items: flex-end; justify-content: space-between; }
.column-cell { flex-direction: column; align-items: center; justify-content: flex-end; }
.column-chart-area { width: 100%; flex-direction: column; justify-content: flex-end; align-items: center; }
.column-label { width: 100%; color: #8E8E93; text-align: center; lines: 1; }
.row-trend { width: 100%; flex: 1; flex-direction: column; justify-content: space-between; }
.row-item { width: 100%; }
.row-label { color: #8E8E93; }
.row-track { flex: 1; background-color: #24262C; overflow: hidden; }
.row-value { color: #FFFFFF; font-weight: bold; text-align: right; }
.today-text { color: #FFD60A; font-weight: bold; }
</style>