<template>
  <scroll class="history-page {{ viewportClass }}" scroll-y="true" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @swipe="handleSwipe">
    <div class="top-row">
      <text class="page-title" static>7日趋势</text>
      <text class="back-text" @click="goBack">返回</text>
    </div>

    <text if="{{ loading }}" class="loading-text">加载中...</text>

    <div class="summary-row" if="{{!loading}}">
      <div class="summary-item">
        <text class="summary-value step-color">{{ todayStepsText }}</text>
        <text class="summary-label" static>今日步数</text>
      </div>
      <div class="summary-item">
        <text class="summary-value blue-color">{{ avgStepsText }}</text>
        <text class="summary-label" static>日均步数</text>
      </div>
    </div>

    <div class="chart-card" if="{{!loading}}">
      <text class="section-title" static>步数趋势</text>
      <div class="chart-row">
        <div class="bar-cell" for="{{ stepBars }}" tid="label">
          <div class="bar-space">
            <div class="step-bar" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div>
          </div>
          <text class="bar-steps">{{ $item.shortSteps }}</text>
          <text class="bar-label">{{ $item.label }}</text>
        </div>
      </div>
    </div>

    <div class="insight-row" if="{{!loading}}">
      <div class="insight-item">
        <text class="insight-label" static>最佳</text>
        <text class="insight-value">{{ bestStepsText }}</text>
        <text class="insight-small">{{ bestDayText }}</text>
      </div>
      <div class="insight-item">
        <text class="insight-label" static>心率</text>
        <text class="insight-value heart-color">{{ avgHeartText }}</text>
        <text class="insight-small" static>7日平均</text>
      </div>
      <div class="insight-item">
        <text class="insight-label" static>达成</text>
        <text class="insight-value step-color">{{ goalText }}</text>
        <text class="insight-small" static>今日目标</text>
      </div>
    </div>

    <div class="record-scroll" if="{{!loading}}">
      <div class="record-item" for="{{ records }}" tid="date">
        <text class="record-date">{{ $item.date }}</text>
        <div class="record-values">
          <text class="record-main">{{ $item.stepsText }} 步</text>
          <text class="record-sub">{{ $item.caloriesText }} kcal · {{ $item.heartText }}</text>
        </div>
        <text class="record-goal">{{ $item.goalText }}</text>
      </div>
    </div>
  </scroll>
</template>

<script>
import router from '@system.router'
import historyRepository from '../../domain/history/repository'
import { mapHistory } from '../../presentation/mappers/history'
import pageMotion from '../../common/page_motion'
import pageViewport from '../../common/page_viewport'

export default {
  private: {
    loading: true,
    isCircle: false,
    todayStepsText: '0',
    avgStepsText: '0',
    bestStepsText: '0',
    bestDayText: '--',
    avgHeartText: '--',
    totalCaloriesText: '0',
    goalText: '0%',
    stepBars: [],
    records: [],
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px'
  },

  onInit() {
    var self = this
    pageViewport.bind(this, function (profile) {
      self.isCircle = profile.isCircle
      if (self.pageVisible) self.loadHistory()
    })
  },

  onShow() {
    this.pageVisible = true
    this.loading = true
    pageMotion.enter(this)
    this.loadHistory()
  },

  onHide() {
    this.pageVisible = false
    pageMotion.clear(this)
    this.releaseHistoryData()
  },

  onDestroy() {
    this.pageVisible = false
    pageMotion.clear(this)
    this.releaseHistoryData()
  },

  loadHistory() {
    var self = this
    historyRepository.getHistory(function (history) {
      if (!self.pageVisible) return
      var summary = mapHistory(history, { compact: self.isCircle })
      self.todayStepsText = summary.todayStepsText
      self.avgStepsText = summary.avgStepsText
      self.bestStepsText = summary.bestStepsText
      self.bestDayText = summary.bestDayText
      self.avgHeartText = summary.avgHeartText
      self.totalCaloriesText = summary.totalCaloriesText
      self.goalText = summary.goalText
      self.stepBars = summary.stepBars
      self.records = summary.records
      self.loading = false
    })
  },

  releaseHistoryData() {
    this.stepBars = []
    this.records = []
  },

  goBack() {
    pageMotion.back(this, router)
  },

  handleSwipe(e) {
    if (e.direction === 'down' || e.direction === 'right') {
      pageMotion.back(this, router)
    }
  }
}
</script>

