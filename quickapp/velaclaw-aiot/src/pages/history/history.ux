<template>
  <stack class="history-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <stack class="history-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <scroll class="circle-history" if="{{ ready && isCircle }}" scroll-y="true" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <div class="circle-head"><text class="circle-title">7日趋势</text><text class="circle-today">今日 {{ todayStepsText }}</text></div>
        <div class="circle-chart"><div class="chart-row circle-chart-row"><div class="bar-cell circle-bar-cell" for="{{ bars }}" tid="date"><div class="bar-space circle-bar-space"><div class="step-bar" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="bar-small">{{ $item.shortSteps }}</text><text class="bar-label">{{ $item.label }}</text></div></div></div>
        <div class="circle-insights"><div class="circle-insight"><text class="insight-label">最佳</text><text class="insight-value">{{ bestStepsText }}</text></div><div class="circle-insight"><text class="insight-label">心率</text><text class="insight-value heart">{{ avgHeartText }}</text></div><div class="circle-insight"><text class="insight-label">达成</text><text class="insight-value yellow">{{ goalText }}</text></div></div>
      </scroll>

      <scroll class="pill-history" if="{{ ready && isPill }}" scroll-y="true" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <div class="pill-head"><div><text class="pill-title">7日趋势</text><text class="pill-subtitle">活动与健康摘要</text></div><text class="pill-goal">{{ goalText }}</text></div>
        <div class="pill-summary"><div class="summary-card"><text class="summary-label">今日步数</text><text class="summary-value yellow">{{ todayStepsText }}</text></div><div class="summary-card"><text class="summary-label">日均步数</text><text class="summary-value blue">{{ avgStepsText }}</text></div></div>
        <div class="pill-trend-section">
          <div class="pill-trend-head"><text class="section-title">步数趋势</text><text class="trend-caption">近7日</text></div>
          <div class="pill-trend-list">
            <div class="pill-trend-row" for="{{ bars }}" tid="date">
              <text class="pill-trend-label {{ $item.isToday ? 'today-text' : '' }}">{{ $item.pillLabel }}</text>
              <div class="pill-trend-track"><div class="pill-trend-fill" style="width: {{ $item.pillWidth }}px; background-color: {{ $item.color }};"></div></div>
              <text class="pill-trend-value {{ $item.isToday ? 'today-text' : '' }}">{{ $item.stepsText }}</text>
            </div>
          </div>
        </div>
        <div class="pill-insights"><div class="pill-insight"><text class="insight-label">最佳</text><text class="insight-value">{{ bestStepsText }}</text><text class="insight-detail">{{ bestDayText }}</text></div><div class="pill-insight"><text class="insight-label">平均心率</text><text class="insight-value heart">{{ avgHeartText }}</text><text class="insight-detail">7日</text></div><div class="pill-insight"><text class="insight-label">今日达成</text><text class="insight-value yellow">{{ goalText }}</text><text class="insight-detail">目标</text></div></div>
      </scroll>

      <scroll class="rect-history" if="{{ ready && isRect }}" scroll-y="true" style="left: {{ sceneSafeLeft }}px; top: {{ sceneSafeTop }}px; width: {{ contentWidth }}px; height: {{ sceneSafeHeight }}px;">
        <div class="rect-head"><text class="rect-title">7日趋势</text><div class="rect-head-values"><text class="rect-head-label">今日</text><text class="rect-head-value">{{ todayStepsText }}</text><text class="rect-head-label">日均</text><text class="rect-head-value blue">{{ avgStepsText }}</text></div></div>
        <div class="rect-dashboard"><div class="rect-chart"><div class="chart-row rect-chart-row"><div class="bar-cell rect-bar-cell" for="{{ bars }}" tid="date"><div class="bar-space rect-bar-space"><div class="step-bar" style="height: {{ $item.height }}px; background-color: {{ $item.color }};"></div></div><text class="bar-label">{{ $item.label }}</text></div></div></div><div class="rect-insight-column"><div class="rect-insight"><text class="insight-label">最佳</text><text class="insight-value">{{ bestStepsText }}</text></div><div class="rect-insight"><text class="insight-label">心率</text><text class="insight-value heart">{{ avgHeartText }}</text></div><div class="rect-insight"><text class="insight-label">达成</text><text class="insight-value yellow">{{ goalText }}</text></div></div></div>
      </scroll>
    </stack>
  </stack>
</template>

<script>
import pageRuntime from '../../v2/app/page_runtime'
import navigation from '../../v2/app/navigation'
import { createHistoryController } from '../../v2/features/history/controller'
import historyDesign from '../../v2/design/specs/history'
import historyView from '../../v2/design/views/history'

export default {
  private: {
    ready: false, isCircle: false, isPill: false, isRect: false, contentWidth: 148, designPlan: null, historyModel: null,
    sceneWidth: 192, sceneHeight: 192, sceneSafeLeft: 22, sceneSafeTop: 35, sceneSafeHeight: 120,
    viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%',
    todayStepsText: '0', avgStepsText: '0', bestStepsText: '0', bestDayText: '--', avgHeartText: '--', goalText: '0%', bars: []
  },
  onInit() {
    var self = this
    this.controller = createHistoryController(function (model) { self.acceptModel(model) })
    pageRuntime.bind(this, { contentWidth: function (profile) { return historyDesign.contentWidth(profile) } }, function (profile, scene, safe) {
      var plan = historyDesign.resolve(profile, scene, safe)
      self.designPlan = plan; self.contentWidth = safe.width
      self.isCircle = plan.shape === 'circle'; self.isPill = plan.shape === 'pill'; self.isRect = plan.shape === 'rect'; self.ready = true
      self.controller.load()
    })
  },
  onShow() { if (this.ready && this.controller) this.controller.load() },
  onHide() { this.bars = [] },
  onDestroy() { this.historyModel = null; this.bars = [] },
  onBackPress() { navigation.back(); return true },
  acceptModel(model) { this.historyModel = model; if (this.designPlan) this.applyModel(historyView.project(model, this.designPlan)) },
  applyModel(model) { this.todayStepsText = model.todayStepsText; this.avgStepsText = model.avgStepsText; this.bestStepsText = model.bestStepsText; this.bestDayText = model.bestDayText; this.avgHeartText = model.avgHeartText; this.goalText = model.goalText; this.bars = model.bars }
}
</script>

<style>
.history-root, .history-scene { background-color: #000000; } .history-scene { position: absolute; left: 0px; top: 0px; }
.circle-history, .pill-history, .rect-history { position: absolute; flex-direction: column; }
.chart-row { flex-direction: row; align-items: flex-end; justify-content: space-between; } .bar-cell { flex-direction: column; align-items: center; } .bar-space { flex-direction: column; justify-content: flex-end; align-items: center; } .step-bar { width: 7px; border-radius: 4px; } .bar-label { color: #636366; text-align: center; } .bar-small { color: #8E8E93; text-align: center; }
.heart { color: #FF375F; } .yellow { color: #FFD60A; } .blue { color: #64D2FF; }
.insight-label { color: #8E8E93; } .insight-value { color: #FFFFFF; font-weight: bold; } .insight-detail { color: #636366; }

.circle-head { width: 148px; height: 26px; flex-direction: row; justify-content: space-between; align-items: center; }
.circle-title { font-size: 13px; color: #FFFFFF; font-weight: bold; }
.circle-today { font-size: 7px; color: #FFD60A; }
.circle-chart { width: 148px; height: 88px; border-radius: 21px; background-color: #101215; padding: 8px; }
.circle-chart-row { width: 132px; height: 72px; }
.circle-bar-cell { width: 18px; }
.circle-bar-space { width: 18px; height: 56px; }
.circle-bar-cell .bar-small { width: 18px; font-size: 5px; margin-top: 2px; }
.circle-bar-cell .bar-label { width: 18px; font-size: 5px; margin-top: 1px; }
.circle-insights { width: 148px; height: 44px; margin-top: 8px; flex-direction: row; justify-content: space-between; }
.circle-insight { width: 46px; height: 44px; border-radius: 13px; background-color: #15171B; padding: 7px 6px; flex-direction: column; justify-content: center; }
.circle-insight .insight-label { font-size: 5px; }
.circle-insight .insight-value { font-size: 8px; margin-top: 4px; }

.pill-head { width: 168px; height: 42px; flex-direction: row; justify-content: space-between; align-items: center; }
.pill-title { font-size: 19px; color: #FFFFFF; font-weight: bold; }
.pill-subtitle { font-size: 8px; color: #636366; margin-top: 2px; }
.pill-goal { font-size: 17px; color: #30D158; font-weight: bold; }
.pill-summary { width: 168px; height: 62px; flex-direction: row; justify-content: space-between; }
.summary-card { width: 80px; height: 62px; border-radius: 19px; background-color: #15171B; padding: 10px 11px; flex-direction: column; justify-content: center; }
.summary-label { font-size: 8px; color: #8E8E93; }
.summary-value { font-size: 20px; font-weight: bold; margin-top: 6px; }
.pill-trend-section { width: 168px; height: 184px; margin-top: 8px; border-radius: 24px; background-color: #101215; padding: 10px; flex-direction: column; }
.pill-trend-head { width: 148px; height: 14px; flex-direction: row; justify-content: space-between; align-items: center; }
.section-title { font-size: 10px; color: #FFFFFF; font-weight: bold; }
.trend-caption { font-size: 6px; color: #636366; }
.pill-trend-list { width: 148px; height: 150px; margin-top: 4px; flex-direction: column; justify-content: space-between; }
.pill-trend-row { width: 148px; height: 20px; flex-direction: row; align-items: center; }
.pill-trend-label { width: 28px; font-size: 7px; color: #8E8E93; }
.pill-trend-track { width: 70px; height: 10px; margin-left: 3px; border-radius: 5px; background-color: #24262C; overflow: hidden; }
.pill-trend-fill { height: 10px; border-radius: 5px; }
.pill-trend-value { width: 44px; margin-left: 3px; font-size: 8px; color: #FFFFFF; font-weight: bold; text-align: right; }
.today-text { color: #FFD60A; }
.pill-insights { width: 168px; height: 64px; margin-top: 8px; flex-direction: row; justify-content: space-between; }
.pill-insight { width: 52px; height: 64px; border-radius: 18px; background-color: #15171B; padding: 8px 9px; flex-direction: column; justify-content: center; }
.pill-insight .insight-label { font-size: 7px; }
.pill-insight .insight-value { font-size: 11px; margin-top: 6px; }
.pill-insight .insight-detail { font-size: 6px; margin-top: 4px; }

.rect-head { width: 164px; height: 42px; flex-direction: row; justify-content: space-between; align-items: center; }
.rect-title { font-size: 16px; color: #FFFFFF; font-weight: bold; }
.rect-head-values { flex-direction: row; align-items: center; }
.rect-head-label { font-size: 6px; color: #8E8E93; margin-left: 6px; }
.rect-head-value { font-size: 9px; color: #FFD60A; margin-left: 3px; }
.rect-dashboard { width: 164px; height: 124px; margin-top: 8px; flex-direction: row; justify-content: space-between; }
.rect-chart { width: 112px; height: 124px; border-radius: 19px; background-color: #101215; padding: 8px; }
.rect-chart-row { width: 96px; height: 108px; }
.rect-bar-cell { width: 13px; }
.rect-bar-space { width: 13px; height: 94px; }
.rect-bar-cell .bar-label { width: 13px; font-size: 5px; margin-top: 2px; }
.rect-insight-column { width: 46px; height: 124px; flex-direction: column; justify-content: space-between; }
.rect-insight { width: 46px; height: 37px; border-radius: 11px; background-color: #15171B; padding: 6px; flex-direction: column; justify-content: center; }
.rect-insight .insight-label { font-size: 5px; }
.rect-insight .insight-value { font-size: 7px; margin-top: 3px; }
</style>
