<template>
  <stack class="detail-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="detail-scene" if="{{ ready }}" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="title" style="font-size: {{ titleSize }}px;">动作与加速度</text><text class="status" style="width: {{ chrome.statusWidth }}px; font-size: {{ chrome.statusSize }}px; color: {{ sensorColor }};">{{ sensorStatus }}</text></div>
      <scroll class="content" scroll-y="true" style="left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
        <div if="{{ pageIndex === 0 }}" class="panel">
          <div class="axis-card" style="width: {{ streamWidth }}px; border-radius: {{ cardRadius }}px; padding: {{ chrome.cardPadding }}px;"><text class="section-label" style="font-size: {{ chrome.smallTextSize }}px;">实时三轴 · m/s²</text><div class="axis-row" style="height: {{ chrome.axisRowHeight }}px;"><text class="axis x" style="width: {{ chrome.axisLabelWidth }}px; font-size: {{ chrome.axisLabelSize }}px;">X</text><text class="axis-value" style="font-size: {{ chrome.axisValueSize }}px;">{{ xText }}</text></div><div class="axis-row" style="height: {{ chrome.axisRowHeight }}px;"><text class="axis y" style="width: {{ chrome.axisLabelWidth }}px; font-size: {{ chrome.axisLabelSize }}px;">Y</text><text class="axis-value" style="font-size: {{ chrome.axisValueSize }}px;">{{ yText }}</text></div><div class="axis-row" style="height: {{ chrome.axisRowHeight }}px;"><text class="axis z" style="width: {{ chrome.axisLabelWidth }}px; font-size: {{ chrome.axisLabelSize }}px;">Z</text><text class="axis-value" style="font-size: {{ chrome.axisValueSize }}px;">{{ zText }}</text></div></div>
          <div class="metric-row" style="width: {{ streamWidth }}px; min-height: {{ chrome.metricMinHeight }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px; padding: {{ chrome.cardPadding }}px;"><div class="metric" style="width: {{ chrome.metricWidth }};"><text class="metric-label" style="font-size: {{ chrome.smallTextSize }}px;">合加速度</text><text class="metric-value" style="font-size: {{ chrome.metricValueSize }}px; margin-top: {{ chrome.metricValueMarginTop }}px;">{{ magnitudeText }}</text></div><div class="metric" style="width: {{ chrome.metricWidth }};"><text class="metric-label" style="font-size: {{ chrome.smallTextSize }}px;">动作变化</text><text class="metric-value" style="font-size: {{ chrome.metricValueSize }}px; margin-top: {{ chrome.metricValueMarginTop }}px; color: {{ intensityColor }};">{{ scoreText }}</text></div></div>
          <div class="action-row" style="width: {{ streamWidth }}px; height: {{ chrome.actionRowHeight }}px; margin-top: {{ cardGap }}px;"><text class="action primary" @click="toggleSensor" style="width: {{ chrome.primaryWidth }}; height: {{ chrome.actionHeight }}px; border-radius: {{ chrome.actionRadius }}px; font-size: {{ chrome.actionSize }}px;">{{ sensorButtonText }}</text><text class="action secondary" @click="resetCalibration" style="width: {{ chrome.secondaryWidth }}; height: {{ chrome.actionHeight }}px; border-radius: {{ chrome.actionRadius }}px; font-size: {{ chrome.actionSize }}px;">校准</text></div>
          <text class="tip" style="font-size: {{ chrome.smallTextSize }}px; margin-top: {{ chrome.tipMarginTop }}px; line-height: {{ chrome.tipLineHeight }}px;">{{ sampleText }}</text>
        </div>
        <div if="{{ pageIndex === 1 }}" class="panel">
          <div class="orb" style="width: {{ chrome.orbWidth }}px; height: {{ chrome.orbHeight }}px; border-width: {{ chrome.orbBorderWidth }}px; border-radius: {{ chrome.orbRadius }}px; border-color: {{ actionColor }};"><text class="orb-label" style="font-size: {{ chrome.smallTextSize }}px;">动作强度</text><text class="orb-value" style="font-size: {{ chrome.orbValueSize }}px; margin-top: {{ chrome.orbValueMarginTop }}px; color: {{ actionColor }};">{{ actionResult }}</text><text class="orb-score" style="font-size: {{ chrome.smallTextSize }}px; margin-top: {{ chrome.orbScoreMarginTop }}px;">峰值 {{ actionPeakText }}</text></div>
          <div class="countdown-card" style="width: {{ streamWidth }}px; min-height: {{ chrome.countdownMinHeight }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px; padding: {{ chrome.cardPadding }}px;"><text class="countdown" style="width: {{ chrome.countdownWidth }}px; font-size: {{ chrome.countdownSize }}px;">{{ countdownText }}</text><div class="countdown-copy" style="margin-left: {{ chrome.countdownCopyMarginLeft }}px;"><text class="setting-title" style="font-size: {{ chrome.settingTitleSize }}px;">3 秒动作测量</text><text class="tip-inline" style="font-size: {{ chrome.smallTextSize }}px;">挥腕或抬腕，记录最大变化量</text></div></div>
          <text class="measure-button" @click="startMeasure" style="width: {{ streamWidth }}px; height: {{ chrome.measureHeight }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px; font-size: {{ chrome.measureSize }}px;">{{ measureButtonText }}</text>
          <text class="tip" style="font-size: {{ chrome.smallTextSize }}px; margin-top: {{ chrome.tipMarginTop }}px; line-height: {{ chrome.tipLineHeight }}px;">仅用于传感器演示，不代表医疗或专业运动测量。</text>
        </div>
        <div class="pager" style="width: {{ streamWidth }}px; height: {{ chrome.pagerHeight }}px; margin-top: {{ chrome.pagerMarginTop }}px;"><text class="pager-button" @click="previousPage" style="width: {{ chrome.pagerButtonWidth }}px; font-size: {{ chrome.pagerButtonSize }}px;">‹</text><text class="pager-label" style="font-size: {{ chrome.pagerLabelSize }}px;">{{ pageLabel }}</text><text class="pager-button" @click="nextPage" style="width: {{ chrome.pagerButtonWidth }}px; font-size: {{ chrome.pagerButtonSize }}px;">›</text></div>
      </scroll>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../../runtime/page_runtime'
import navigation from '../../../runtime/navigation'
import { createMotionController } from '../../../v2/features/settings/motion_controller'
import detailDesign from '../../../v2/design/apps/motion'
import motionView from '../../../v2/design/apps/motion/view'

export default {
  private: {
    ready: false, pageIndex: 0, pageLabel: '实时诊断', sensorStatus: '未启动', sensorColor: '#8E8E93', sensorButtonText: '开始诊断', xText: '0.00', yText: '0.00', zText: '0.00', magnitudeText: '0.00', scoreText: '0.00', intensityColor: '#30D158', sampleText: '启动后显示真实样本与采样数量', countdownText: '3.0', actionResult: '待测量', actionColor: '#8E8E93', actionPeakText: '0.00', measureButtonText: '开始测量',
    headerLeft: 0, headerTop: 0, headerWidth: 0, headerHeight: 0, streamLeft: 0, streamTop: 0, streamWidth: 0, streamHeight: 0, titleSize: 0, cardRadius: 0, cardGap: 0, chrome: {},
    sceneWidth: 0, sceneHeight: 0, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createMotionController(function (model) { self.applyModel(model) })
    pageRuntime.bind(this, function (profile, scene, safe) {
      var plan = detailDesign.resolve(profile, scene, safe)
      self.headerLeft = plan.header.left; self.headerTop = plan.header.top; self.headerWidth = plan.header.width; self.headerHeight = plan.header.height
      self.streamLeft = plan.stream.left; self.streamTop = plan.stream.top; self.streamWidth = plan.stream.width; self.streamHeight = plan.stream.height
      self.titleSize = plan.titleSize; self.cardRadius = plan.cardRadius; self.cardGap = plan.cardGap; self.chrome = plan.chrome
      self.ready = true
    })
  },
  onShow() { if (this.controller) this.controller.refresh() },
  onHide() { if (this.controller) this.controller.stop() },
  onDestroy() { if (this.controller) this.controller.stop() },
  onBackPress() { navigation.back(); return true },
  applyModel(model) {
    var view = motionView.project(model)
    this.sensorStatus = view.sensorStatus; this.sensorColor = view.sensorColor; this.sensorButtonText = view.sensorButtonText
    this.xText = view.xText; this.yText = view.yText; this.zText = view.zText; this.magnitudeText = view.magnitudeText; this.scoreText = view.scoreText; this.intensityColor = view.intensityColor; this.sampleText = view.sampleText
    this.countdownText = view.countdownText; this.actionResult = view.actionResult; this.actionColor = view.actionColor; this.actionPeakText = view.actionPeakText; this.measureButtonText = view.measureButtonText
  },
  toggleSensor() { if (this.controller) this.controller.toggleSensor() },
  resetCalibration() { if (this.controller) this.controller.reset() },
  startMeasure() { if (this.controller) this.controller.startMeasure() },
  previousPage() { if (this.pageIndex > 0) this.pageIndex--; this.pageLabel = motionView.pageLabel(this.pageIndex) },
  nextPage() { if (this.pageIndex < 1) this.pageIndex++; this.pageLabel = motionView.pageLabel(this.pageIndex) }
}
</script>

<style>
.detail-root, .detail-scene { background-color: #000000; } .detail-scene { position: absolute; left: 0px; top: 0px; }
.header, .content { position: absolute; } .header { flex-direction: row; justify-content: space-between; align-items: center; }
.title { color: #BF5AF2; font-weight: bold; } .status { text-align: right; }
.content, .panel { flex-direction: column; } .axis-card, .metric-row, .countdown-card { background-color: #14131A; }
.section-label, .metric-label, .tip, .tip-inline, .orb-label, .orb-score { color: #8E8E93; }
.axis-row { width: 100%; flex-direction: row; justify-content: space-between; align-items: center; } .axis { font-weight: bold; } .x { color: #FF453A; } .y { color: #30D158; } .z { color: #0A84FF; } .axis-value { flex: 1; color: #FFFFFF; text-align: right; }
.metric-row { flex-direction: row; justify-content: space-between; } .metric { flex-direction: column; } .metric-value { color: #FFFFFF; font-weight: bold; }
.action-row { flex-direction: row; justify-content: space-between; } .action { color: #FFFFFF; font-weight: bold; text-align: center; } .primary { background-color: #BF5AF2; } .secondary { background-color: #2C2C2E; }
.tip { width: 100%; text-align: center; }
.orb { align-self: center; flex-direction: column; justify-content: center; align-items: center; background-color: #111116; } .orb-value { font-weight: bold; }
.countdown-card { flex-direction: row; align-items: center; } .countdown { color: #BF5AF2; font-weight: bold; text-align: center; } .countdown-copy { flex: 1; flex-direction: column; } .setting-title { color: #FFFFFF; font-weight: bold; }
.measure-button { background-color: #0A84FF; color: #FFFFFF; font-weight: bold; text-align: center; }
.pager { flex-direction: row; justify-content: space-between; align-items: center; } .pager-button { color: #BF5AF2; text-align: center; } .pager-label { color: #8E8E93; }
</style>
