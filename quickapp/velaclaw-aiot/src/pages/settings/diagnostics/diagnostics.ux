<template>
  <stack class="detail-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="detail-scene" if="{{ ready }}" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="title" style="font-size: {{ titleSize }}px;">设备自检</text><text class="page-text" style="font-size: {{ chrome.pageTextSize }}px;">{{ pageText }}</text></div>
      <div class="content" style="left: {{ contentLeft }}px; top: {{ contentTop }}px; width: {{ contentWidth }}px; height: {{ contentHeight }}px;">
        <div class="device-card" if="{{ pageIndex === 0 }}" style="width: {{ contentWidth }}px; border-radius: {{ cardRadius }}px; padding: {{ chrome.devicePadding }}px;">
          <div class="device-head" style="height: {{ chrome.deviceHeadHeight }}px;"><div class="device-dot" style="width: {{ chrome.dotSize }}px; height: {{ chrome.dotSize }}px; border-radius: {{ chrome.dotRadius }}px; margin-right: {{ chrome.dotMarginRight }}px;"></div><text class="device-title" style="font-size: {{ chrome.deviceTitleSize }}px;">运行时设备档案</text></div>
          <div class="info-row" style="min-height: {{ chrome.infoRowMinHeight }}px;"><text class="info-label" style="width: {{ chrome.infoLabelWidth }}px; font-size: {{ chrome.infoTextSize }}px;">设备族</text><text class="info-value" style="font-size: {{ chrome.infoTextSize }}px;">{{ deviceFamily }}</text></div>
          <div class="info-row" style="min-height: {{ chrome.infoRowMinHeight }}px;"><text class="info-label" style="width: {{ chrome.infoLabelWidth }}px; font-size: {{ chrome.infoTextSize }}px;">物理屏</text><text class="info-value" style="font-size: {{ chrome.infoTextSize }}px;">{{ screenSize }}</text></div>
          <div class="info-row" style="min-height: {{ chrome.infoRowMinHeight }}px;"><text class="info-label" style="width: {{ chrome.infoLabelWidth }}px; font-size: {{ chrome.infoTextSize }}px;">Host Scene</text><text class="info-value" style="font-size: {{ chrome.infoTextSize }}px;">{{ hostSceneText }}</text></div>
          <div class="info-row" style="min-height: {{ chrome.infoRowMinHeight }}px;"><text class="info-label" style="width: {{ chrome.infoLabelWidth }}px; font-size: {{ chrome.infoTextSize }}px;">形态</text><text class="info-value" style="font-size: {{ chrome.infoTextSize }}px;">{{ formFactor }}</text></div>
          <div class="info-row" style="min-height: {{ chrome.infoRowMinHeight }}px;"><text class="info-label" style="width: {{ chrome.infoLabelWidth }}px; font-size: {{ chrome.infoTextSize }}px;">平台</text><text class="info-value" style="font-size: {{ chrome.infoTextSize }}px;">{{ platformText }}</text></div>
          <div class="info-row" style="min-height: {{ chrome.infoRowMinHeight }}px;"><text class="info-label" style="width: {{ chrome.infoLabelWidth }}px; font-size: {{ chrome.infoTextSize }}px;">视口策略</text><text class="info-value accent" style="font-size: {{ chrome.infoTextSize }}px;">{{ viewportMode }}</text></div>
          <text class="device-tip" style="font-size: {{ chrome.tipSize }}px; line-height: {{ chrome.tipLineHeight }}px; margin-top: {{ chrome.tipMarginTop }}px;">V3 页面只消费 Host Scene 与 Capability API；原生设备接口不会泄漏到页面。</text>
        </div>

        <div class="capability-list" if="{{ pageIndex > 0 }}">
          <div class="capability-card" for="{{ capabilityPage }}" tid="id" style="width: {{ contentWidth }}px; height: {{ capabilityHeight }}px; margin-bottom: {{ capabilityGap }}px; border-radius: {{ cardRadius }}px; padding-left: {{ chrome.capabilityPaddingLeft }}px; padding-right: {{ chrome.capabilityPaddingRight }}px;">
            <div class="capability-copy"><text class="capability-name" style="font-size: {{ chrome.capabilityNameSize }}px;">{{ $item.name }}</text><text class="capability-api" style="font-size: {{ chrome.capabilityApiSize }}px; margin-top: {{ chrome.capabilityApiMarginTop }}px;">{{ $item.api }}</text></div>
            <div class="status-pill" style="width: {{ chrome.statusWidth }}px; height: {{ chrome.statusHeight }}px; border-radius: {{ chrome.statusRadius }}px; background-color: {{ $item.background }};"><text class="status-text" style="width: {{ chrome.statusTextWidth }}px; font-size: {{ chrome.statusTextSize }}px; color: {{ $item.color }};">{{ $item.status }}</text></div>
          </div>
          <text class="capability-tip" style="font-size: {{ chrome.tipSize }}px; line-height: {{ chrome.tipLineHeight }}px; margin-top: {{ chrome.tipMarginTop }}px;">这里验证的是应用自己的系统接口。传感器实时出数请进入“动作与加速度”。</text>
        </div>
      </div>
      <div class="pager" style="left: {{ pagerLeft }}px; top: {{ pagerTop }}px; width: {{ pagerWidth }}px; height: {{ pagerHeight }}px;"><text class="pager-button" @click="previousPage" style="width: {{ chrome.pagerButtonWidth }}px; font-size: {{ chrome.pagerButtonSize }}px;">‹</text><div class="pager-track" style="width: {{ chrome.pagerTrackWidth }}px; height: {{ chrome.pagerTrackHeight }}px; border-radius: {{ chrome.pagerTrackRadius }}px;"><div class="pager-fill" style="width: {{ pageProgress }}; height: {{ chrome.pagerFillHeight }}px; border-radius: {{ chrome.pagerFillRadius }}px;"></div></div><text class="pager-button" @click="nextPage" style="width: {{ chrome.pagerButtonWidth }}px; font-size: {{ chrome.pagerButtonSize }}px;">›</text></div>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../../v2/app/page_runtime'
import navigation from '../../../v2/app/navigation'
import { createDiagnosticsController } from '../../../v2/features/settings/diagnostics_controller'
import detailDesign from '../../../v2/design/apps/diagnostics'
import diagnosticsView from '../../../v2/design/apps/diagnostics/view'

export default {
  private: {
    ready: false, pageIndex: 0, pageText: '1 / 1', pageProgress: '100%', capabilityPage: [], capabilities: [], capabilityPageSize: 0,
    deviceFamily: '检测中', screenSize: '--', hostSceneText: '--', formFactor: '--', platformText: '--', viewportMode: '--',
    headerLeft: 0, headerTop: 0, headerWidth: 0, headerHeight: 0, contentLeft: 0, contentTop: 0, contentWidth: 0, contentHeight: 0,
    pagerLeft: 0, pagerTop: 0, pagerWidth: 0, pagerHeight: 0, titleSize: 0, cardRadius: 0, capabilityHeight: 0, capabilityGap: 0, chrome: {},
    sceneWidth: 0, sceneHeight: 0, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createDiagnosticsController(function (model) { self.applyModel(model) })
    pageRuntime.bind(this, function (profile, scene, safe) {
      var plan = detailDesign.resolve(profile, scene, safe)
      self.headerLeft = plan.header.left; self.headerTop = plan.header.top; self.headerWidth = plan.header.width; self.headerHeight = plan.header.height
      self.contentLeft = plan.content.left; self.contentTop = plan.content.top; self.contentWidth = plan.content.width; self.contentHeight = plan.content.height
      self.pagerLeft = plan.pager.left; self.pagerTop = plan.pager.top; self.pagerWidth = plan.pager.width; self.pagerHeight = plan.pager.height
      self.titleSize = plan.titleSize; self.cardRadius = plan.cardRadius; self.capabilityHeight = plan.capabilityHeight; self.capabilityGap = plan.capabilityGap; self.capabilityPageSize = plan.capabilityPageSize; self.chrome = plan.chrome
      self.controller.configureScene(profile, scene)
      self.ready = true
    })
  },
  onShow() { if (this.controller) this.controller.refresh() },
  onBackPress() { navigation.back(); return true },
  applyModel(model) {
    var view = diagnosticsView.project(model)
    var device = view.device
    this.deviceFamily = device.deviceFamily; this.screenSize = device.screenSize; this.hostSceneText = device.hostSceneText; this.formFactor = device.formFactor; this.platformText = device.platformText; this.viewportMode = device.viewportMode
    this.capabilities = view.capabilities
    this.refreshPage()
  },
  refreshPage() {
    var state = diagnosticsView.page(this.capabilities, this.pageIndex, this.capabilityPageSize)
    this.pageIndex = state.pageIndex; this.pageText = state.pageText; this.pageProgress = state.pageProgress; this.capabilityPage = state.capabilityPage
  },
  previousPage() { this.pageIndex--; this.refreshPage() },
  nextPage() { this.pageIndex++; this.refreshPage() }
}
</script>

<style>
.detail-root, .detail-scene { background-color: #000000; } .detail-scene { position: absolute; left: 0px; top: 0px; }
.header, .content, .pager { position: absolute; } .header, .info-row, .capability-card, .pager { flex-direction: row; justify-content: space-between; align-items: center; }
.title { color: #64D2FF; font-weight: bold; } .page-text { color: #8E8E93; }
.content { flex-direction: column; } .device-card { min-height: 100%; background-color: #111820; flex-direction: column; }
.device-head { flex-direction: row; align-items: center; } .device-dot { background-color: #64D2FF; } .device-title { color: #FFFFFF; font-weight: bold; }
.info-label { color: #8E8E93; } .info-value { flex: 1; color: #FFFFFF; text-align: right; lines: 1; text-overflow: ellipsis; } .accent { color: #64D2FF; }
.device-tip, .capability-tip { width: 100%; color: #6E7681; }
.capability-list { width: 100%; height: 100%; flex-direction: column; } .capability-card { background-color: #11151B; }
.capability-copy { flex: 1; flex-direction: column; } .capability-name { color: #FFFFFF; font-weight: bold; } .capability-api { color: #777D87; lines: 1; text-overflow: ellipsis; }
.status-pill { justify-content: center; align-items: center; } .status-text { text-align: center; }
.pager-button { color: #64D2FF; text-align: center; } .pager-track { background-color: #24262B; } .pager-fill { background-color: #64D2FF; }
</style>
