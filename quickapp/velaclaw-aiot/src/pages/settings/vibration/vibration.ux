<template>
  <stack class="detail-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="detail-scene" if="{{ ready }}" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="title" style="font-size: {{ titleSize }}px;">震动反馈</text><text class="page-text" style="font-size: {{ chrome.pageTextSize }}px;">{{ pageIndex + 1 }} / 2</text></div>
      <scroll class="content" scroll-y="true" style="left: {{ streamLeft }}px; top: {{ streamTop }}px; width: {{ streamWidth }}px; height: {{ streamHeight }}px;">
        <div if="{{ pageIndex === 0 }}" class="panel" style="width: {{ streamWidth }}px;">
          <div class="status-card" @click="toggleVibration" style="width: {{ streamWidth }}px; height: {{ statusCardHeight }}px; border-radius: {{ cardRadius }}px; border-width: {{ chrome.statusBorderWidth }}px; border-color: {{ statusColor }}; padding: {{ chrome.cardPadding }}px; margin-bottom: {{ chrome.cardMarginBottom }}px;"><div class="copy"><text class="label" style="font-size: {{ bodySize }}px;">通知与交互反馈</text><text class="status-value" style="font-size: {{ valueSize }}px; color: {{ statusColor }}; margin-top: {{ chrome.statusValueMarginTop }}px;">{{ statusText }}</text><text class="sub" style="font-size: {{ bodySize }}px;">强度 {{ levelText }} · {{ patternText }}</text></div><text class="switch" style="width: {{ chrome.switchWidth }}px; font-size: {{ chrome.switchSize }}px; color: {{ statusColor }};">{{ enabledText }}</text></div>
          <text class="section-label" style="width: {{ streamWidth }}px; font-size: {{ bodySize }}px; margin-top: {{ chrome.sectionMarginTop }}px; margin-bottom: {{ chrome.sectionMarginBottom }}px;">基础强度</text>
          <div class="level-row" style="width: {{ streamWidth }}px; height: {{ levelRowHeight }}px;"><text class="level-button" style="width: {{ levelButtonWidth }}px; height: {{ levelButtonHeight }}px; border-radius: {{ chrome.levelButtonRadius }}px; font-size: {{ chrome.levelButtonSize }}px; background-color: {{ lightBg }};" @click="setLight">轻</text><text class="level-button" style="width: {{ levelButtonWidth }}px; height: {{ levelButtonHeight }}px; border-radius: {{ chrome.levelButtonRadius }}px; font-size: {{ chrome.levelButtonSize }}px; background-color: {{ mediumBg }};" @click="setMedium">中</text><text class="level-button" style="width: {{ levelButtonWidth }}px; height: {{ levelButtonHeight }}px; border-radius: {{ chrome.levelButtonRadius }}px; font-size: {{ chrome.levelButtonSize }}px; background-color: {{ strongBg }};" @click="setStrong">强</text></div>
          <div class="test-card" @click="playCurrent" style="width: {{ streamWidth }}px; height: {{ testCardHeight }}px; border-radius: {{ cardRadius }}px; margin-top: {{ cardGap }}px; margin-bottom: {{ chrome.cardMarginBottom }}px; padding: {{ chrome.cardPadding }}px;"><div class="test-copy"><text class="test-title" style="font-size: {{ testTitleSize }}px;">测试当前模式</text><text class="sub test-feedback" style="font-size: {{ bodySize }}px; margin-top: {{ chrome.testFeedbackMarginTop }}px;">{{ feedbackText }}</text></div><text class="arrow" style="width: {{ chrome.arrowWidth }}px; font-size: {{ chrome.arrowSize }}px;">›</text></div>
        </div>
        <div if="{{ pageIndex === 1 }}" class="panel" style="width: {{ streamWidth }}px;">
          <div class="capability-card" style="width: {{ streamWidth }}px; height: {{ capabilityCardHeight }}px; border-radius: {{ cardRadius }}px; margin-bottom: {{ chrome.cardMarginBottom }}px; padding: {{ chrome.cardPadding }}px;"><text class="label" style="font-size: {{ bodySize }}px;">反馈引擎</text><text class="capability" style="font-size: {{ chrome.capabilitySize }}px; margin-top: {{ chrome.capabilityMarginTop }}px; margin-bottom: {{ chrome.capabilityMarginBottom }}px; color: {{ capabilityColor }};">{{ capabilityText }}</text><text class="sub" style="font-size: {{ bodySize }}px;">系统模式 {{ systemModeText }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ tapBg }}; border-radius: {{ cardRadius }}px; margin-bottom: {{ chrome.cardMarginBottom }}px; padding: {{ chrome.cardPadding }}px;" @click="selectTap"><text class="pattern-name" style="width: {{ chrome.patternNameWidth }}px; font-size: {{ testTitleSize }}px;">轻触</text><text class="sub" style="font-size: {{ bodySize }}px;">单次短反馈</text><text class="state" style="width: {{ chrome.stateWidth }}px; font-size: {{ chrome.stateSize }}px;">{{ tapState }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ goalBg }}; border-radius: {{ cardRadius }}px; margin-bottom: {{ chrome.cardMarginBottom }}px; padding: {{ chrome.cardPadding }}px;" @click="selectGoal"><text class="pattern-name" style="width: {{ chrome.patternNameWidth }}px; font-size: {{ testTitleSize }}px;">达标</text><text class="sub" style="font-size: {{ bodySize }}px;">两次确认反馈</text><text class="state" style="width: {{ chrome.stateWidth }}px; font-size: {{ chrome.stateSize }}px;">{{ goalState }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ countdownBg }}; border-radius: {{ cardRadius }}px; margin-bottom: {{ chrome.cardMarginBottom }}px; padding: {{ chrome.cardPadding }}px;" @click="selectCountdown"><text class="pattern-name" style="width: {{ chrome.patternNameWidth }}px; font-size: {{ testTitleSize }}px;">倒计时</text><text class="sub" style="font-size: {{ bodySize }}px;">三次节奏反馈</text><text class="state" style="width: {{ chrome.stateWidth }}px; font-size: {{ chrome.stateSize }}px;">{{ countdownState }}</text></div>
          <div class="pattern-card" style="width: {{ streamWidth }}px; height: {{ patternCardHeight }}px; background-color: {{ alertBg }}; border-radius: {{ cardRadius }}px; margin-bottom: {{ chrome.cardMarginBottom }}px; padding: {{ chrome.cardPadding }}px;" @click="selectAlert"><text class="pattern-name" style="width: {{ chrome.patternNameWidth }}px; font-size: {{ testTitleSize }}px;">警报</text><text class="sub" style="font-size: {{ bodySize }}px;">两次长震动</text><text class="state" style="width: {{ chrome.stateWidth }}px; font-size: {{ chrome.stateSize }}px;">{{ alertState }}</text></div>
        </div>
        <div class="pager" style="width: {{ streamWidth }}px; height: {{ pagerHeight }}px; margin-top: {{ chrome.pagerMarginTop }}px;"><text class="pager-button" @click="previousPage" style="width: {{ chrome.pagerButtonWidth }}px; font-size: {{ chrome.pagerButtonSize }}px;">‹</text><text class="pager-label" style="font-size: {{ chrome.pagerLabelSize }}px;">{{ pageLabel }}</text><text class="pager-button" @click="nextPage" style="width: {{ chrome.pagerButtonWidth }}px; font-size: {{ chrome.pagerButtonSize }}px;">›</text></div>
      </scroll>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../../runtime/page_runtime'
import navigation from '../../../runtime/navigation'
import { createVibrationController } from '../../../v2/features/settings/vibration_controller'
import detailDesign from '../../../v2/design/apps/vibration'
import vibrationView from '../../../v2/design/apps/vibration/view'

export default {
  private: {
    ready: false, pageIndex: 0, pageLabel: '开关与强度', statusText: '已开启', statusColor: '#30D158', enabledText: '开', levelText: '中', patternText: '达标', feedbackText: '点击播放反馈', capabilityText: '检测中', capabilityColor: '#8E8E93', systemModeText: '未知',
    lightBg: '#1C1C1E', mediumBg: '#FF9F0A', strongBg: '#1C1C1E', tapBg: '#14181F', goalBg: '#2D210F', countdownBg: '#14181F', alertBg: '#14181F', tapState: '›', goalState: '已选', countdownState: '›', alertState: '›',
    headerLeft: 0, headerTop: 0, headerWidth: 0, headerHeight: 0, streamLeft: 0, streamTop: 0, streamWidth: 0, streamHeight: 0, titleSize: 0, cardRadius: 0, cardGap: 0,
    statusCardHeight: 0, levelRowHeight: 0, levelButtonWidth: 0, levelButtonHeight: 0, testCardHeight: 0, capabilityCardHeight: 0, patternCardHeight: 0, pagerHeight: 0, bodySize: 0, valueSize: 0, testTitleSize: 0, chrome: {},
    sceneWidth: 0, sceneHeight: 0, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.controller = createVibrationController(function (model) { self.applyView(vibrationView.project(model)) })
    pageRuntime.bind(this, function (profile, scene, safe) {
      var plan = detailDesign.resolve(profile, scene, safe)
      self.headerLeft = plan.header.left; self.headerTop = plan.header.top; self.headerWidth = plan.header.width; self.headerHeight = plan.header.height
      self.streamLeft = plan.stream.left; self.streamTop = plan.stream.top; self.streamWidth = plan.stream.width; self.streamHeight = plan.stream.height
      self.titleSize = plan.titleSize; self.cardRadius = plan.cardRadius; self.cardGap = plan.cardGap; self.bodySize = plan.bodySize; self.valueSize = plan.valueSize; self.testTitleSize = plan.testTitleSize
      self.statusCardHeight = plan.controls.statusCardHeight; self.levelRowHeight = plan.controls.levelRowHeight; self.levelButtonWidth = plan.controls.levelButtonWidth; self.levelButtonHeight = plan.controls.levelButtonHeight
      self.testCardHeight = plan.controls.testCardHeight; self.capabilityCardHeight = plan.controls.capabilityCardHeight; self.patternCardHeight = plan.controls.patternCardHeight; self.pagerHeight = plan.controls.pagerHeight; self.chrome = plan.chrome
      self.ready = true
    })
  },
  onShow() { this.controller.load() },
  onHide() { this.controller.stop() },
  onDestroy() { this.controller.stop() },
  onBackPress() { navigation.back(); return true },
  applyView(view) {
    this.statusText = view.statusText; this.statusColor = view.statusColor; this.enabledText = view.enabledText; this.levelText = view.levelText; this.patternText = view.patternText; this.feedbackText = view.feedbackText; this.capabilityText = view.capabilityText; this.capabilityColor = view.capabilityColor; this.systemModeText = view.systemModeText
    this.lightBg = view.lightBg; this.mediumBg = view.mediumBg; this.strongBg = view.strongBg
    this.tapBg = view.tapBg; this.goalBg = view.goalBg; this.countdownBg = view.countdownBg; this.alertBg = view.alertBg
    this.tapState = view.tapState; this.goalState = view.goalState; this.countdownState = view.countdownState; this.alertState = view.alertState
  },
  toggleVibration() { this.controller.toggle() }, setLight() { this.controller.setLevel('light') }, setMedium() { this.controller.setLevel('medium') }, setStrong() { this.controller.setLevel('strong') }, playCurrent() { this.controller.playCurrent() },
  selectTap() { this.controller.selectPattern('tap') }, selectGoal() { this.controller.selectPattern('goal') }, selectCountdown() { this.controller.selectPattern('countdown') }, selectAlert() { this.controller.selectPattern('alert') },
  previousPage() { if (this.pageIndex > 0) this.pageIndex--; this.pageLabel = this.pageIndex === 0 ? '开关与强度' : '反馈模式' },
  nextPage() { if (this.pageIndex < 1) this.pageIndex++; this.pageLabel = this.pageIndex === 0 ? '开关与强度' : '反馈模式' }
}
</script>

<style>
.detail-root, .detail-scene { background-color: #000000; } .detail-scene { position: absolute; left: 0px; top: 0px; }
.header, .content { position: absolute; } .header { flex-direction: row; justify-content: space-between; align-items: center; }
.title { color: #FF9F0A; font-weight: bold; } .page-text { color: #8E8E93; }
.content, .panel { flex-direction: column; } .panel { align-items: center; }
.status-card, .test-card, .capability-card, .pattern-card { background-color: #14181F; }
.status-card { flex-direction: row; justify-content: space-between; align-items: center; } .copy { flex: 1; flex-direction: column; }
.label, .sub { color: #8E8E93; } .status-value { font-weight: bold; } .switch { font-weight: bold; text-align: right; }
.section-label { color: #8E8E93; }
.level-row { flex-direction: row; justify-content: space-between; align-items: center; }
.level-button { color: #FFFFFF; text-align: center; }
.test-card { flex-direction: row; align-items: center; justify-content: space-between; } .test-copy { flex: 1; flex-direction: column; } .test-title { color: #FFFFFF; font-weight: bold; } .arrow { color: #636366; text-align: right; }
.capability-card { flex-direction: column; justify-content: center; } .capability { font-weight: bold; }
.pattern-card { flex-direction: row; align-items: center; } .pattern-name { color: #FFFFFF; font-weight: bold; } .pattern-card .sub { flex: 1; } .state { color: #FF9F0A; text-align: right; }
.pager { flex-direction: row; justify-content: space-between; align-items: center; } .pager-button { color: #FF9F0A; text-align: center; } .pager-label { color: #8E8E93; text-align: center; }
</style>
