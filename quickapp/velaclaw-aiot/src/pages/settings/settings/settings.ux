<template>
  <stack class="settings-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <div class="settings-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="header" style="left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;"><text class="title" style="font-size: {{ titleSize }}px;">设置</text><text class="page-text">{{ pageText }}</text></div>
      <div class="settings-list" style="left: {{ listLeft }}px; top: {{ listTop }}px; width: {{ listWidth }}px; height: {{ listHeight }}px;">
        <div class="setting-card" for="{{ pageItems }}" tid="id" @click="openSetting($item)" style="width: {{ listWidth }}px; height: {{ itemHeight }}px; margin-bottom: {{ $item.marginBottom }}px; border-radius: {{ itemRadius }}px; padding: {{ itemPadding }}px;"><image class="item-icon" src="{{ $item.icon }}" style="width: {{ iconSize }}px; height: {{ iconSize }}px; border-radius: {{ iconRadius }}px;"></image><div class="item-copy"><text class="item-name" style="font-size: {{ itemNameSize }}px;">{{ $item.name }}</text><text class="item-desc" style="font-size: {{ itemDescSize }}px; line-height: {{ itemDescLineHeight }}px;">{{ $item.description }}</text></div><text class="item-arrow" style="font-size: {{ arrowSize }}px;">›</text></div>
      </div>
      <div class="pager" style="left: {{ footerLeft }}px; top: {{ footerTop }}px; width: {{ footerWidth }}px; height: {{ footerHeight }}px;"><text class="pager-button" @click="previousPage">‹</text><div class="dots"><div class="dot" for="{{ dots }}" style="background-color: {{ $item.color }};"></div></div><text class="pager-button" @click="nextPage">›</text></div>
    </div>
  </stack>
</template>

<script>
import pageRuntime from '../../../v2/app/page_runtime'
import navigation from '../../../v2/app/navigation'
import { getSettingsMenu } from '../../../v2/features/settings/menu_controller'
import pager from '../../../v2/design/pager'
import pagedStack from '../../../v2/design/paged_stack'

function decorate(items, gap) {
  var result = []
  for (var i = 0; i < items.length; i++) {
    var source = items[i]
    result.push({ id: source.id, name: source.name, description: source.description, icon: source.icon, route: source.route, marginBottom: i < items.length - 1 ? gap : 0 })
  }
  return result
}

export default {
  private: {
    pageItems: [], dots: [], pageIndex: 0, pageText: '1 / 1', pageSize: 2,
    headerLeft: 22, headerTop: 24, headerWidth: 148, headerHeight: 20, listLeft: 22, listTop: 49, listWidth: 148, listHeight: 104, footerLeft: 22, footerTop: 158, footerWidth: 148, footerHeight: 16,
    itemHeight: 49, itemGap: 6, itemRadius: 18, itemPadding: 7, iconSize: 30, iconRadius: 15, titleSize: 12, itemNameSize: 10, itemDescSize: 6, itemDescLineHeight: 8, arrowSize: 13,
    sceneWidth: 192, sceneHeight: 192, viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%'
  },
  onInit() {
    var self = this
    this.items = getSettingsMenu()
    pageRuntime.bind(this, { contentWidth: function (profile) { return profile.formFactor === 'circle' ? 148 : (profile.formFactor === 'rect' ? 164 : 168) } }, function (profile, scene, safe) {
      self.capacityPlan = pagedStack.resolve(safe, { minItems: 2, maxItems: 3, headerHeight: safe.height > 250 ? 30 : 20, footerHeight: safe.height > 250 ? 24 : 16, sectionGap: safe.height > 250 ? 10 : 6, minItemHeight: 48, maxItemHeight: 82, itemGap: safe.height > 250 ? 10 : 6 })
      self.pageSize = self.capacityPlan.pageSize
      self.refreshPage()
    })
  },
  onShow() { this.refreshPage() },
  onBackPress() { navigation.back(); return true },
  refreshPage() {
    if (!this.capacityPlan) return
    var state = pager.resolve(this.items, this.pageIndex, this.pageSize)
    this.pageIndex = state.pageIndex; this.pageText = state.pageText
    var plan = pagedStack.reflow(this.capacityPlan, state.items.length)
    this.applyPlan(plan)
    this.pageItems = decorate(state.items, plan.itemGap)
    var dots = []
    for (var i = 0; i < state.pageCount; i++) dots.push({ color: i === state.pageIndex ? '#0A84FF' : '#3A3A3C' })
    this.dots = dots
  },
  applyPlan(plan) {
    this.headerLeft = plan.header.left; this.headerTop = plan.header.top; this.headerWidth = plan.header.width; this.headerHeight = plan.header.height
    this.listLeft = plan.list.left; this.listTop = plan.list.top; this.listWidth = plan.list.width; this.listHeight = plan.list.height
    this.footerLeft = plan.footer.left; this.footerTop = plan.footer.top; this.footerWidth = plan.footer.width; this.footerHeight = plan.footer.height
    this.itemHeight = plan.itemHeight; this.itemGap = plan.itemGap
    var scale = plan.visualScale || 1
    this.itemRadius = Math.round(18 * Math.min(1.4, scale)); this.itemPadding = Math.round(7 * Math.min(1.3, scale)); this.iconSize = Math.round(30 * Math.min(1.35, scale)); this.iconRadius = Math.round(this.iconSize / 2)
    this.titleSize = Math.round(12 * Math.min(1.4, scale)); this.itemNameSize = Math.round(10 * Math.min(1.35, scale)); this.itemDescSize = Math.max(6, Math.round(6 * Math.min(1.35, scale))); this.itemDescLineHeight = this.itemDescSize + 2; this.arrowSize = Math.round(13 * Math.min(1.35, scale))
  },
  previousPage() { this.pageIndex--; this.refreshPage() },
  nextPage() { this.pageIndex++; this.refreshPage() },
  openSetting(item) { if (item && item.route) navigation.push(item.route) }
}
</script>

<style>
.settings-root, .settings-scene { background-color: #000000; }
.settings-scene { position: absolute; left: 0px; top: 0px; }
.header, .settings-list, .pager { position: absolute; }
.header, .pager, .setting-card { flex-direction: row; align-items: center; }
.header, .pager { justify-content: space-between; }
.title { color: #FFFFFF; font-weight: bold; } .page-text { color: #8E8E93; font-size: 7px; }
.settings-list { flex-direction: column; }
.setting-card { background-color: #12171C; }
.item-icon { object-fit: cover; } .item-copy { flex: 1; flex-direction: column; margin-left: 8px; }
.item-name { color: #FFFFFF; font-weight: bold; } .item-desc { color: #8E8E93; lines: 2; margin-top: 2px; }
.item-arrow { width: 14px; color: #636366; text-align: right; }
.pager-button { width: 30px; color: #0A84FF; font-size: 18px; text-align: center; }
.dots { width: 70px; flex-direction: row; justify-content: center; align-items: center; }
.dot { width: 6px; height: 6px; border-radius: 3px; margin-left: 3px; margin-right: 3px; }
</style>
