<template>
  <div class="settings-page {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;" @swipe="handleSwipe">
    <div class="top-row" style="position: absolute; left: {{ headerLeft }}px; top: {{ headerTop }}px; width: {{ headerWidth }}px; height: {{ headerHeight }}px;">
      <text class="page-title" style="font-size: {{ titleFontSize }}px;">设置</text>
      <text class="page-number" style="font-size: {{ pageNumberFontSize }}px;">{{ pageText }}</text>
    </div>

    <div class="settings-list" style="position: absolute; left: {{ listLeft }}px; top: {{ listTop }}px; width: {{ listWidth }}px; height: {{ listHeight }}px;">
      <div class="settings-item" for="{{ pageItems }}" tid="id" @click="openSetting($item)" style="width: {{ itemWidth }}px; height: {{ itemHeight }}px; margin-bottom: {{ itemGap }}px; padding: {{ itemPadding }}px; border-radius: {{ itemRadius }}px;">
        <image class="item-icon" src="{{ $item.icon }}" style="width: {{ iconSize }}px; height: {{ iconSize }}px; border-radius: {{ iconRadius }}px; margin-right: {{ iconMargin }}px;"></image>
        <div class="item-copy" style="width: {{ itemCopyWidth }}px;">
          <text class="item-name" style="font-size: {{ itemNameFontSize }}px;">{{ $item.name }}</text>
          <text class="item-sub" style="font-size: {{ itemSubFontSize }}px; line-height: {{ itemSubLineHeight }}px; margin-top: {{ itemSubMargin }}px;">{{ $item.description }}</text>
        </div>
        <text class="item-arrow" style="width: {{ arrowWidth }}px; font-size: {{ arrowFontSize }}px;">›</text>
      </div>
    </div>

    <div class="pager-row" style="position: absolute; left: {{ footerLeft }}px; top: {{ footerTop }}px; width: {{ footerWidth }}px; height: {{ footerHeight }}px;">
      <text class="pager-button" style="width: {{ pagerButtonWidth }}px; height: {{ footerHeight }}px; font-size: {{ pagerFontSize }}px; color: {{ previousColor }}" @click="previousPage">‹</text>
      <div class="pager-center">
        <div class="page-dot" for="{{ pageDots }}" style="background-color: {{ $item.color }}"></div>
      </div>
      <text class="pager-button" style="width: {{ pagerButtonWidth }}px; height: {{ footerHeight }}px; font-size: {{ pagerFontSize }}px; color: {{ nextColor }}" @click="nextPage">›</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import fixedPager from '../../../common/fixed_pager'
import pageMotion from '../../../common/page_motion'
import layoutRuntime from '../../../presentation/layout/runtime'
import pagedStack from '../../../presentation/layout/paged_stack'
import settingsLayout from '../../../presentation/layout/specs/settings'

function region(plan, id) {
  var list = plan && plan.regions ? plan.regions : []
  for (var i = 0; i < list.length; i++) {
    if (list[i].id === id) return list[i]
  }
  return null
}

export default {
  private: {
    settings: [
      { id: 'sync', name: '蓝牙同步', description: '连接手机并模拟数据上传', icon: '/common/icons/sync.jpg', route: '/pages/settings/bluetooth' },
      { id: 'vibration', name: '震动反馈', description: '提醒开关、强度与反馈模式', icon: '/common/icons/vibration.jpg', route: '/pages/settings/vibration' },
      { id: 'brightness', name: '亮度与省电', description: '亮度、抬腕亮屏、低功耗', icon: '/common/icons/brightness.jpg', route: '/pages/settings/brightness' },
      { id: 'motion', name: '动作与加速度', description: '三轴诊断与动作强度测量', icon: '/common/icons/motion.jpg', route: '/pages/settings/motion' },
      { id: 'diagnostics', name: '设备自检', description: '屏幕档案与系统能力状态', icon: '/common/icons/diagnostics.jpg', route: '/pages/settings/diagnostics' }
    ],
    pageItems: [],
    pageDots: [],
    pageIndex: 0,
    pageSize: 2,
    pageText: '1 / 1',
    previousColor: '#3A3A3C',
    nextColor: '#3A3A3C',
    headerLeft: 36,
    headerTop: 23,
    headerWidth: 120,
    headerHeight: 20,
    listLeft: 22,
    listTop: 47,
    listWidth: 148,
    listHeight: 106,
    footerLeft: 41,
    footerTop: 157,
    footerWidth: 110,
    footerHeight: 14,
    itemWidth: 148,
    itemHeight: 50,
    itemGap: 6,
    itemPadding: 7,
    itemRadius: 18,
    iconSize: 30,
    iconRadius: 15,
    iconMargin: 7,
    itemCopyWidth: 91,
    arrowWidth: 12,
    titleFontSize: 12,
    pageNumberFontSize: 7,
    itemNameFontSize: 10,
    itemSubFontSize: 6,
    itemSubLineHeight: 8,
    itemSubMargin: 2,
    arrowFontSize: 12,
    pagerFontSize: 14,
    pagerButtonWidth: 26,
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '',
    viewportPosition: 'relative',
    viewportLeft: '0px',
    viewportWidth: '100%',
    viewportHeight: '100%',
    viewportTop: '0px'
  },

  onInit() {
    var self = this
    layoutRuntime.bind(this, function (profile) {
      return pagedStack.resolve(profile, settingsLayout)
    }, function (plan) {
      self.applyLayout(plan)
      self.refreshPage()
    })
  },

  onShow() {
    pageMotion.enter(this)
    this.refreshPage()
  },

  onHide() {
    pageMotion.clear(this)
  },

  onDestroy() {
    pageMotion.clear(this)
  },

  applyLayout(plan) {
    var header = region(plan, 'header')
    var list = region(plan, 'list')
    var footer = region(plan, 'footer')
    if (!header || !list || !footer) return

    this.pageSize = plan.pageSize
    this.headerLeft = header.left
    this.headerTop = header.top
    this.headerWidth = header.width
    this.headerHeight = header.height
    this.listLeft = list.left
    this.listTop = list.top
    this.listWidth = list.width
    this.listHeight = list.height
    this.footerLeft = footer.left
    this.footerTop = footer.top
    this.footerWidth = footer.width
    this.footerHeight = footer.height

    var scale = plan.scale || 1
    this.itemWidth = plan.itemWidth
    this.itemHeight = plan.itemHeight
    this.itemGap = plan.itemGap
    this.itemPadding = Math.round(7 * scale)
    this.itemRadius = Math.round(18 * scale)
    this.iconSize = Math.round(30 * scale)
    this.iconRadius = Math.round(this.iconSize / 2)
    this.iconMargin = Math.round(7 * scale)
    this.arrowWidth = Math.round(12 * scale)
    this.itemCopyWidth = Math.max(48, Math.round(this.itemWidth - this.itemPadding * 2 - this.iconSize - this.iconMargin - this.arrowWidth))
    this.titleFontSize = Math.max(10, Math.round(12 * scale))
    this.pageNumberFontSize = Math.max(6, Math.round(7 * scale))
    this.itemNameFontSize = Math.max(9, Math.round(10 * scale))
    this.itemSubFontSize = Math.max(6, Math.round(6 * scale))
    this.itemSubLineHeight = Math.max(8, Math.round(8 * scale))
    this.itemSubMargin = Math.max(1, Math.round(2 * scale))
    this.arrowFontSize = Math.max(11, Math.round(12 * scale))
    this.pagerFontSize = Math.max(13, Math.round(14 * scale))
    this.pagerButtonWidth = Math.max(24, Math.round(26 * scale))
  },

  refreshPage() {
    var state = fixedPager.build(this.settings, this.pageIndex, this.pageSize)
    this.pageIndex = state.pageIndex
    this.pageItems = state.items
    this.pageText = state.pageText
    this.previousColor = state.hasPrevious ? '#0A84FF' : '#3A3A3C'
    this.nextColor = state.hasNext ? '#0A84FF' : '#3A3A3C'
    var dots = []
    for (var index = 0; index < state.pageCount; index++) {
      dots.push({ color: index === state.pageIndex ? '#0A84FF' : '#3A3A3C' })
    }
    this.pageDots = dots
  },

  previousPage() {
    var state = fixedPager.move(this.settings, this.pageIndex, this.pageSize, -1)
    if (state.pageIndex === this.pageIndex) return
    this.pageIndex = state.pageIndex
    this.refreshPage()
  },

  nextPage() {
    var state = fixedPager.move(this.settings, this.pageIndex, this.pageSize, 1)
    if (state.pageIndex === this.pageIndex) return
    this.pageIndex = state.pageIndex
    this.refreshPage()
  },

  openSetting(item) {
    if (item && item.route) pageMotion.push(this, router, item.route)
  },

  handleSwipe(event) {
    if (!event) return
    if (event.direction === 'left') {
      this.nextPage()
    } else if (event.direction === 'right') {
      if (this.pageIndex > 0) this.previousPage()
      else pageMotion.back(this, router)
    }
  }
}
</script>

<style>
.settings-page {
  background-color: #000000;
  width: 100%;
  height: 100%;
}

.top-row,
.pager-row,
.settings-item {
  flex-direction: row;
  align-items: center;
}

.top-row,
.pager-row {
  justify-content: space-between;
}

.page-title,
.item-name {
  font-weight: bold;
  color: #FFFFFF;
}

.page-number,
.item-sub {
  color: #8E8E93;
}

.settings-list,
.item-copy {
  flex-direction: column;
}

.settings-item {
  background-color: #12171C;
}

.item-sub {
  lines: 2;
}

.item-arrow {
  color: #636366;
  text-align: right;
}

.pager-button {
  font-weight: bold;
  text-align: center;
}

.pager-center {
  width: 60px;
  height: 12px;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.page-dot {
  width: 6px;
  height: 6px;
  border-radius: 3px;
  margin-left: 3px;
  margin-right: 3px;
}
</style>
