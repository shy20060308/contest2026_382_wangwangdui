<template>
  <stack class="today-page {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }}; opacity: {{ pageOpacity }}; margin-left: {{ pageOffset }}px;">
    <div class="circle-summary-surface" if="{{ profileReady && isCircleSurface && surfacePageIndex === 0 }}" @swipe="handleSwipe">
      <div class="circle-date-card">
        <div class="circle-month-badge"><text class="circle-month-text">{{ monthText }}</text></div>
        <text class="circle-day-value">{{ dayText }}</text>
        <div class="circle-date-copy">
          <text class="circle-weekday">{{ weekdayText }}</text>
          <text class="circle-year">{{ yearText }}</text>
          <text class="circle-lunar">{{ lunarText }}</text>
        </div>
      </div>
      <div class="circle-summary-title-row"><text class="circle-summary-title">今日摘要</text><text class="circle-summary-goal">目标 {{ goalPercent }}%</text></div>
      <div class="circle-goal-track"><div class="circle-goal-fill" style="width: {{ goalWidth }}"></div></div>
      <div class="circle-metric-grid">
        <div class="circle-metric-card blue-card"><text class="circle-metric-label">步数</text><text class="circle-metric-value">{{ stepsText }}</text><text class="circle-metric-unit">步</text></div>
        <div class="circle-metric-card orange-card"><text class="circle-metric-label">热量</text><text class="circle-metric-value">{{ caloriesText }}</text><text class="circle-metric-unit">千卡</text></div>
        <div class="circle-metric-card red-card"><text class="circle-metric-label">心率</text><text class="circle-metric-value">{{ heartText }}</text><text class="circle-metric-unit">bpm</text></div>
        <div class="circle-metric-card green-card"><text class="circle-metric-label">站立</text><text class="circle-metric-value">{{ standText }}</text><text class="circle-metric-unit">h</text></div>
      </div>
      <div class="surface-pager"><div class="surface-dot active-dot"></div><div class="surface-dot"></div></div>
    </div>

    <div class="circle-calendar-surface" if="{{ profileReady && isCircleSurface && surfacePageIndex === 1 }}" @swipe="handleSwipe">
      <text class="circle-calendar-title">{{ calendarTitle }}</text>
      <div class="circle-week-row">
        <text class="circle-week weekend">日</text><text class="circle-week">一</text><text class="circle-week">二</text><text class="circle-week">三</text><text class="circle-week">四</text><text class="circle-week">五</text><text class="circle-week weekend">六</text>
      </div>
      <div class="circle-calendar-grid">
        <div class="circle-calendar-cell" for="{{ calendarCells }}" tid="key"><text class="circle-calendar-day" style="color: {{ $item.textColor }}; background-color: {{ $item.backgroundColor }};">{{ $item.day }}</text></div>
      </div>
      <div class="circle-calendar-status"><text class="circle-calendar-lunar">今天 · {{ lunarText }}</text><text class="circle-calendar-heart">♥ {{ heartText }}</text></div>
      <div class="surface-pager"><div class="surface-dot"></div><div class="surface-dot active-dot"></div></div>
    </div>

    <div class="pill-summary-surface" if="{{ profileReady && isPillSurface && surfacePageIndex === 0 }}" @touchstart="handlePillTouchStart" @touchend="handlePillTouchEnd">
      <div class="pill-date-hero">
        <div class="pill-month-badge"><text class="pill-month-text">{{ monthText }}</text></div>
        <text class="pill-day-value">{{ dayText }}</text>
        <div class="pill-date-copy"><text class="pill-weekday">{{ weekdayText }}</text><text class="pill-year">{{ yearText }}</text><text class="pill-lunar">{{ lunarText }}</text></div>
      </div>
      <div class="pill-summary-title-row"><text class="pill-summary-title">今日摘要</text><text class="pill-summary-goal">目标 {{ goalPercent }}%</text></div>
      <div class="pill-goal-track"><div class="pill-goal-fill" style="width: {{ goalWidth }}"></div></div>
      <div class="pill-metric-grid">
        <div class="pill-metric-card blue-card"><text class="pill-metric-label">步数</text><text class="pill-metric-value pill-steps-value" style="font-size: {{ pillStepsFontSize }}px;">{{ stepsText }}</text><text class="pill-metric-unit">步</text></div>
        <div class="pill-metric-card orange-card"><text class="pill-metric-label">热量</text><text class="pill-metric-value">{{ caloriesText }}</text><text class="pill-metric-unit">千卡</text></div>
        <div class="pill-metric-card red-card"><text class="pill-metric-label">心率</text><text class="pill-metric-value">{{ heartText }}</text><text class="pill-metric-unit">bpm</text></div>
        <div class="pill-metric-card green-card"><text class="pill-metric-label">站立</text><text class="pill-metric-value">{{ standText }}</text><text class="pill-metric-unit">小时</text></div>
      </div>
    </div>

    <div class="pill-calendar-surface" if="{{ profileReady && isPillSurface && surfacePageIndex === 1 }}" @touchstart="handlePillTouchStart" @touchend="handlePillTouchEnd">
      <div class="pill-month-hero">
        <div class="pill-month-number-block"><text class="pill-month-number">{{ monthNumberText }}</text><text class="pill-month-unit">MONTH</text></div>
        <div class="pill-month-copy"><text class="pill-calendar-title">{{ calendarTitle }}</text><text class="pill-calendar-lunar">今日 · {{ lunarText }}</text><text class="pill-calendar-nav">上下滑动切换月份</text></div>
      </div>
      <div class="pill-week-row">
        <text class="pill-week weekend">日</text><text class="pill-week">一</text><text class="pill-week">二</text><text class="pill-week">三</text><text class="pill-week">四</text><text class="pill-week">五</text><text class="pill-week weekend">六</text>
      </div>
      <div class="pill-calendar-card">
        <div class="pill-calendar-grid">
          <div class="pill-calendar-cell" for="{{ calendarCells }}" tid="key"><text class="pill-calendar-day" style="color: {{ $item.textColor }}; background-color: {{ $item.backgroundColor }};">{{ $item.day }}</text></div>
        </div>
      </div>
    </div>

    <div class="rect-dashboard-surface" if="{{ profileReady && isRectSurface }}" @swipe="handleSwipe">
      <div class="rect-date-header">
        <div class="rect-date-left"><text class="rect-date-number">{{ dayText }}</text><text class="rect-date-month">{{ monthText }}</text></div>
        <div class="rect-date-copy"><text class="rect-weekday">{{ weekdayText }}</text><text class="rect-lunar">{{ lunarText }}</text></div>
        <text class="rect-goal">{{ goalPercent }}%</text>
      </div>
      <div class="rect-metric-strip">
        <div class="rect-metric blue-card"><text class="rect-metric-label">步</text><text class="rect-metric-value">{{ stepsText }}</text></div>
        <div class="rect-metric orange-card"><text class="rect-metric-label">卡</text><text class="rect-metric-value">{{ caloriesText }}</text></div>
        <div class="rect-metric red-card"><text class="rect-metric-label">心</text><text class="rect-metric-value">{{ heartText }}</text></div>
        <div class="rect-metric green-card"><text class="rect-metric-label">站</text><text class="rect-metric-value">{{ standText }}</text></div>
      </div>
      <div class="rect-calendar-title-row"><text class="rect-calendar-title">{{ calendarTitle }}</text><text class="rect-calendar-nav">上下切月</text></div>
      <div class="rect-week-row">
        <text class="rect-week weekend">日</text><text class="rect-week">一</text><text class="rect-week">二</text><text class="rect-week">三</text><text class="rect-week">四</text><text class="rect-week">五</text><text class="rect-week weekend">六</text>
      </div>
      <div class="rect-calendar-grid">
        <div class="rect-calendar-cell" for="{{ calendarCells }}" tid="key"><text class="rect-calendar-day" style="color: {{ $item.textColor }}; background-color: {{ $item.backgroundColor }};">{{ $item.day }}</text></div>
      </div>
    </div>
  </stack>
</template>

<script>
import router from '@system.router'
import pageMotion from '../../common/page_motion'
import calendarUtils from '../../common/calendar_utils'
import activityStore from '../../domain/activity/store'
import healthStore from '../../domain/health/store'
import { mapActivity } from '../../presentation/mappers/activity'
import layoutRuntime from '../../presentation/layout/runtime'
import freeSurface from '../../presentation/layout/free_surface'
import todayLayout from '../../presentation/layout/specs/today'

var WEEKDAYS = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六']

function pad2(value) {
  return value < 10 ? '0' + value : '' + value
}

function metricFontSize(value) {
  var length = String(value || '').length
  if (length <= 4) return 24
  if (length === 5) return 20
  if (length === 6) return 17
  return 15
}

export default {
  private: {
    yearText: '', monthText: '', monthNumberText: '', dayText: '', weekdayText: '', lunarText: '',
    stepsText: '--', caloriesText: '--', heartText: '--', standText: '--', goalPercent: 0, goalWidth: '0%',
    pillStepsFontSize: 20,
    profileReady: false,
    isCircleSurface: false,
    isPillSurface: false,
    isRectSurface: false,
    surfacePageIndex: 0,
    surfacePageCount: 1,
    calendarYear: 0,
    calendarMonth: 0,
    calendarTitle: '',
    calendarCells: [],
    pillTouchStartX: 0,
    pillTouchStartY: 0,
    pillTouchTracking: false,
    pageOpacity: 1,
    pageOffset: 0,
    viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportWidth: '100%', viewportHeight: '100%', viewportTop: '0px'
  },

  onInit() {
    var self = this
    this.healthListener = function (data) { self.applyHealthData(data) }
    layoutRuntime.bind(this, function (profile) {
      return freeSurface.resolve(profile, todayLayout)
    }, function (plan) {
      self.isCircleSurface = plan.surface === 'circle-dual-page'
      self.isPillSurface = plan.surface === 'pill-month-gallery'
      self.isRectSurface = plan.surface === 'rect-calendar-dashboard'
      self.surfacePageCount = Math.max(1, plan.pageSize || 1)
      self.surfacePageIndex = 0
      self.profileReady = true
    })
    this.refreshToday()
  },

  onShow() {
    pageMotion.enter(this)
    this.refreshToday()
    healthStore.subscribe(this.healthListener)
  },

  onHide() {
    pageMotion.clear(this)
    healthStore.unsubscribe(this.healthListener)
    this.pillTouchTracking = false
  },

  onDestroy() {
    pageMotion.clear(this)
    healthStore.unsubscribe(this.healthListener)
    this.pillTouchTracking = false
    this.calendarCells = []
  },

  refreshToday() {
    var self = this
    var now = new Date()
    this.yearText = now.getFullYear() + ' 年'
    this.monthText = now.getMonth() + 1 + '月'
    this.monthNumberText = pad2(now.getMonth() + 1)
    this.dayText = now.getDate().toString()
    this.weekdayText = WEEKDAYS[now.getDay()]
    this.lunarText = calendarUtils.formatLunar(now)
    this.calendarYear = now.getFullYear()
    this.calendarMonth = now.getMonth()
    this.refreshCalendar()
    activityStore.hydrate(function (snapshot) { self.applyActivity(snapshot) })
    var health = healthStore.getSnapshot()
    if (health && health.heartRate !== undefined && health.heartRate !== null) this.heartText = health.heartRate.toString()
  },

  applyActivity(snapshot) {
    var view = mapActivity(snapshot)
    this.stepsText = view.stepsText
    this.pillStepsFontSize = metricFontSize(view.stepsText)
    this.caloriesText = view.caloriesText
    this.standText = view.standText
    this.goalPercent = view.goalPercent
    this.goalWidth = view.goalWidth
  },

  applyHealthData(data) {
    if (!data || data.heartRate === undefined || data.heartRate === null) return
    this.heartText = data.heartRate.toString()
  },

  refreshCalendar() {
    var today = new Date()
    this.calendarTitle = this.calendarYear + '年 ' + (this.calendarMonth + 1) + '月'
    this.monthNumberText = pad2(this.calendarMonth + 1)
    this.calendarCells = calendarUtils.buildMonth(this.calendarYear, this.calendarMonth, today)
  },

  changeCalendarMonth(delta) {
    var next = calendarUtils.shiftMonth(this.calendarYear, this.calendarMonth, delta)
    this.calendarYear = next.year
    this.calendarMonth = next.month
    this.refreshCalendar()
  },

  handlePillTouchStart(event) {
    if (!event || !event.touches || !event.touches[0]) return
    var point = event.touches[0]
    this.pillTouchStartX = point.pageX
    this.pillTouchStartY = point.pageY
    this.pillTouchTracking = true
  },

  handlePillTouchEnd(event) {
    if (!this.pillTouchTracking || !event || !event.changedTouches || !event.changedTouches[0]) {
      this.pillTouchTracking = false
      return
    }
    var point = event.changedTouches[0]
    var deltaX = point.pageX - this.pillTouchStartX
    var deltaY = point.pageY - this.pillTouchStartY
    this.pillTouchTracking = false

    if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) >= 28) {
      if (this.surfacePageIndex === 1) this.changeCalendarMonth(deltaY < 0 ? 1 : -1)
      return
    }
    if (Math.abs(deltaX) < 30) return
    if (deltaX < 0 && this.surfacePageIndex === 0) this.surfacePageIndex = 1
    else if (deltaX > 0 && this.surfacePageIndex === 1) this.surfacePageIndex = 0
    else if (deltaX > 0 && this.surfacePageIndex === 0) pageMotion.back(this, router)
  },

  handleSwipe(event) {
    if (!event) return
    if (this.surfacePageCount > 1) {
      if (this.surfacePageIndex === 0) {
        if (event.direction === 'left') this.surfacePageIndex = 1
        else if (event.direction === 'right') pageMotion.back(this, router)
        return
      }
      if (event.direction === 'up') this.changeCalendarMonth(1)
      else if (event.direction === 'down') this.changeCalendarMonth(-1)
      else if (event.direction === 'right') this.surfacePageIndex = 0
      return
    }
    if (event.direction === 'up') this.changeCalendarMonth(1)
    else if (event.direction === 'down') this.changeCalendarMonth(-1)
    else if (event.direction === 'right') pageMotion.back(this, router)
  }
}
</script>

<style>
.today-page { width: 100%; height: 100%; background-color: #000000; }
.blue-card { background-color: #101D2B; }
.orange-card { background-color: #2A1B0B; }
.red-card { background-color: #2B1117; }
.green-card { background-color: #10251A; }
.weekend { color: #FF6B81; }

.circle-summary-surface,
.circle-calendar-surface { position: absolute; left: 28px; top: 31px; width: 136px; height: 130px; flex-direction: column; align-items: center; }
.circle-date-card { width: 136px; height: 50px; flex-direction: row; align-items: center; padding: 6px 11px; border-radius: 24px; background-color: #171318; }
.circle-month-badge { position: absolute; left: 11px; top: 5px; width: 30px; height: 13px; border-radius: 7px; background-color: #FF375F; justify-content: center; align-items: center; }
.circle-month-text { width: 28px; font-size: 6px; font-weight: bold; color: #FFFFFF; text-align: center; }
.circle-day-value { width: 48px; height: 32px; font-size: 28px; font-weight: bold; color: #FFFFFF; text-align: center; margin-top: 8px; }
.circle-date-copy { width: 58px; flex-direction: column; margin-left: 4px; }
.circle-weekday { font-size: 9px; color: #FF375F; font-weight: bold; }
.circle-year { font-size: 6px; color: #D1D1D6; margin-top: 2px; }
.circle-lunar { font-size: 5px; color: #8E8E93; margin-top: 1px; }
.circle-summary-title-row { width: 136px; height: 13px; margin-top: 3px; flex-direction: row; justify-content: space-between; align-items: center; }
.circle-summary-title { font-size: 8px; color: #FFFFFF; font-weight: bold; }
.circle-summary-goal { font-size: 6px; color: #30D158; }
.circle-goal-track { width: 136px; height: 3px; margin-top: 2px; border-radius: 2px; background-color: #242426; }
.circle-goal-fill { height: 3px; border-radius: 2px; background-color: #30D158; }
.circle-metric-grid { width: 136px; height: 48px; margin-top: 4px; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.circle-metric-card { width: 66px; height: 22px; border-radius: 11px; margin-bottom: 4px; padding: 0px 6px; flex-direction: row; align-items: center; }
.circle-metric-label { width: 20px; font-size: 5px; color: #8E8E93; }
.circle-metric-value { width: 30px; font-size: 10px; color: #FFFFFF; font-weight: bold; text-align: right; }
.circle-metric-unit { width: 10px; font-size: 4px; color: #8E8E93; text-align: right; }
.surface-pager { width: 136px; height: 4px; margin-top: 3px; flex-direction: row; justify-content: center; align-items: center; }
.surface-dot { width: 4px; height: 4px; border-radius: 2px; background-color: #3A3A3C; margin-left: 2px; margin-right: 2px; }
.active-dot { width: 10px; background-color: #FF375F; }
.circle-calendar-title { width: 136px; height: 14px; font-size: 10px; font-weight: bold; color: #FFFFFF; text-align: center; }
.circle-week-row { width: 133px; height: 11px; flex-direction: row; }
.circle-week { width: 19px; font-size: 6px; color: #8E8E93; text-align: center; }
.circle-calendar-grid { width: 133px; height: 90px; flex-direction: row; flex-wrap: wrap; }
.circle-calendar-cell { width: 19px; height: 15px; justify-content: center; align-items: center; }
.circle-calendar-day { width: 15px; height: 13px; border-radius: 7px; font-size: 7px; text-align: center; }
.circle-calendar-status { width: 133px; height: 12px; flex-direction: row; justify-content: space-between; align-items: center; }
.circle-calendar-lunar { width: 94px; font-size: 7px; color: #E5E5EA; }
.circle-calendar-heart { width: 39px; font-size: 7px; color: #FF375F; text-align: right; }

.pill-summary-surface,
.pill-calendar-surface { position: absolute; left: 0px; top: 0px; width: 192px; height: 100%; flex-direction: column; align-items: center; }
.pill-date-hero { width: 168px; height: 116px; margin-top: 46px; border-radius: 28px; background-color: #171318; flex-direction: row; align-items: center; padding: 14px; }
.pill-month-badge { position: absolute; left: 14px; top: 12px; width: 48px; height: 24px; border-radius: 12px; background-color: #FF375F; justify-content: center; align-items: center; }
.pill-month-text { font-size: 11px; color: #FFFFFF; font-weight: bold; }
.pill-day-value { width: 74px; font-size: 62px; color: #FFFFFF; font-weight: bold; text-align: center; margin-top: 20px; }
.pill-date-copy { width: 70px; flex-direction: column; margin-left: 6px; }
.pill-weekday { font-size: 17px; color: #FF375F; font-weight: bold; }
.pill-year { font-size: 11px; color: #D1D1D6; margin-top: 8px; }
.pill-lunar { font-size: 8px; color: #8E8E93; margin-top: 7px; }
.pill-summary-title-row { width: 168px; height: 28px; margin-top: 14px; flex-direction: row; justify-content: space-between; align-items: center; }
.pill-summary-title { font-size: 16px; color: #FFFFFF; font-weight: bold; }
.pill-summary-goal { font-size: 10px; color: #30D158; }
.pill-goal-track { width: 168px; height: 5px; margin-top: 4px; border-radius: 3px; background-color: #242426; }
.pill-goal-fill { height: 5px; border-radius: 3px; background-color: #30D158; }
.pill-metric-grid { width: 168px; height: 172px; margin-top: 13px; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.pill-metric-card { width: 80px; height: 80px; border-radius: 20px; margin-bottom: 12px; padding: 11px; flex-direction: column; }
.pill-metric-label { font-size: 9px; color: #8E8E93; }
.pill-metric-value { width: 58px; font-size: 24px; color: #FFFFFF; font-weight: bold; margin-top: 5px; lines: 1; }
.pill-steps-value { width: 58px; }
.pill-metric-unit { font-size: 8px; color: #8E8E93; margin-top: 2px; }

.pill-month-hero { width: 168px; height: 82px; margin-top: 36px; flex-direction: row; align-items: center; }
.pill-month-number-block { width: 72px; height: 72px; flex-direction: column; justify-content: center; }
.pill-month-number { width: 72px; height: 52px; font-size: 48px; color: #FF375F; font-weight: bold; }
.pill-month-unit { width: 72px; font-size: 7px; color: #6E6E73; letter-spacing: 2px; }
.pill-month-copy { width: 96px; height: 72px; flex-direction: column; justify-content: center; padding-left: 8px; }
.pill-calendar-title { width: 88px; font-size: 15px; color: #FFFFFF; font-weight: bold; }
.pill-calendar-lunar { width: 88px; font-size: 8px; color: #C7C7CC; margin-top: 7px; }
.pill-calendar-nav { width: 88px; font-size: 7px; color: #6E6E73; margin-top: 7px; }
.pill-week-row { width: 154px; height: 22px; margin-top: 10px; flex-direction: row; }
.pill-week { width: 22px; font-size: 8px; color: #8E8E93; text-align: center; }
.pill-calendar-card { width: 168px; height: 198px; border-radius: 24px; background-color: #101215; padding-top: 6px; align-items: center; }
.pill-calendar-grid { width: 154px; height: 186px; flex-direction: row; flex-wrap: wrap; }
.pill-calendar-cell { width: 22px; height: 31px; justify-content: center; align-items: center; }
.pill-calendar-day { width: 22px; height: 22px; border-radius: 11px; font-size: 10px; text-align: center; }

.rect-dashboard-surface { width: 192px; height: 100%; flex-direction: column; align-items: center; }
.rect-date-header { width: 164px; height: 36px; margin-top: 8px; flex-direction: row; align-items: center; }
.rect-date-left { width: 58px; height: 36px; flex-direction: row; align-items: baseline; }
.rect-date-number { font-size: 30px; color: #FFFFFF; font-weight: bold; }
.rect-date-month { font-size: 8px; color: #FF375F; margin-left: 3px; }
.rect-date-copy { width: 78px; flex-direction: column; }
.rect-weekday { font-size: 11px; color: #FFFFFF; font-weight: bold; }
.rect-lunar { font-size: 6px; color: #8E8E93; margin-top: 3px; }
.rect-goal { width: 28px; font-size: 11px; color: #30D158; font-weight: bold; text-align: right; }
.rect-metric-strip { width: 164px; height: 42px; margin-top: 5px; flex-direction: row; justify-content: space-between; }
.rect-metric { width: 38px; height: 42px; border-radius: 10px; padding: 5px; flex-direction: column; }
.rect-metric-label { font-size: 6px; color: #8E8E93; }
.rect-metric-value { width: 28px; font-size: 11px; color: #FFFFFF; font-weight: bold; margin-top: 5px; text-align: center; }
.rect-calendar-title-row { width: 154px; height: 20px; margin-top: 6px; flex-direction: row; justify-content: space-between; align-items: center; }
.rect-calendar-title { font-size: 10px; color: #FFFFFF; font-weight: bold; }
.rect-calendar-nav { font-size: 6px; color: #6E6E73; }
.rect-week-row { width: 154px; height: 12px; flex-direction: row; }
.rect-week { width: 22px; font-size: 6px; color: #8E8E93; text-align: center; }
.rect-calendar-grid { width: 154px; height: 90px; flex-direction: row; flex-wrap: wrap; }
.rect-calendar-cell { width: 22px; height: 15px; justify-content: center; align-items: center; }
.rect-calendar-day { width: 17px; height: 13px; border-radius: 7px; font-size: 7px; text-align: center; }
</style>