<template>
  <stack class="today-root {{ viewportClass }}" style="position: {{ viewportPosition }}; left: {{ viewportLeft }}; top: {{ viewportTop }}; width: {{ viewportWidth }}; height: {{ viewportHeight }};">
    <stack class="today-scene" style="width: {{ sceneWidth }}px; height: {{ sceneHeight }}px;">
      <div class="circle-surface" if="{{ ready && isCircle && pageIndex === 0 }}" style="left: {{ frameLeft }}px; top: {{ frameTop }}px; width: {{ frameWidth }}px; height: {{ frameHeight }}px;">
        <div class="circle-date-row" style="width: {{ summaryLayout.dateRow.width }}px; height: {{ summaryLayout.dateRow.height }}px; border-radius: {{ summaryLayout.dateRow.radius }}px; padding-top: {{ summaryLayout.dateRow.paddingY }}px; padding-bottom: {{ summaryLayout.dateRow.paddingY }}px; padding-left: {{ summaryLayout.dateRow.paddingX }}px; padding-right: {{ summaryLayout.dateRow.paddingX }}px;"><div class="circle-day" style="width: {{ summaryLayout.day.width }}px; height: {{ summaryLayout.day.height }}px;"><text class="circle-day-value" style="font-size: {{ summaryLayout.dayValue.fontSize }}px;">{{ dayText }}</text><text class="circle-month" style="font-size: {{ summaryLayout.month.fontSize }}px; margin-left: {{ summaryLayout.month.marginLeft }}px; margin-bottom: {{ summaryLayout.month.marginBottom }}px;">{{ monthText }}</text></div><div class="circle-date-copy" style="width: {{ summaryLayout.dateCopy.width }}px; margin-left: {{ summaryLayout.dateCopy.marginLeft }}px;"><text class="circle-weekday" style="font-size: {{ summaryLayout.weekday.fontSize }}px;">{{ weekdayText }}</text><text class="circle-lunar" style="font-size: {{ summaryLayout.lunar.fontSize }}px; margin-top: {{ summaryLayout.lunar.marginTop }}px;">{{ lunarText }}</text></div></div>
        <div class="circle-goal-row" style="width: {{ summaryLayout.goalRow.width }}px; height: {{ summaryLayout.goalRow.height }}px; margin-top: {{ summaryLayout.goalRow.marginTop }}px;"><text class="circle-title" style="font-size: {{ summaryLayout.title.fontSize }}px;">今日</text><text class="circle-goal" style="font-size: {{ summaryLayout.goal.fontSize }}px;">{{ goalPercent }}%</text></div>
        <div class="circle-goal-track" style="width: {{ summaryLayout.goalTrack.width }}px; height: {{ summaryLayout.goalTrack.height }}px; border-radius: {{ summaryLayout.goalTrack.radius }}px;"><div class="circle-goal-fill" style="width: {{ goalWidth }}; height: {{ summaryLayout.goalFill.height }}px; border-radius: {{ summaryLayout.goalFill.radius }}px;"></div></div>
        <div class="circle-metrics" style="width: {{ summaryLayout.metrics.width }}px; height: {{ summaryLayout.metrics.height }}px; margin-top: {{ summaryLayout.metrics.marginTop }}px;">
          <div class="circle-metric-card circle-steps" style="width: {{ summaryLayout.metricCard.width }}px; height: {{ summaryLayout.metricCard.height }}px; border-radius: {{ summaryLayout.metricCard.radius }}px; padding-left: {{ summaryLayout.metricCard.paddingX }}px; padding-right: {{ summaryLayout.metricCard.paddingX }}px; margin-bottom: {{ summaryLayout.metricCard.marginBottom }}px;"><text class="circle-metric-label steps-text" style="width: {{ summaryLayout.metricLabel.width }}px; font-size: {{ summaryLayout.metricLabel.fontSize }}px;">步数</text><text class="circle-metric-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; lines: {{ summaryLayout.metricValue.lines }};">{{ stepsText }}</text></div>
          <div class="circle-metric-card circle-calories" style="width: {{ summaryLayout.metricCard.width }}px; height: {{ summaryLayout.metricCard.height }}px; border-radius: {{ summaryLayout.metricCard.radius }}px; padding-left: {{ summaryLayout.metricCard.paddingX }}px; padding-right: {{ summaryLayout.metricCard.paddingX }}px; margin-bottom: {{ summaryLayout.metricCard.marginBottom }}px;"><text class="circle-metric-label calories-text" style="width: {{ summaryLayout.metricLabel.width }}px; font-size: {{ summaryLayout.metricLabel.fontSize }}px;">热量</text><text class="circle-metric-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; lines: {{ summaryLayout.metricValue.lines }};">{{ caloriesText }}</text></div>
          <div class="circle-metric-card circle-heart" style="width: {{ summaryLayout.metricCard.width }}px; height: {{ summaryLayout.metricCard.height }}px; border-radius: {{ summaryLayout.metricCard.radius }}px; padding-left: {{ summaryLayout.metricCard.paddingX }}px; padding-right: {{ summaryLayout.metricCard.paddingX }}px; margin-bottom: {{ summaryLayout.metricCard.marginBottom }}px;"><text class="circle-metric-label heart-text" style="width: {{ summaryLayout.metricLabel.width }}px; font-size: {{ summaryLayout.metricLabel.fontSize }}px;">心率</text><text class="circle-metric-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; lines: {{ summaryLayout.metricValue.lines }};">{{ heartText }}</text></div>
          <div class="circle-metric-card circle-stand" style="width: {{ summaryLayout.metricCard.width }}px; height: {{ summaryLayout.metricCard.height }}px; border-radius: {{ summaryLayout.metricCard.radius }}px; padding-left: {{ summaryLayout.metricCard.paddingX }}px; padding-right: {{ summaryLayout.metricCard.paddingX }}px; margin-bottom: {{ summaryLayout.metricCard.marginBottom }}px;"><text class="circle-metric-label stand-text" style="width: {{ summaryLayout.metricLabel.width }}px; font-size: {{ summaryLayout.metricLabel.fontSize }}px;">站立</text><text class="circle-metric-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; lines: {{ summaryLayout.metricValue.lines }};">{{ standText }}h</text></div>
        </div>
        <div class="circle-action" style="width: {{ summaryLayout.action.width }}px; height: {{ summaryLayout.action.height }}px; margin-top: {{ summaryLayout.action.marginTop }}px; border-radius: {{ summaryLayout.action.radius }}px;" @click="openCalendar"><text class="circle-action-text" style="font-size: {{ summaryLayout.actionText.fontSize }}px;">月历</text></div>
      </div>

      <div class="circle-surface" if="{{ ready && isCircle && pageIndex === 1 }}" style="left: {{ frameLeft }}px; top: {{ frameTop }}px; width: {{ frameWidth }}px; height: {{ frameHeight }}px;">
        <div class="circle-calendar-head" style="width: {{ calendarLayout.head.width }}px; height: {{ calendarLayout.head.height }}px;"><div class="circle-nav" style="width: {{ calendarLayout.nav.width }}px; height: {{ calendarLayout.nav.height }}px;" @click="previousMonth"><text class="circle-nav-text" style="font-size: {{ calendarLayout.navText.fontSize }}px;">‹</text></div><text class="circle-calendar-title" style="width: {{ calendarLayout.title.width }}px; font-size: {{ calendarLayout.title.fontSize }}px;">{{ calendarTitle }}</text><div class="circle-nav" style="width: {{ calendarLayout.nav.width }}px; height: {{ calendarLayout.nav.height }}px;" @click="nextMonth"><text class="circle-nav-text" style="font-size: {{ calendarLayout.navText.fontSize }}px;">›</text></div></div>
        <div class="circle-week-row" style="width: {{ calendarLayout.weekRow.width }}px; height: {{ calendarLayout.weekRow.height }}px;"><text class="circle-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">日</text><text class="circle-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">一</text><text class="circle-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">二</text><text class="circle-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">三</text><text class="circle-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">四</text><text class="circle-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">五</text><text class="circle-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">六</text></div>
        <div class="circle-calendar-grid" style="width: {{ calendarLayout.grid.width }}px; height: {{ calendarLayout.grid.height }}px;"><div class="circle-cell" style="width: {{ calendarLayout.cell.width }}px; height: {{ calendarLayout.cell.height }}px;" for="{{ calendarCells }}" tid="key"><text class="circle-cell-text" style="width: {{ calendarLayout.cellText.width }}px; height: {{ calendarLayout.cellText.height }}px; border-radius: {{ calendarLayout.cellText.radius }}px; font-size: {{ calendarLayout.cellText.fontSize }}px; color: {{ $item.textColor }}; background-color: {{ $item.backgroundColor }};">{{ $item.day }}</text></div></div>
        <div class="circle-action" style="width: {{ calendarLayout.action.width }}px; height: {{ calendarLayout.action.height }}px; margin-top: {{ calendarLayout.action.marginTop }}px; border-radius: {{ calendarLayout.action.radius }}px;" @click="closeCalendar"><text class="circle-action-text" style="font-size: {{ calendarLayout.actionText.fontSize }}px;">今日摘要</text></div>
      </div>

      <div class="pill-surface" if="{{ ready && isPill && pageIndex === 0 }}" style="left: {{ frameLeft }}px; top: {{ frameTop }}px; width: {{ frameWidth }}px; height: {{ frameHeight }}px;">
        <div class="pill-date-hero" style="width: {{ summaryLayout.dateHero.width }}px; height: {{ summaryLayout.dateHero.height }}px; border-radius: {{ summaryLayout.dateHero.radius }}px; padding: {{ summaryLayout.dateHero.padding }}px;"><div class="pill-day-block" style="width: {{ summaryLayout.dayBlock.width }}px; height: {{ summaryLayout.dayBlock.height }}px;"><text class="pill-month-badge" style="width: {{ summaryLayout.monthBadge.width }}px; height: {{ summaryLayout.monthBadge.height }}px; border-radius: {{ summaryLayout.monthBadge.radius }}px; font-size: {{ summaryLayout.monthBadge.fontSize }}px; padding-top: {{ summaryLayout.monthBadge.paddingTop }}px;">{{ monthText }}</text><text class="pill-day-value" style="width: {{ summaryLayout.dayValue.width }}px; height: {{ summaryLayout.dayValue.height }}px; font-size: {{ summaryLayout.dayValue.fontSize }}px;">{{ dayText }}</text></div><div class="pill-date-copy" style="width: {{ summaryLayout.dateCopy.width }}px; margin-left: {{ summaryLayout.dateCopy.marginLeft }}px;"><text class="pill-weekday" style="font-size: {{ summaryLayout.weekday.fontSize }}px;">{{ weekdayText }}</text><text class="pill-year" style="font-size: {{ summaryLayout.year.fontSize }}px; margin-top: {{ summaryLayout.year.marginTop }}px;">{{ yearText }}</text><text class="pill-lunar" style="font-size: {{ summaryLayout.lunar.fontSize }}px; margin-top: {{ summaryLayout.lunar.marginTop }}px;">{{ lunarText }}</text></div></div>
        <div class="pill-summary-row" style="width: {{ summaryLayout.summaryRow.width }}px; height: {{ summaryLayout.summaryRow.height }}px; margin-top: {{ summaryLayout.summaryRow.marginTop }}px;"><text class="pill-summary-title" style="font-size: {{ summaryLayout.summaryTitle.fontSize }}px;">今日摘要</text><text class="pill-goal" style="font-size: {{ summaryLayout.goal.fontSize }}px;">目标 {{ goalPercent }}%</text></div>
        <div class="pill-goal-track" style="width: {{ summaryLayout.goalTrack.width }}px; height: {{ summaryLayout.goalTrack.height }}px; border-radius: {{ summaryLayout.goalTrack.radius }}px;"><div class="pill-goal-fill" style="width: {{ goalWidth }}; height: {{ summaryLayout.goalFill.height }}px; border-radius: {{ summaryLayout.goalFill.radius }}px;"></div></div>
        <div class="pill-grid" style="width: {{ summaryLayout.grid.width }}px; height: {{ summaryLayout.grid.height }}px; margin-top: {{ summaryLayout.grid.marginTop }}px;"><div class="pill-card blue" style="width: {{ summaryLayout.card.width }}px; height: {{ summaryLayout.card.height }}px; border-radius: {{ summaryLayout.card.radius }}px; padding-top: {{ summaryLayout.card.paddingY }}px; padding-bottom: {{ summaryLayout.card.paddingY }}px; padding-left: {{ summaryLayout.card.paddingX }}px; padding-right: {{ summaryLayout.card.paddingX }}px; margin-bottom: {{ summaryLayout.card.marginBottom }}px;"><text class="pill-label" style="font-size: {{ summaryLayout.label.fontSize }}px;">步数</text><text class="pill-value pill-steps" style="width: {{ summaryLayout.value.width }}px; font-size: {{ summaryLayout.stepsValue.fontSize }}px; margin-top: {{ summaryLayout.value.marginTop }}px; lines: {{ summaryLayout.value.lines }};">{{ stepsText }}</text><text class="pill-unit" style="font-size: {{ summaryLayout.unit.fontSize }}px; margin-top: {{ summaryLayout.unit.marginTop }}px;">步</text></div><div class="pill-card orange" style="width: {{ summaryLayout.card.width }}px; height: {{ summaryLayout.card.height }}px; border-radius: {{ summaryLayout.card.radius }}px; padding-top: {{ summaryLayout.card.paddingY }}px; padding-bottom: {{ summaryLayout.card.paddingY }}px; padding-left: {{ summaryLayout.card.paddingX }}px; padding-right: {{ summaryLayout.card.paddingX }}px; margin-bottom: {{ summaryLayout.card.marginBottom }}px;"><text class="pill-label" style="font-size: {{ summaryLayout.label.fontSize }}px;">热量</text><text class="pill-value" style="width: {{ summaryLayout.value.width }}px; font-size: {{ summaryLayout.value.fontSize }}px; margin-top: {{ summaryLayout.value.marginTop }}px; lines: {{ summaryLayout.value.lines }};">{{ caloriesText }}</text><text class="pill-unit" style="font-size: {{ summaryLayout.unit.fontSize }}px; margin-top: {{ summaryLayout.unit.marginTop }}px;">千卡</text></div><div class="pill-card red" style="width: {{ summaryLayout.card.width }}px; height: {{ summaryLayout.card.height }}px; border-radius: {{ summaryLayout.card.radius }}px; padding-top: {{ summaryLayout.card.paddingY }}px; padding-bottom: {{ summaryLayout.card.paddingY }}px; padding-left: {{ summaryLayout.card.paddingX }}px; padding-right: {{ summaryLayout.card.paddingX }}px; margin-bottom: {{ summaryLayout.card.marginBottom }}px;"><text class="pill-label" style="font-size: {{ summaryLayout.label.fontSize }}px;">心率</text><text class="pill-value" style="width: {{ summaryLayout.value.width }}px; font-size: {{ summaryLayout.value.fontSize }}px; margin-top: {{ summaryLayout.value.marginTop }}px; lines: {{ summaryLayout.value.lines }};">{{ heartText }}</text><text class="pill-unit" style="font-size: {{ summaryLayout.unit.fontSize }}px; margin-top: {{ summaryLayout.unit.marginTop }}px;">bpm</text></div><div class="pill-card green" style="width: {{ summaryLayout.card.width }}px; height: {{ summaryLayout.card.height }}px; border-radius: {{ summaryLayout.card.radius }}px; padding-top: {{ summaryLayout.card.paddingY }}px; padding-bottom: {{ summaryLayout.card.paddingY }}px; padding-left: {{ summaryLayout.card.paddingX }}px; padding-right: {{ summaryLayout.card.paddingX }}px; margin-bottom: {{ summaryLayout.card.marginBottom }}px;"><text class="pill-label" style="font-size: {{ summaryLayout.label.fontSize }}px;">站立</text><text class="pill-value" style="width: {{ summaryLayout.value.width }}px; font-size: {{ summaryLayout.value.fontSize }}px; margin-top: {{ summaryLayout.value.marginTop }}px; lines: {{ summaryLayout.value.lines }};">{{ standText }}</text><text class="pill-unit" style="font-size: {{ summaryLayout.unit.fontSize }}px; margin-top: {{ summaryLayout.unit.marginTop }}px;">小时</text></div></div>
        <div class="pill-calendar-entry" style="width: {{ summaryLayout.calendarEntry.width }}px; height: {{ summaryLayout.calendarEntry.height }}px; margin-top: {{ summaryLayout.calendarEntry.marginTop }}px; border-radius: {{ summaryLayout.calendarEntry.radius }}px; padding-left: {{ summaryLayout.calendarEntry.paddingX }}px; padding-right: {{ summaryLayout.calendarEntry.paddingX }}px;" @click="openCalendar"><text class="pill-calendar-entry-title" style="font-size: {{ summaryLayout.calendarEntryTitle.fontSize }}px;">打开月历</text><text class="pill-calendar-entry-icon" style="font-size: {{ summaryLayout.calendarEntryIcon.fontSize }}px;">›</text></div>
      </div>

      <div class="pill-surface" if="{{ ready && isPill && pageIndex === 1 }}" style="left: {{ frameLeft }}px; top: {{ frameTop }}px; width: {{ frameWidth }}px; height: {{ frameHeight }}px;">
        <div class="pill-month-hero" style="width: {{ calendarLayout.monthHero.width }}px; height: {{ calendarLayout.monthHero.height }}px;"><text class="pill-month-number" style="width: {{ calendarLayout.monthNumber.width }}px; font-size: {{ calendarLayout.monthNumber.fontSize }}px;">{{ monthNumberText }}</text><div class="pill-month-copy" style="width: {{ calendarLayout.monthCopy.width }}px;"><text class="pill-calendar-title" style="font-size: {{ calendarLayout.title.fontSize }}px;">{{ calendarTitle }}</text><text class="pill-calendar-lunar" style="font-size: {{ calendarLayout.lunar.fontSize }}px; margin-top: {{ calendarLayout.lunar.marginTop }}px;">{{ lunarText }}</text></div></div>
        <div class="pill-month-controls" style="width: {{ calendarLayout.controls.width }}px; height: {{ calendarLayout.controls.height }}px;"><div class="pill-month-button" style="width: {{ calendarLayout.button.width }}px; height: {{ calendarLayout.button.height }}px; border-radius: {{ calendarLayout.button.radius }}px;" @click="previousMonth"><text class="pill-month-button-text" style="font-size: {{ calendarLayout.buttonText.fontSize }}px;">‹ 上个月</text></div><div class="pill-month-button" style="width: {{ calendarLayout.button.width }}px; height: {{ calendarLayout.button.height }}px; border-radius: {{ calendarLayout.button.radius }}px;" @click="nextMonth"><text class="pill-month-button-text" style="font-size: {{ calendarLayout.buttonText.fontSize }}px;">下个月 ›</text></div></div>
        <div class="pill-week-row" style="width: {{ calendarLayout.weekRow.width }}px; height: {{ calendarLayout.weekRow.height }}px; margin-top: {{ calendarLayout.weekRow.marginTop }}px;"><text class="pill-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">日</text><text class="pill-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">一</text><text class="pill-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">二</text><text class="pill-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">三</text><text class="pill-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">四</text><text class="pill-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">五</text><text class="pill-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">六</text></div>
        <div class="pill-calendar-card" style="width: {{ calendarLayout.card.width }}px; height: {{ calendarLayout.card.height }}px; border-radius: {{ calendarLayout.card.radius }}px;"><div class="pill-calendar-grid" style="width: {{ calendarLayout.grid.width }}px; height: {{ calendarLayout.grid.height }}px;"><div class="pill-cell" style="width: {{ calendarLayout.cell.width }}px; height: {{ calendarLayout.cell.height }}px;" for="{{ calendarCells }}" tid="key"><text class="pill-cell-text" style="width: {{ calendarLayout.cellText.width }}px; height: {{ calendarLayout.cellText.height }}px; border-radius: {{ calendarLayout.cellText.radius }}px; font-size: {{ calendarLayout.cellText.fontSize }}px; color: {{ $item.textColor }}; background-color: {{ $item.backgroundColor }};">{{ $item.day }}</text></div></div></div>
        <div class="pill-back" style="width: {{ calendarLayout.back.width }}px; height: {{ calendarLayout.back.height }}px; margin-top: {{ calendarLayout.back.marginTop }}px; border-radius: {{ calendarLayout.back.radius }}px;" @click="closeCalendar"><text class="pill-back-text" style="font-size: {{ calendarLayout.backText.fontSize }}px;">返回今日摘要</text></div>
      </div>

      <div class="rect-surface" if="{{ ready && isRect }}" style="left: {{ frameLeft }}px; top: {{ frameTop }}px; width: {{ frameWidth }}px; height: {{ frameHeight }}px;">
        <div class="rect-header" style="width: {{ summaryLayout.header.width }}px; height: {{ summaryLayout.header.height }}px;"><div class="rect-date" style="width: {{ summaryLayout.date.width }}px;"><text class="rect-day" style="font-size: {{ summaryLayout.day.fontSize }}px;">{{ dayText }}</text><text class="rect-month" style="font-size: {{ summaryLayout.month.fontSize }}px; margin-left: {{ summaryLayout.month.marginLeft }}px; margin-bottom: {{ summaryLayout.month.marginBottom }}px;">{{ monthText }}</text></div><div class="rect-copy" style="width: {{ summaryLayout.copy.width }}px;"><text class="rect-weekday" style="font-size: {{ summaryLayout.weekday.fontSize }}px;">{{ weekdayText }}</text><text class="rect-lunar" style="font-size: {{ summaryLayout.lunar.fontSize }}px; margin-top: {{ summaryLayout.lunar.marginTop }}px;">{{ lunarText }}</text></div><text class="rect-goal" style="width: {{ summaryLayout.goal.width }}px; font-size: {{ summaryLayout.goal.fontSize }}px;">{{ goalPercent }}%</text></div>
        <div class="rect-metrics" style="width: {{ summaryLayout.metrics.width }}px; height: {{ summaryLayout.metrics.height }}px; margin-top: {{ summaryLayout.metrics.marginTop }}px;"><div class="rect-metric blue" style="width: {{ summaryLayout.metric.width }}px; height: {{ summaryLayout.metric.height }}px; border-radius: {{ summaryLayout.metric.radius }}px; padding: {{ summaryLayout.metric.padding }}px;"><text class="rect-label" style="font-size: {{ summaryLayout.metricLabel.fontSize }}px;">步</text><text class="rect-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; margin-top: {{ summaryLayout.metricValue.marginTop }}px;">{{ stepsText }}</text></div><div class="rect-metric orange" style="width: {{ summaryLayout.metric.width }}px; height: {{ summaryLayout.metric.height }}px; border-radius: {{ summaryLayout.metric.radius }}px; padding: {{ summaryLayout.metric.padding }}px;"><text class="rect-label" style="font-size: {{ summaryLayout.metricLabel.fontSize }}px;">卡</text><text class="rect-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; margin-top: {{ summaryLayout.metricValue.marginTop }}px;">{{ caloriesText }}</text></div><div class="rect-metric red" style="width: {{ summaryLayout.metric.width }}px; height: {{ summaryLayout.metric.height }}px; border-radius: {{ summaryLayout.metric.radius }}px; padding: {{ summaryLayout.metric.padding }}px;"><text class="rect-label" style="font-size: {{ summaryLayout.metricLabel.fontSize }}px;">心</text><text class="rect-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; margin-top: {{ summaryLayout.metricValue.marginTop }}px;">{{ heartText }}</text></div><div class="rect-metric green" style="width: {{ summaryLayout.metric.width }}px; height: {{ summaryLayout.metric.height }}px; border-radius: {{ summaryLayout.metric.radius }}px; padding: {{ summaryLayout.metric.padding }}px;"><text class="rect-label" style="font-size: {{ summaryLayout.metricLabel.fontSize }}px;">站</text><text class="rect-value" style="width: {{ summaryLayout.metricValue.width }}px; font-size: {{ summaryLayout.metricValue.fontSize }}px; margin-top: {{ summaryLayout.metricValue.marginTop }}px;">{{ standText }}</text></div></div>
        <div class="rect-calendar-head" style="width: {{ calendarLayout.head.width }}px; height: {{ calendarLayout.head.height }}px; margin-top: {{ calendarLayout.head.marginTop }}px;"><div class="rect-nav" style="width: {{ calendarLayout.nav.width }}px; height: {{ calendarLayout.nav.height }}px;" @click="previousMonth"><text class="rect-nav-text" style="font-size: {{ calendarLayout.navText.fontSize }}px;">‹</text></div><text class="rect-calendar-title" style="width: {{ calendarLayout.title.width }}px; font-size: {{ calendarLayout.title.fontSize }}px;">{{ calendarTitle }}</text><div class="rect-nav" style="width: {{ calendarLayout.nav.width }}px; height: {{ calendarLayout.nav.height }}px;" @click="nextMonth"><text class="rect-nav-text" style="font-size: {{ calendarLayout.navText.fontSize }}px;">›</text></div></div>
        <div class="rect-week-row" style="width: {{ calendarLayout.weekRow.width }}px; height: {{ calendarLayout.weekRow.height }}px;"><text class="rect-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">日</text><text class="rect-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">一</text><text class="rect-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">二</text><text class="rect-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">三</text><text class="rect-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">四</text><text class="rect-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">五</text><text class="rect-week" style="width: {{ calendarLayout.week.width }}px; font-size: {{ calendarLayout.week.fontSize }}px;">六</text></div>
        <div class="rect-calendar-grid" style="width: {{ calendarLayout.grid.width }}px; height: {{ calendarLayout.grid.height }}px;"><div class="rect-cell" style="width: {{ calendarLayout.cell.width }}px; height: {{ calendarLayout.cell.height }}px;" for="{{ calendarCells }}" tid="key"><text class="rect-cell-text" style="width: {{ calendarLayout.cellText.width }}px; height: {{ calendarLayout.cellText.height }}px; border-radius: {{ calendarLayout.cellText.radius }}px; font-size: {{ calendarLayout.cellText.fontSize }}px; color: {{ $item.textColor }}; background-color: {{ $item.backgroundColor }};">{{ $item.day }}</text></div></div>
      </div>
    </stack>
  </stack>
</template>

<script>
import pageRuntime from '../../runtime/page_runtime'
import navigation from '../../runtime/navigation'
import { createTodayController } from '../../v2/features/today/controller'
import todayDesign from '../../v2/design/apps/today'
import todayView from '../../v2/design/apps/today/view'

export default {
  private: {
    ready: false, pageVisible: false, isCircle: false, isPill: false, isRect: false, pageIndex: 0, designPlan: null, todayModel: null,
    summaryLayout: {}, calendarLayout: {}, sceneWidth: 0, sceneHeight: 0, frameLeft: 0, frameTop: 0, frameWidth: 0, frameHeight: 0,
    viewportClass: '', viewportPosition: 'relative', viewportLeft: '0px', viewportTop: '0px', viewportWidth: '100%', viewportHeight: '100%',
    yearText: '', monthText: '', monthNumberText: '', dayText: '', weekdayText: '', lunarText: '',
    stepsText: '0', caloriesText: '0', standText: '0', heartText: '--', goalPercent: 0, goalWidth: '0%', calendarTitle: '', calendarCells: []
  },
  onInit() {
    var self = this
    this.controller = createTodayController(function (model) { self.acceptModel(model) })
    pageRuntime.bind(this, function (profile, scene, safe) {
      var plan = todayDesign.resolve(profile, scene, safe)
      self.designPlan = plan
      self.summaryLayout = plan.summary
      self.calendarLayout = plan.calendar
      self.frameLeft = plan.frame.left
      self.frameTop = plan.frame.top
      self.frameWidth = plan.frame.width
      self.frameHeight = plan.frame.height
      self.isCircle = plan.shape === 'circle'; self.isPill = plan.shape === 'pill'; self.isRect = plan.shape === 'rect'; self.ready = true
      if (self.todayModel) self.applyModel(todayView.project(self.todayModel, plan))
      if (self.pageVisible) self.controller.start()
    })
  },
  onShow() { this.pageVisible = true; if (this.ready && this.controller) this.controller.start() },
  onHide() { this.pageVisible = false; if (this.controller) this.controller.stop() },
  onDestroy() { this.pageVisible = false; if (this.controller) this.controller.stop(); this.todayModel = null; this.calendarCells = [] },
  onBackPress() { if (this.pageIndex === 1) { this.pageIndex = 0; return true } navigation.back(); return true },
  acceptModel(model) { this.todayModel = model; if (this.designPlan) this.applyModel(todayView.project(model, this.designPlan)) },
  applyModel(model) {
    this.yearText = model.yearText; this.monthText = model.monthText; this.monthNumberText = model.monthNumberText; this.dayText = model.dayText; this.weekdayText = model.weekdayText; this.lunarText = model.lunarText
    this.stepsText = model.stepsText; this.caloriesText = model.caloriesText; this.standText = model.standText; this.heartText = model.heartText; this.goalPercent = model.goalPercent; this.goalWidth = model.goalWidth; this.calendarTitle = model.calendarTitle; this.calendarCells = model.calendarCells
  },
  openCalendar() { this.pageIndex = 1 }, closeCalendar() { this.pageIndex = 0 },
  previousMonth() { if (this.controller) this.controller.shiftMonth(-1) }, nextMonth() { if (this.controller) this.controller.shiftMonth(1) }
}
</script>

